package github.com/hashicorp/go-azure-sdk/microsoft-graph/domains/beta/rootdomain
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewRootDomainClientWithBaseURI(sdkApi sdkEnv.Api) (*RootDomainClient, error) {
	client, err := msgraph.NewClient(sdkApi, "rootdomain", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating RootDomainClient: %+v", err)
	}

	return &RootDomainClient{
		Client: client,
	}, nil
}
