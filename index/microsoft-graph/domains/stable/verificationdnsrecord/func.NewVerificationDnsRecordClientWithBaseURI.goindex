func NewVerificationDnsRecordClientWithBaseURI(sdkApi sdkEnv.Api) (*VerificationDnsRecordClient, error) {
	client, err := msgraph.NewClient(sdkApi, "verificationdnsrecord", defaultApiVersion)
	if err != nil {
