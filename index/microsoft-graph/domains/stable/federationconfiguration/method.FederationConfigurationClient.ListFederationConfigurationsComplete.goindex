package github.com/hashicorp/go-azure-sdk/microsoft-graph/domains/stable/federationconfiguration
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
