package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/stable/joinedteamscheduletimecard
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c JoinedTeamScheduleTimeCardClient) ListJoinedTeamScheduleTimeCardsCompleteMatchingPredicate(ctx context.Context, id stable.UserIdJoinedTeamId, options ListJoinedTeamScheduleTimeCardsOperationOptions, predicate TimeCardOperationPredicate) (result ListJoinedTeamScheduleTimeCardsCompleteResult, err error) {
	items := make([]stable.TimeCard, 0)

	resp, err := c.ListJoinedTeamScheduleTimeCards(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListJoinedTeamScheduleTimeCardsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
