package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/stable/drivelistcontenttypecolumnposition
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveListContentTypeColumnPositionClient) ListDriveListContentTypeColumnPositionsCompleteMatchingPredicate(ctx context.Context, id stable.UserIdDriveIdListContentTypeId, options ListDriveListContentTypeColumnPositionsOperationOptions, predicate ColumnDefinitionOperationPredicate) (result ListDriveListContentTypeColumnPositionsCompleteResult, err error) {
	items := make([]stable.ColumnDefinition, 0)

	resp, err := c.ListDriveListContentTypeColumnPositions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveListContentTypeColumnPositionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
