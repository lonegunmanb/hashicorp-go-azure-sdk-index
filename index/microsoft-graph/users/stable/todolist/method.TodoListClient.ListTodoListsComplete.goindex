func (c TodoListClient) ListTodoListsComplete(ctx context.Context, id stable.UserId, options ListTodoListsOperationOptions) (ListTodoListsCompleteResult, error) {
	return c.ListTodoListsCompleteMatchingPredicate(ctx, id, options, TodoTaskListOperationPredicate{})
}
