package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/stable/contact
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ContactClient) ListContactsComplete(ctx context.Context, id stable.UserId, options ListContactsOperationOptions) (ListContactsCompleteResult, error) {
	return c.ListContactsCompleteMatchingPredicate(ctx, id, options, ContactOperationPredicate{})
}
