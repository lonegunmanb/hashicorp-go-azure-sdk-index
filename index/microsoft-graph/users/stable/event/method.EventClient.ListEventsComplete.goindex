package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/stable/event
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EventClient) ListEventsComplete(ctx context.Context, id stable.UserId, options ListEventsOperationOptions) (ListEventsCompleteResult, error) {
	return c.ListEventsCompleteMatchingPredicate(ctx, id, options, EventOperationPredicate{})
}
