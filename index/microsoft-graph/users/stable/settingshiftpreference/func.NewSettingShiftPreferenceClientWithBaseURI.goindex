func NewSettingShiftPreferenceClientWithBaseURI(sdkApi sdkEnv.Api) (*SettingShiftPreferenceClient, error) {
	client, err := msgraph.NewClient(sdkApi, "settingshiftpreference", defaultApiVersion)
	if err != nil {
