	items := make([]stable.SharedWithChannelTeamInfo, 0)

	resp, err := c.ListJoinedTeamPrimaryChannelSharedWithTeams(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
