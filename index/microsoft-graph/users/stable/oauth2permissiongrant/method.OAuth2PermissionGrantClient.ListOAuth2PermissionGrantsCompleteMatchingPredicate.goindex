package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/stable/oauth2permissiongrant
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OAuth2PermissionGrantClient) ListOAuth2PermissionGrantsCompleteMatchingPredicate(ctx context.Context, id stable.UserId, options ListOAuth2PermissionGrantsOperationOptions, predicate OAuth2PermissionGrantOperationPredicate) (result ListOAuth2PermissionGrantsCompleteResult, err error) {
	items := make([]stable.OAuth2PermissionGrant, 0)

	resp, err := c.ListOAuth2PermissionGrants(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListOAuth2PermissionGrantsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
