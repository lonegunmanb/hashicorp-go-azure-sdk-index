package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/devicetransitivememberof
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceTransitiveMemberOfClient) ListDeviceTransitiveMemberOfAdministrativeUnitsCompleteMatchingPredicate(ctx context.Context, id beta.UserIdDeviceId, options ListDeviceTransitiveMemberOfAdministrativeUnitsOperationOptions, predicate AdministrativeUnitOperationPredicate) (result ListDeviceTransitiveMemberOfAdministrativeUnitsCompleteResult, err error) {
	items := make([]beta.AdministrativeUnit, 0)

	resp, err := c.ListDeviceTransitiveMemberOfAdministrativeUnits(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDeviceTransitiveMemberOfAdministrativeUnitsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
