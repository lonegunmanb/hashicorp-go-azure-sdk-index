package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/extension
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ExtensionClient) ListExtensionsComplete(ctx context.Context, id beta.UserId, options ListExtensionsOperationOptions) (ListExtensionsCompleteResult, error) {
	return c.ListExtensionsCompleteMatchingPredicate(ctx, id, options, ExtensionOperationPredicate{})
}
