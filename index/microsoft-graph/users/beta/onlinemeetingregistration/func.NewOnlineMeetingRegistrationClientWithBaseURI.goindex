package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/onlinemeetingregistration
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewOnlineMeetingRegistrationClientWithBaseURI(sdkApi sdkEnv.Api) (*OnlineMeetingRegistrationClient, error) {
	client, err := msgraph.NewClient(sdkApi, "onlinemeetingregistration", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating OnlineMeetingRegistrationClient: %+v", err)
	}

	return &OnlineMeetingRegistrationClient{
		Client: client,
	}, nil
}
