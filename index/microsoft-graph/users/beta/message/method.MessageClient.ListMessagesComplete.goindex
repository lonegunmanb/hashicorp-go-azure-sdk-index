package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/message
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c MessageClient) ListMessagesComplete(ctx context.Context, id beta.UserId, options ListMessagesOperationOptions) (ListMessagesCompleteResult, error) {
	return c.ListMessagesCompleteMatchingPredicate(ctx, id, options, MessageOperationPredicate{})
}
