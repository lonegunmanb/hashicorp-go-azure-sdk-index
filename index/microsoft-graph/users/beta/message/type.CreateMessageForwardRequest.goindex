package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/message
import (
	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type CreateMessageForwardRequest struct {
	Comment      nullable.Type[string] `json:"Comment,omitempty"`
	Message      *beta.Message         `json:"Message,omitempty"`
	ToRecipients *[]beta.Recipient     `json:"ToRecipients,omitempty"`
}
