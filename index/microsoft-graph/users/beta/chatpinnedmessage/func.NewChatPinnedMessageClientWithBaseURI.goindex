package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/chatpinnedmessage
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewChatPinnedMessageClientWithBaseURI(sdkApi sdkEnv.Api) (*ChatPinnedMessageClient, error) {
	client, err := msgraph.NewClient(sdkApi, "chatpinnedmessage", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ChatPinnedMessageClient: %+v", err)
	}

	return &ChatPinnedMessageClient{
		Client: client,
	}, nil
}
