func NewActivityHistoryItemClientWithBaseURI(sdkApi sdkEnv.Api) (*ActivityHistoryItemClient, error) {
	client, err := msgraph.NewClient(sdkApi, "activityhistoryitem", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ActivityHistoryItemClient: %+v", err)
