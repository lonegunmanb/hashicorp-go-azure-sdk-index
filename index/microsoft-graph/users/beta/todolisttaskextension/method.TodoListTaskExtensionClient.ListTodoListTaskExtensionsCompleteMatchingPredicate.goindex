package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/todolisttaskextension
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TodoListTaskExtensionClient) ListTodoListTaskExtensionsCompleteMatchingPredicate(ctx context.Context, id beta.UserIdTodoListIdTaskId, options ListTodoListTaskExtensionsOperationOptions, predicate ExtensionOperationPredicate) (result ListTodoListTaskExtensionsCompleteResult, err error) {
	items := make([]beta.Extension, 0)

	resp, err := c.ListTodoListTaskExtensions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTodoListTaskExtensionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
