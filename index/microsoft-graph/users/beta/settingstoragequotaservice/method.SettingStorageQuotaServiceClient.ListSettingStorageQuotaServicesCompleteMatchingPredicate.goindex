package github.com/hashicorp/go-azure-sdk/microsoft-graph/users/beta/settingstoragequotaservice
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SettingStorageQuotaServiceClient) ListSettingStorageQuotaServicesCompleteMatchingPredicate(ctx context.Context, id beta.UserId, options ListSettingStorageQuotaServicesOperationOptions, predicate ServiceStorageQuotaBreakdownOperationPredicate) (result ListSettingStorageQuotaServicesCompleteResult, err error) {
	items := make([]beta.ServiceStorageQuotaBreakdown, 0)

	resp, err := c.ListSettingStorageQuotaServices(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSettingStorageQuotaServicesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
