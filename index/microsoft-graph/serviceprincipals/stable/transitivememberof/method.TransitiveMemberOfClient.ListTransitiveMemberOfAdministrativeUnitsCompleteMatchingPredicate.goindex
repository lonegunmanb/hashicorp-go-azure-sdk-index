package github.com/hashicorp/go-azure-sdk/microsoft-graph/serviceprincipals/stable/transitivememberof
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TransitiveMemberOfClient) ListTransitiveMemberOfAdministrativeUnitsCompleteMatchingPredicate(ctx context.Context, id stable.ServicePrincipalId, options ListTransitiveMemberOfAdministrativeUnitsOperationOptions, predicate AdministrativeUnitOperationPredicate) (result ListTransitiveMemberOfAdministrativeUnitsCompleteResult, err error) {
	items := make([]stable.AdministrativeUnit, 0)

	resp, err := c.ListTransitiveMemberOfAdministrativeUnits(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTransitiveMemberOfAdministrativeUnitsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
