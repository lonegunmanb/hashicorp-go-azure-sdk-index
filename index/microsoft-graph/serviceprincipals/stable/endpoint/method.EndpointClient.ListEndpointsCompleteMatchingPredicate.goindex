package github.com/hashicorp/go-azure-sdk/microsoft-graph/serviceprincipals/stable/endpoint
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EndpointClient) ListEndpointsCompleteMatchingPredicate(ctx context.Context, id stable.ServicePrincipalId, options ListEndpointsOperationOptions, predicate EndpointOperationPredicate) (result ListEndpointsCompleteResult, err error) {
	items := make([]stable.Endpoint, 0)

	resp, err := c.ListEndpoints(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListEndpointsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
