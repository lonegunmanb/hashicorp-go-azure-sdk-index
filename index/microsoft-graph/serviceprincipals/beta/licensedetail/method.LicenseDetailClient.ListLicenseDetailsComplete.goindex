func (c LicenseDetailClient) ListLicenseDetailsComplete(ctx context.Context, id beta.ServicePrincipalId, options ListLicenseDetailsOperationOptions) (ListLicenseDetailsCompleteResult, error) {
	return c.ListLicenseDetailsCompleteMatchingPredicate(ctx, id, options, LicenseDetailsOperationPredicate{})
}
