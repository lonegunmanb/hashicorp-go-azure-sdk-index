package github.com/hashicorp/go-azure-sdk/microsoft-graph/serviceprincipals/beta/endpoint
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EndpointClient) ListEndpointsComplete(ctx context.Context, id beta.ServicePrincipalId, options ListEndpointsOperationOptions) (ListEndpointsCompleteResult, error) {
	return c.ListEndpointsCompleteMatchingPredicate(ctx, id, options, EndpointOperationPredicate{})
}
