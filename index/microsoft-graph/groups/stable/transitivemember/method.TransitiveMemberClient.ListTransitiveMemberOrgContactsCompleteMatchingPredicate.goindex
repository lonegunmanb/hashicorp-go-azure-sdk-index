package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/transitivemember
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TransitiveMemberClient) ListTransitiveMemberOrgContactsCompleteMatchingPredicate(ctx context.Context, id stable.GroupId, options ListTransitiveMemberOrgContactsOperationOptions, predicate OrgContactOperationPredicate) (result ListTransitiveMemberOrgContactsCompleteResult, err error) {
	items := make([]stable.OrgContact, 0)

	resp, err := c.ListTransitiveMemberOrgContacts(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTransitiveMemberOrgContactsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
