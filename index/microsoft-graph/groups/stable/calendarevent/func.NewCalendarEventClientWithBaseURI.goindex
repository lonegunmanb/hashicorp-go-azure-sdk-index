package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/calendarevent
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewCalendarEventClientWithBaseURI(sdkApi sdkEnv.Api) (*CalendarEventClient, error) {
	client, err := msgraph.NewClient(sdkApi, "calendarevent", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating CalendarEventClient: %+v", err)
	}

	return &CalendarEventClient{
		Client: client,
	}, nil
}
