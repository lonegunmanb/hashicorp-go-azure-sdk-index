package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/sitepermission
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SitePermissionClient) ListSitePermissionGrantsCompleteMatchingPredicate(ctx context.Context, id stable.GroupIdSiteIdPermissionId, input ListSitePermissionGrantsRequest, options ListSitePermissionGrantsOperationOptions, predicate PermissionOperationPredicate) (result ListSitePermissionGrantsCompleteResult, err error) {
	items := make([]stable.Permission, 0)

	resp, err := c.ListSitePermissionGrants(ctx, id, input, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSitePermissionGrantsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
