func NewCalendarEventCalendarClientWithBaseURI(sdkApi sdkEnv.Api) (*CalendarEventCalendarClient, error) {
	client, err := msgraph.NewClient(sdkApi, "calendareventcalendar", defaultApiVersion)
	if err != nil {
