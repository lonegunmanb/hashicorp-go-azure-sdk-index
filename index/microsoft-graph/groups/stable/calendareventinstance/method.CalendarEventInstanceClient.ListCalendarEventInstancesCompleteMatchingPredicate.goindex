package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/calendareventinstance
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c CalendarEventInstanceClient) ListCalendarEventInstancesCompleteMatchingPredicate(ctx context.Context, id stable.GroupIdCalendarEventId, options ListCalendarEventInstancesOperationOptions, predicate EventOperationPredicate) (result ListCalendarEventInstancesCompleteResult, err error) {
	items := make([]stable.Event, 0)

	resp, err := c.ListCalendarEventInstances(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListCalendarEventInstancesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
