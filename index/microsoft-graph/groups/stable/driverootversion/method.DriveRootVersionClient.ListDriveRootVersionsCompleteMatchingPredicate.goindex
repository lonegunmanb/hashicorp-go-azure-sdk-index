package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/driverootversion
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveRootVersionClient) ListDriveRootVersionsCompleteMatchingPredicate(ctx context.Context, id stable.GroupIdDriveId, options ListDriveRootVersionsOperationOptions, predicate DriveItemVersionOperationPredicate) (result ListDriveRootVersionsCompleteResult, err error) {
	items := make([]stable.DriveItemVersion, 0)

	resp, err := c.ListDriveRootVersions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveRootVersionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
