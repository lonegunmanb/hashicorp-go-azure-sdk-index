package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/stable/drivelistitem
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveListItemClient) ListDriveListItemsCompleteMatchingPredicate(ctx context.Context, id stable.GroupIdDriveId, options ListDriveListItemsOperationOptions, predicate ListItemOperationPredicate) (result ListDriveListItemsCompleteResult, err error) {
	items := make([]stable.ListItem, 0)

	resp, err := c.ListDriveListItems(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveListItemsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
