package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/beta/driveitempermission
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveItemPermissionClient) ListDriveItemPermissionsCompleteMatchingPredicate(ctx context.Context, id beta.GroupIdDriveIdItemId, options ListDriveItemPermissionsOperationOptions, predicate PermissionOperationPredicate) (result ListDriveItemPermissionsCompleteResult, err error) {
	items := make([]beta.Permission, 0)

	resp, err := c.ListDriveItemPermissions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveItemPermissionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
