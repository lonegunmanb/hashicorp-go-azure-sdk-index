package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/beta/sitepagetemplate
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SitePageTemplateClient) ListSitePageTemplatesCompleteMatchingPredicate(ctx context.Context, id beta.GroupIdSiteId, options ListSitePageTemplatesOperationOptions, predicate PageTemplateOperationPredicate) (result ListSitePageTemplatesCompleteResult, err error) {
	items := make([]beta.PageTemplate, 0)

	resp, err := c.ListSitePageTemplates(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSitePageTemplatesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
