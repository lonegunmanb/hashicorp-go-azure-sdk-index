package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/beta/sitelistcontenttypecolumnlink
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SiteListContentTypeColumnLinkClient) ListSiteListContentTypeColumnLinksCompleteMatchingPredicate(ctx context.Context, id beta.GroupIdSiteIdListIdContentTypeId, options ListSiteListContentTypeColumnLinksOperationOptions, predicate ColumnLinkOperationPredicate) (result ListSiteListContentTypeColumnLinksCompleteResult, err error) {
	items := make([]beta.ColumnLink, 0)

	resp, err := c.ListSiteListContentTypeColumnLinks(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSiteListContentTypeColumnLinksCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
