import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewThreadPostMentionClientWithBaseURI(sdkApi sdkEnv.Api) (*ThreadPostMentionClient, error) {
	client, err := msgraph.NewClient(sdkApi, "threadpostmention", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ThreadPostMentionClient: %+v", err)
	}

	return &ThreadPostMentionClient{
		Client: client,
	}, nil
}
