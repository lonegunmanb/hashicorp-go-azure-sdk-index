package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/beta/sitelistitemversion
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SiteListItemVersionClient) ListSiteListItemVersionsCompleteMatchingPredicate(ctx context.Context, id beta.GroupIdSiteIdListIdItemId, options ListSiteListItemVersionsOperationOptions, predicate ListItemVersionOperationPredicate) (result ListSiteListItemVersionsCompleteResult, err error) {
	items := make([]beta.ListItemVersion, 0)

	resp, err := c.ListSiteListItemVersions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSiteListItemVersionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
