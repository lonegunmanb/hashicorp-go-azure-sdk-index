func NewTeamTemplateDefinitionClientWithBaseURI(sdkApi sdkEnv.Api) (*TeamTemplateDefinitionClient, error) {
	client, err := msgraph.NewClient(sdkApi, "teamtemplatedefinition", defaultApiVersion)
	if err != nil {
