package github.com/hashicorp/go-azure-sdk/microsoft-graph/groups/beta/sitelistitemactivity
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SiteListItemActivityClient) ListSiteListItemActivitiesCompleteMatchingPredicate(ctx context.Context, id beta.GroupIdSiteIdListIdItemId, options ListSiteListItemActivitiesOperationOptions, predicate ItemActivityOLDOperationPredicate) (result ListSiteListItemActivitiesCompleteResult, err error) {
	items := make([]beta.ItemActivityOLD, 0)

	resp, err := c.ListSiteListItemActivities(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListSiteListItemActivitiesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
