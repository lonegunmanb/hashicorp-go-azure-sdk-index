package github.com/hashicorp/go-azure-sdk/microsoft-graph/identity/stable/apiconnector
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ApiConnectorClient) ListApiConnectorsCompleteMatchingPredicate(ctx context.Context, options ListApiConnectorsOperationOptions, predicate IdentityApiConnectorOperationPredicate) (result ListApiConnectorsCompleteResult, err error) {
	items := make([]stable.IdentityApiConnector, 0)

	resp, err := c.ListApiConnectors(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListApiConnectorsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
