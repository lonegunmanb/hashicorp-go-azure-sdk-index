func (c AuthenticationEventsFlowConditionApplicationIncludeApplicationClient) ListAuthenticationEventsFlowConditionApplicationIncludeApplicationsCompleteMatchingPredicate(ctx context.Context, id stable.IdentityAuthenticationEventsFlowId, options ListAuthenticationEventsFlowConditionApplicationIncludeApplicationsOperationOptions, predicate AuthenticationConditionApplicationOperationPredicate) (result ListAuthenticationEventsFlowConditionApplicationIncludeApplicationsCompleteResult, err error) {
	items := make([]stable.AuthenticationConditionApplication, 0)

	resp, err := c.ListAuthenticationEventsFlowConditionApplicationIncludeApplications(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListAuthenticationEventsFlowConditionApplicationIncludeApplicationsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
