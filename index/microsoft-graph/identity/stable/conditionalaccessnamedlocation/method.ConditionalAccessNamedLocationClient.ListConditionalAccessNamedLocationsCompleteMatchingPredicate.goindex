package github.com/hashicorp/go-azure-sdk/microsoft-graph/identity/stable/conditionalaccessnamedlocation
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ConditionalAccessNamedLocationClient) ListConditionalAccessNamedLocationsCompleteMatchingPredicate(ctx context.Context, options ListConditionalAccessNamedLocationsOperationOptions, predicate NamedLocationOperationPredicate) (result ListConditionalAccessNamedLocationsCompleteResult, err error) {
	items := make([]stable.NamedLocation, 0)

	resp, err := c.ListConditionalAccessNamedLocations(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListConditionalAccessNamedLocationsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
