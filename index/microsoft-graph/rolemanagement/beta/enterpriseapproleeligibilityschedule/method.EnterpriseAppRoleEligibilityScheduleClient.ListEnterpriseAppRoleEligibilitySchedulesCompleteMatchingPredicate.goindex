package github.com/hashicorp/go-azure-sdk/microsoft-graph/rolemanagement/beta/enterpriseapproleeligibilityschedule
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EnterpriseAppRoleEligibilityScheduleClient) ListEnterpriseAppRoleEligibilitySchedulesCompleteMatchingPredicate(ctx context.Context, id beta.RoleManagementEnterpriseAppId, options ListEnterpriseAppRoleEligibilitySchedulesOperationOptions, predicate UnifiedRoleEligibilityScheduleOperationPredicate) (result ListEnterpriseAppRoleEligibilitySchedulesCompleteResult, err error) {
	items := make([]beta.UnifiedRoleEligibilitySchedule, 0)

	resp, err := c.ListEnterpriseAppRoleEligibilitySchedules(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListEnterpriseAppRoleEligibilitySchedulesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
