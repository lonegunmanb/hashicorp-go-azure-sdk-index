package github.com/hashicorp/go-azure-sdk/microsoft-graph/rolemanagement/beta/defenderroleassignmentappscope
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DefenderRoleAssignmentAppScopeClient) ListDefenderRoleAssignmentAppScopesCompleteMatchingPredicate(ctx context.Context, id beta.RoleManagementDefenderRoleAssignmentId, options ListDefenderRoleAssignmentAppScopesOperationOptions, predicate AppScopeOperationPredicate) (result ListDefenderRoleAssignmentAppScopesCompleteResult, err error) {
	items := make([]beta.AppScope, 0)

	resp, err := c.ListDefenderRoleAssignmentAppScopes(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDefenderRoleAssignmentAppScopesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
