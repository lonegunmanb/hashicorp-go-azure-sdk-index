package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/chat
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ChatClient) ListChatsCompleteMatchingPredicate(ctx context.Context, options ListChatsOperationOptions, predicate ChatOperationPredicate) (result ListChatsCompleteResult, err error) {
	items := make([]beta.Chat, 0)

	resp, err := c.ListChats(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListChatsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
