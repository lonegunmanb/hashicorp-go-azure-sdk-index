package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/authenticationoperation
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewAuthenticationOperationClientWithBaseURI(sdkApi sdkEnv.Api) (*AuthenticationOperationClient, error) {
	client, err := msgraph.NewClient(sdkApi, "authenticationoperation", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating AuthenticationOperationClient: %+v", err)
	}

	return &AuthenticationOperationClient{
		Client: client,
	}, nil
}
