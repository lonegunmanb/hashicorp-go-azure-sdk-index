package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/driverootthumbnail
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveRootThumbnailClient) ListDriveRootThumbnailsCompleteMatchingPredicate(ctx context.Context, id beta.MeDriveId, options ListDriveRootThumbnailsOperationOptions, predicate ThumbnailSetOperationPredicate) (result ListDriveRootThumbnailsCompleteResult, err error) {
	items := make([]beta.ThumbnailSet, 0)

	resp, err := c.ListDriveRootThumbnails(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveRootThumbnailsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
