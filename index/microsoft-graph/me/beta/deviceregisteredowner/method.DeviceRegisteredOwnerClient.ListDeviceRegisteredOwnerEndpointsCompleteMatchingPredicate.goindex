package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/deviceregisteredowner
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceRegisteredOwnerClient) ListDeviceRegisteredOwnerEndpointsCompleteMatchingPredicate(ctx context.Context, id beta.MeDeviceId, options ListDeviceRegisteredOwnerEndpointsOperationOptions, predicate EndpointOperationPredicate) (result ListDeviceRegisteredOwnerEndpointsCompleteResult, err error) {
	items := make([]beta.Endpoint, 0)

	resp, err := c.ListDeviceRegisteredOwnerEndpoints(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDeviceRegisteredOwnerEndpointsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
