package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/onlinemeetingregistrationregistrant
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OnlineMeetingRegistrationRegistrantClient) ListOnlineMeetingRegistrationRegistrantsCompleteMatchingPredicate(ctx context.Context, id beta.MeOnlineMeetingId, options ListOnlineMeetingRegistrationRegistrantsOperationOptions, predicate MeetingRegistrantBaseOperationPredicate) (result ListOnlineMeetingRegistrationRegistrantsCompleteResult, err error) {
	items := make([]beta.MeetingRegistrantBase, 0)

	resp, err := c.ListOnlineMeetingRegistrationRegistrants(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListOnlineMeetingRegistrationRegistrantsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
