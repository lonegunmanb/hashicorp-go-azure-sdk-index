package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/driverootchild
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveRootChildClient) ListDriveRootChildrenCompleteMatchingPredicate(ctx context.Context, id beta.MeDriveId, options ListDriveRootChildrenOperationOptions, predicate DriveItemOperationPredicate) (result ListDriveRootChildrenCompleteResult, err error) {
	items := make([]beta.DriveItem, 0)

	resp, err := c.ListDriveRootChildren(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveRootChildrenCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
