package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/createdobject
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c CreatedObjectClient) ListCreatedObjectServicePrincipalsCompleteMatchingPredicate(ctx context.Context, options ListCreatedObjectServicePrincipalsOperationOptions, predicate ServicePrincipalOperationPredicate) (result ListCreatedObjectServicePrincipalsCompleteResult, err error) {
	items := make([]beta.ServicePrincipal, 0)

	resp, err := c.ListCreatedObjectServicePrincipals(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListCreatedObjectServicePrincipalsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
