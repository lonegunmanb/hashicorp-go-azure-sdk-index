package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/cloudclipboard
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewCloudClipboardClientWithBaseURI(sdkApi sdkEnv.Api) (*CloudClipboardClient, error) {
	client, err := msgraph.NewClient(sdkApi, "cloudclipboard", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating CloudClipboardClient: %+v", err)
	}

	return &CloudClipboardClient{
		Client: client,
	}, nil
}
