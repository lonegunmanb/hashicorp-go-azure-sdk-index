package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/devicecommand
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewDeviceCommandClientWithBaseURI(sdkApi sdkEnv.Api) (*DeviceCommandClient, error) {
	client, err := msgraph.NewClient(sdkApi, "devicecommand", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating DeviceCommandClient: %+v", err)
	}

	return &DeviceCommandClient{
		Client: client,
	}, nil
}
