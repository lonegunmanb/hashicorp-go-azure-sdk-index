package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/profileproject
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewProfileProjectClientWithBaseURI(sdkApi sdkEnv.Api) (*ProfileProjectClient, error) {
	client, err := msgraph.NewClient(sdkApi, "profileproject", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ProfileProjectClient: %+v", err)
	}

	return &ProfileProjectClient{
		Client: client,
	}, nil
}
