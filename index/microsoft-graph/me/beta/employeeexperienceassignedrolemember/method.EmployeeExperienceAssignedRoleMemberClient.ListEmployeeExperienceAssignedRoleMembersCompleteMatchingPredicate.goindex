package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/employeeexperienceassignedrolemember
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EmployeeExperienceAssignedRoleMemberClient) ListEmployeeExperienceAssignedRoleMembersCompleteMatchingPredicate(ctx context.Context, id beta.MeEmployeeExperienceAssignedRoleId, options ListEmployeeExperienceAssignedRoleMembersOperationOptions, predicate EngagementRoleMemberOperationPredicate) (result ListEmployeeExperienceAssignedRoleMembersCompleteResult, err error) {
	items := make([]beta.EngagementRoleMember, 0)

	resp, err := c.ListEmployeeExperienceAssignedRoleMembers(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListEmployeeExperienceAssignedRoleMembersCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
