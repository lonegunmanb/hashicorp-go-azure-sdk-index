package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/profileemail
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ProfileEmailClient) ListProfileEmailsCompleteMatchingPredicate(ctx context.Context, options ListProfileEmailsOperationOptions, predicate ItemEmailOperationPredicate) (result ListProfileEmailsCompleteResult, err error) {
	items := make([]beta.ItemEmail, 0)

	resp, err := c.ListProfileEmails(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListProfileEmailsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
