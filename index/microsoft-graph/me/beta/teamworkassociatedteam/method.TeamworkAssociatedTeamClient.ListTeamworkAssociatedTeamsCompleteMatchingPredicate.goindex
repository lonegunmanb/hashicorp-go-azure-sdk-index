package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/beta/teamworkassociatedteam
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TeamworkAssociatedTeamClient) ListTeamworkAssociatedTeamsCompleteMatchingPredicate(ctx context.Context, options ListTeamworkAssociatedTeamsOperationOptions, predicate AssociatedTeamInfoOperationPredicate) (result ListTeamworkAssociatedTeamsCompleteResult, err error) {
	items := make([]beta.AssociatedTeamInfo, 0)

	resp, err := c.ListTeamworkAssociatedTeams(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTeamworkAssociatedTeamsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
