func (c JoinedTeamPrimaryChannelMemberClient) AddJoinedTeamPrimaryChannelMembersCompleteMatchingPredicate(ctx context.Context, id stable.MeJoinedTeamId, input AddJoinedTeamPrimaryChannelMembersRequest, options AddJoinedTeamPrimaryChannelMembersOperationOptions, predicate ActionResultPartOperationPredicate) (result AddJoinedTeamPrimaryChannelMembersCompleteResult, err error) {
	items := make([]stable.ActionResultPart, 0)

	resp, err := c.AddJoinedTeamPrimaryChannelMembers(ctx, id, input, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = AddJoinedTeamPrimaryChannelMembersCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
