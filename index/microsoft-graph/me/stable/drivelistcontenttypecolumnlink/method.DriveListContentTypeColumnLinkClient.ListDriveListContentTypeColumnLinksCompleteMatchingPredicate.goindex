package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/drivelistcontenttypecolumnlink
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DriveListContentTypeColumnLinkClient) ListDriveListContentTypeColumnLinksCompleteMatchingPredicate(ctx context.Context, id stable.MeDriveIdListContentTypeId, options ListDriveListContentTypeColumnLinksOperationOptions, predicate ColumnLinkOperationPredicate) (result ListDriveListContentTypeColumnLinksCompleteResult, err error) {
	items := make([]stable.ColumnLink, 0)

	resp, err := c.ListDriveListContentTypeColumnLinks(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDriveListContentTypeColumnLinksCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
