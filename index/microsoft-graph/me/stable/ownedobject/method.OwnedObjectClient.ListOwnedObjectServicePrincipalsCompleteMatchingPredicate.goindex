package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/ownedobject
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OwnedObjectClient) ListOwnedObjectServicePrincipalsCompleteMatchingPredicate(ctx context.Context, options ListOwnedObjectServicePrincipalsOperationOptions, predicate ServicePrincipalOperationPredicate) (result ListOwnedObjectServicePrincipalsCompleteResult, err error) {
	items := make([]stable.ServicePrincipal, 0)

	resp, err := c.ListOwnedObjectServicePrincipals(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListOwnedObjectServicePrincipalsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
