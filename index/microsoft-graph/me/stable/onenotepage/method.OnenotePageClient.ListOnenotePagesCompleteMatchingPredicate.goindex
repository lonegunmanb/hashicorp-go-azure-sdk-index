package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/onenotepage
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OnenotePageClient) ListOnenotePagesCompleteMatchingPredicate(ctx context.Context, options ListOnenotePagesOperationOptions, predicate OnenotePageOperationPredicate) (result ListOnenotePagesCompleteResult, err error) {
	items := make([]stable.OnenotePage, 0)

	resp, err := c.ListOnenotePages(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListOnenotePagesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
