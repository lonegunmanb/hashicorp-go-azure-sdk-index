package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/todolisttasklinkedresource
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TodoListTaskLinkedResourceClient) ListTodoListTaskLinkedResourcesCompleteMatchingPredicate(ctx context.Context, id stable.MeTodoListIdTaskId, options ListTodoListTaskLinkedResourcesOperationOptions, predicate LinkedResourceOperationPredicate) (result ListTodoListTaskLinkedResourcesCompleteResult, err error) {
	items := make([]stable.LinkedResource, 0)

	resp, err := c.ListTodoListTaskLinkedResources(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTodoListTaskLinkedResourcesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
