package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/mailfolder
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewMailFolderClientWithBaseURI(sdkApi sdkEnv.Api) (*MailFolderClient, error) {
	client, err := msgraph.NewClient(sdkApi, "mailfolder", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating MailFolderClient: %+v", err)
	}

	return &MailFolderClient{
		Client: client,
	}, nil
}
