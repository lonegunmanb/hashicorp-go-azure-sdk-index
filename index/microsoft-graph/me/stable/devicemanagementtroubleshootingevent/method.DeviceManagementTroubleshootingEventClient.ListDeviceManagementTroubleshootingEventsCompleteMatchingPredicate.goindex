package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/devicemanagementtroubleshootingevent
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceManagementTroubleshootingEventClient) ListDeviceManagementTroubleshootingEventsCompleteMatchingPredicate(ctx context.Context, options ListDeviceManagementTroubleshootingEventsOperationOptions, predicate DeviceManagementTroubleshootingEventOperationPredicate) (result ListDeviceManagementTroubleshootingEventsCompleteResult, err error) {
	items := make([]stable.DeviceManagementTroubleshootingEvent, 0)

	resp, err := c.ListDeviceManagementTroubleshootingEvents(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDeviceManagementTroubleshootingEventsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
