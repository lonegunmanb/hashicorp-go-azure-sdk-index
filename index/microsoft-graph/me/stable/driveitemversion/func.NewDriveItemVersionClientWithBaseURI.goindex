package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/driveitemversion
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewDriveItemVersionClientWithBaseURI(sdkApi sdkEnv.Api) (*DriveItemVersionClient, error) {
	client, err := msgraph.NewClient(sdkApi, "driveitemversion", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating DriveItemVersionClient: %+v", err)
	}

	return &DriveItemVersionClient{
		Client: client,
	}, nil
}
