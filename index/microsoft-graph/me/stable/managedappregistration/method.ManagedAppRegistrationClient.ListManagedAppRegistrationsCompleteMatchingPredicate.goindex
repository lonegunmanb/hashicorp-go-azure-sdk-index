package github.com/hashicorp/go-azure-sdk/microsoft-graph/me/stable/managedappregistration
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ManagedAppRegistrationClient) ListManagedAppRegistrationsCompleteMatchingPredicate(ctx context.Context, options ListManagedAppRegistrationsOperationOptions, predicate ManagedAppRegistrationOperationPredicate) (result ListManagedAppRegistrationsCompleteResult, err error) {
	items := make([]stable.ManagedAppRegistration, 0)

	resp, err := c.ListManagedAppRegistrations(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListManagedAppRegistrationsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
