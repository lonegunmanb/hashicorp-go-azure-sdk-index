func (c JoinedTeamScheduleTimeOffRequestClient) ListJoinedTeamScheduleTimeOffRequestsCompleteMatchingPredicate(ctx context.Context, id stable.MeJoinedTeamId, options ListJoinedTeamScheduleTimeOffRequestsOperationOptions, predicate TimeOffRequestOperationPredicate) (result ListJoinedTeamScheduleTimeOffRequestsCompleteResult, err error) {
	items := make([]stable.TimeOffRequest, 0)

	resp, err := c.ListJoinedTeamScheduleTimeOffRequests(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListJoinedTeamScheduleTimeOffRequestsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
