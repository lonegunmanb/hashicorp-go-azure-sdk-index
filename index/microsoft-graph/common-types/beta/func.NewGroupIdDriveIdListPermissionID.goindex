func NewGroupIdDriveIdListPermissionID(groupId string, driveId string, permissionId string) GroupIdDriveIdListPermissionId {
	return GroupIdDriveIdListPermissionId{
		GroupId:      groupId,
		DriveId:      driveId,
		PermissionId: permissionId,
	}
}
