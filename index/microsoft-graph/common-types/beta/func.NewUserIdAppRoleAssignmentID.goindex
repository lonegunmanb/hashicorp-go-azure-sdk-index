func NewUserIdAppRoleAssignmentID(userId string, appRoleAssignmentId string) UserIdAppRoleAssignmentId {
	return UserIdAppRoleAssignmentId{
		UserId:              userId,
		AppRoleAssignmentId: appRoleAssignmentId,
	}
}
