package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
)
func (s Attendee) AttendeeBase() BaseAttendeeBaseImpl {
	return BaseAttendeeBaseImpl{
		Type:         s.Type,
		EmailAddress: s.EmailAddress,
		ODataId:      s.ODataId,
		ODataType:    s.ODataType,
	}
}
