package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type IosHomeScreenFolderPage struct {
	// A list of apps and web clips to appear on a page within a folder. This collection can contain a maximum of 500
	// elements.
	Apps *[]IosHomeScreenApp `json:"apps,omitempty"`

	// Name of the folder page
	DisplayName nullable.Type[string] `json:"displayName,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`
}
