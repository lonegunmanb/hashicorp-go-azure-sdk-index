package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta

type OnlineMeetingRestricted struct {
	// Specifies the reason why shared content from this participant is disabled. Possible values are: watermarkProtection,
	// unknownFutureValue.
	ContentSharingDisabled *OnlineMeetingContentSharingDisabledReason `json:"contentSharingDisabled,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// Specifies the reason why video from this participant is disabled. Possible values are: watermarkProtection,
	// unknownFutureValue.
	VideoDisabled *OnlineMeetingVideoDisabledReason `json:"videoDisabled,omitempty"`
}
