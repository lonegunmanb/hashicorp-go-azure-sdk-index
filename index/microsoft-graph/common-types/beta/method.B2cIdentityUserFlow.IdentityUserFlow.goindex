func (s B2cIdentityUserFlow) IdentityUserFlow() BaseIdentityUserFlowImpl {
	return BaseIdentityUserFlowImpl{
		UserFlowType: s.UserFlowType,
		Id:           s.Id,
		ODataId:      s.ODataId,
		ODataType:    s.ODataType,
	}
}
