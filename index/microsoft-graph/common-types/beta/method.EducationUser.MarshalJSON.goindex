	delete(decoded, "assignedPlans")
	delete(decoded, "provisionedPlans")

	if !s.OmitDiscriminatedValue {
		decoded["@odata.type"] = "#microsoft.graph.educationUser"
	}

	encoded, err = json.Marshal(decoded)
