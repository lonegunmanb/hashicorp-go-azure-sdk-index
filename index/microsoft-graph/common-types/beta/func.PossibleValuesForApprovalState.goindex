func PossibleValuesForApprovalState() []string {
	return []string{
		string(ApprovalState_Aborted),
		string(ApprovalState_Approved),
		string(ApprovalState_Canceled),
		string(ApprovalState_Denied),
		string(ApprovalState_Pending),
	}
}
