package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBodyType(input string) (*BodyType, error) {
	vals := map[string]BodyType{
		"html": BodyType_Html,
		"text": BodyType_Text,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BodyType(input)
	return &out, nil
}
