func NewGroupIdAppRoleAssignmentID(groupId string, appRoleAssignmentId string) GroupIdAppRoleAssignmentId {
	return GroupIdAppRoleAssignmentId{
		GroupId:             groupId,
		AppRoleAssignmentId: appRoleAssignmentId,
	}
}
