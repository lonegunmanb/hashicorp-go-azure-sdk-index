func NewGroupIdDriveIdRootSubscriptionID(groupId string, driveId string, subscriptionId string) GroupIdDriveIdRootSubscriptionId {
	return GroupIdDriveIdRootSubscriptionId{
		GroupId:        groupId,
		DriveId:        driveId,
		SubscriptionId: subscriptionId,
	}
}
