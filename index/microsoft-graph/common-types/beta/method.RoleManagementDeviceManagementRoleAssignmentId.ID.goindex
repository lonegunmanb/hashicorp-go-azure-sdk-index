func (id RoleManagementDeviceManagementRoleAssignmentId) ID() string {
	fmtString := "/roleManagement/deviceManagement/roleAssignments/%s"
	return fmt.Sprintf(fmtString, id.UnifiedRoleAssignmentMultipleId)
}
