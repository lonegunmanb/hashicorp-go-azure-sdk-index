package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePrintEvent(input string) (*PrintEvent, error) {
	vals := map[string]PrintEvent{
		"jobstarted": PrintEvent_JobStarted,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PrintEvent(input)
	return &out, nil
}
