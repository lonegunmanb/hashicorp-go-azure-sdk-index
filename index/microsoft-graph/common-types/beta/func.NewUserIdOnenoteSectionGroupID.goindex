func NewUserIdOnenoteSectionGroupID(userId string, sectionGroupId string) UserIdOnenoteSectionGroupId {
	return UserIdOnenoteSectionGroupId{
		UserId:         userId,
		SectionGroupId: sectionGroupId,
	}
}
