func NewUserIdDriveIdListColumnID(userId string, driveId string, columnDefinitionId string) UserIdDriveIdListColumnId {
	return UserIdDriveIdListColumnId{
		UserId:             userId,
		DriveId:            driveId,
		ColumnDefinitionId: columnDefinitionId,
	}
}
