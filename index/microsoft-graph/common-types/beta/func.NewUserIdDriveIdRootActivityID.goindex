func NewUserIdDriveIdRootActivityID(userId string, driveId string, itemActivityOLDId string) UserIdDriveIdRootActivityId {
	return UserIdDriveIdRootActivityId{
		UserId:            userId,
		DriveId:           driveId,
		ItemActivityOLDId: itemActivityOLDId,
	}
}
