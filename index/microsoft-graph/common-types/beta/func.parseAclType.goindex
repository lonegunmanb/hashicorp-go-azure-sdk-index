package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAclType(input string) (*AclType, error) {
	vals := map[string]AclType{
		"everyone":             AclType_Everyone,
		"everyoneexceptguests": AclType_EveryoneExceptGuests,
		"externalgroup":        AclType_ExternalGroup,
		"group":                AclType_Group,
		"user":                 AclType_User,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AclType(input)
	return &out, nil
}
