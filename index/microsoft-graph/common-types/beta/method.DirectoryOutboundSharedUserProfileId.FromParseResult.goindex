func (id *DirectoryOutboundSharedUserProfileId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.OutboundSharedUserProfileUserId, ok = input.Parsed["outboundSharedUserProfileUserId"]; !ok {
