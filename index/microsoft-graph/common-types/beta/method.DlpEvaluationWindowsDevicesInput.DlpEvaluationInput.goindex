func (s DlpEvaluationWindowsDevicesInput) DlpEvaluationInput() BaseDlpEvaluationInputImpl {
	return BaseDlpEvaluationInputImpl{
		CurrentLabel:             s.CurrentLabel,
		DiscoveredSensitiveTypes: s.DiscoveredSensitiveTypes,
