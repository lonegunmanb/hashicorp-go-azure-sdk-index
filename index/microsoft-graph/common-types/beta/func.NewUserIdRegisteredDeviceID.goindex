func NewUserIdRegisteredDeviceID(userId string, directoryObjectId string) UserIdRegisteredDeviceId {
	return UserIdRegisteredDeviceId{
		UserId:            userId,
		DirectoryObjectId: directoryObjectId,
	}
}
