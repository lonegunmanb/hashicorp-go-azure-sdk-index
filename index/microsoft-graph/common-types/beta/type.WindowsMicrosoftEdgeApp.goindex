type WindowsMicrosoftEdgeApp struct {
	// The enum to specify the channels for Microsoft Edge apps.
	Channel *MicrosoftEdgeChannel `json:"channel,omitempty"`

	// The language locale to use when the Edge app displays text to the user.
	DisplayLanguageLocale nullable.Type[string] `json:"displayLanguageLocale,omitempty"`

	// Fields inherited from MobileApp

