func NewGroupIdTeamChannelIdPlannerPlanID(groupId string, channelId string, plannerPlanId string) GroupIdTeamChannelIdPlannerPlanId {
	return GroupIdTeamChannelIdPlannerPlanId{
		GroupId:       groupId,
		ChannelId:     channelId,
		PlannerPlanId: plannerPlanId,
	}
}
