func (id RoleManagementDirectoryRoleEligibilityScheduleId) ID() string {
	fmtString := "/roleManagement/directory/roleEligibilitySchedules/%s"
	return fmt.Sprintf(fmtString, id.UnifiedRoleEligibilityScheduleId)
}
