func PossibleValuesForAccessLevel() []string {
	return []string{
		string(AccessLevel_Everyone),
		string(AccessLevel_Invited),
		string(AccessLevel_Locked),
		string(AccessLevel_SameEnterprise),
		string(AccessLevel_SameEnterpriseAndFederated),
	}
}
