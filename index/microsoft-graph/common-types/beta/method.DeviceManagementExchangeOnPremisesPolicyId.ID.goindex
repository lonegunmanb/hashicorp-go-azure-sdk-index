func (id DeviceManagementExchangeOnPremisesPolicyId) ID() string {
	fmtString := "/deviceManagement/exchangeOnPremisesPolicies/%s"
	return fmt.Sprintf(fmtString, id.DeviceManagementExchangeOnPremisesPolicyId)
}
