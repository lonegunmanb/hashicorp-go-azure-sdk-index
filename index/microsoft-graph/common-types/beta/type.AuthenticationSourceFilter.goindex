package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta

type AuthenticationSourceFilter struct {
	// Applications to include for evaluation of the authenticationListener. These applications trigger the associated
	// action when used as the client application in the authentication flow. The application identifer is the application's
	// client id.
	IncludeApplications *[]string `json:"includeApplications,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`
}
