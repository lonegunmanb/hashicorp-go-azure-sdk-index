package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type CloudPCNotificationSetting struct {
	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// If true, doesn't prompt the user to restart the Cloud PC. If false, prompts the user to restart Cloud PC. The default
	// value is false.
	RestartPromptsDisabled nullable.Type[bool] `json:"restartPromptsDisabled,omitempty"`
}
