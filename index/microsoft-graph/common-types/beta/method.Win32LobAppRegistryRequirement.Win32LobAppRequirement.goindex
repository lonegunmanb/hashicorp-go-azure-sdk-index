func (s Win32LobAppRegistryRequirement) Win32LobAppRequirement() BaseWin32LobAppRequirementImpl {
	return BaseWin32LobAppRequirementImpl{
		DetectionValue: s.DetectionValue,
		ODataId:        s.ODataId,
		ODataType:      s.ODataType,
		Operator:       s.Operator,
	}
}
