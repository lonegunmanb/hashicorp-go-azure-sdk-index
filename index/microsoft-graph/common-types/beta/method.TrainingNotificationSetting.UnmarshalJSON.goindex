	if err := json.Unmarshal(bytes, &temp); err != nil {
		return fmt.Errorf("unmarshaling TrainingNotificationSetting into map[string]json.RawMessage: %+v", err)
	}

	if v, ok := temp["trainingAssignment"]; ok {
