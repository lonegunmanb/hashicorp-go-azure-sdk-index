func (s BaseShiftItemImpl) ScheduleEntity() BaseScheduleEntityImpl {
	return BaseScheduleEntityImpl{
		EndDateTime:   s.EndDateTime,
		ODataId:       s.ODataId,
		ODataType:     s.ODataType,
		StartDateTime: s.StartDateTime,
		Theme:         s.Theme,
	}
}
