func (id *DeviceManagementHardwarePasswordDetailId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.HardwarePasswordDetailId, ok = input.Parsed["hardwarePasswordDetailId"]; !ok {
