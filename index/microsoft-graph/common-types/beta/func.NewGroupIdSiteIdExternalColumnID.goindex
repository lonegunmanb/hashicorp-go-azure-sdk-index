func NewGroupIdSiteIdExternalColumnID(groupId string, siteId string, columnDefinitionId string) GroupIdSiteIdExternalColumnId {
	return GroupIdSiteIdExternalColumnId{
		GroupId:            groupId,
		SiteId:             siteId,
		ColumnDefinitionId: columnDefinitionId,
	}
}
