func NewGroupIdSiteIdContentModelID(groupId string, siteId string, contentModelId string) GroupIdSiteIdContentModelId {
	return GroupIdSiteIdContentModelId{
		GroupId:        groupId,
		SiteId:         siteId,
		ContentModelId: contentModelId,
	}
}
