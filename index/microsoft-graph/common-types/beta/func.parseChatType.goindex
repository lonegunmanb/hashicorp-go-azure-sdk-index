package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseChatType(input string) (*ChatType, error) {
	vals := map[string]ChatType{
		"group":    ChatType_Group,
		"meeting":  ChatType_Meeting,
		"oneonone": ChatType_OneOnOne,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ChatType(input)
	return &out, nil
}
