func (s HealthMonitoringGroupImpactSummary) HealthMonitoringDirectoryObjectImpactSummary() BaseHealthMonitoringDirectoryObjectImpactSummaryImpl {
	return BaseHealthMonitoringDirectoryObjectImpactSummaryImpl{
