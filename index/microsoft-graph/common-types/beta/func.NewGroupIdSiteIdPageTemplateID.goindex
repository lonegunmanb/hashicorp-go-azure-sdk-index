func NewGroupIdSiteIdPageTemplateID(groupId string, siteId string, pageTemplateId string) GroupIdSiteIdPageTemplateId {
	return GroupIdSiteIdPageTemplateId{
		GroupId:        groupId,
		SiteId:         siteId,
		PageTemplateId: pageTemplateId,
	}
}
