func NewGroupIdTransitiveMemberOfID(groupId string, directoryObjectId string) GroupIdTransitiveMemberOfId {
	return GroupIdTransitiveMemberOfId{
		GroupId:           groupId,
		DirectoryObjectId: directoryObjectId,
	}
}
