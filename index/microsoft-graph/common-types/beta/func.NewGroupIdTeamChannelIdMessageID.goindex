func NewGroupIdTeamChannelIdMessageID(groupId string, channelId string, chatMessageId string) GroupIdTeamChannelIdMessageId {
	return GroupIdTeamChannelIdMessageId{
		GroupId:       groupId,
		ChannelId:     channelId,
		ChatMessageId: chatMessageId,
	}
}
