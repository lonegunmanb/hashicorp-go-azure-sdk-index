func NewUserIdTransitiveMemberOfID(userId string, directoryObjectId string) UserIdTransitiveMemberOfId {
	return UserIdTransitiveMemberOfId{
		UserId:            userId,
		DirectoryObjectId: directoryObjectId,
	}
}
