func NewUserIdDeviceIdUsageRightID(userId string, deviceId string, usageRightId string) UserIdDeviceIdUsageRightId {
	return UserIdDeviceIdUsageRightId{
		UserId:       userId,
		DeviceId:     deviceId,
		UsageRightId: usageRightId,
	}
}
