func (id *ReportUserInsightDailyInactiveUserId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.DailyInactiveUsersMetricId, ok = input.Parsed["dailyInactiveUsersMetricId"]; !ok {
