func (s PlannerSharedWithContainer) PlannerPlanContainer() BasePlannerPlanContainerImpl {
	return BasePlannerPlanContainerImpl{
		ContainerId: s.ContainerId,
		ODataId:     s.ODataId,
		ODataType:   s.ODataType,
		Type:        s.Type,
		Url:         s.Url,
	}
}
