func (s AllDomains) ValidatingDomains() BaseValidatingDomainsImpl {
	return BaseValidatingDomainsImpl{
		ODataId:     s.ODataId,
		ODataType:   s.ODataType,
		RootDomains: s.RootDomains,
	}
}
