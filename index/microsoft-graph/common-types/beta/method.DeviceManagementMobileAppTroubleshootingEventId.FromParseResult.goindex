func (id *DeviceManagementMobileAppTroubleshootingEventId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.MobileAppTroubleshootingEventId, ok = input.Parsed["mobileAppTroubleshootingEventId"]; !ok {
