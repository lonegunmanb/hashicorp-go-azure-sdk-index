func NewGroupIdDriveIdRootChildID(groupId string, driveId string, driveItemId string) GroupIdDriveIdRootChildId {
	return GroupIdDriveIdRootChildId{
		GroupId:     groupId,
		DriveId:     driveId,
		DriveItemId: driveItemId,
	}
}
