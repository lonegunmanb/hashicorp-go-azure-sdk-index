func (id RoleManagementEntitlementManagementRoleDefinitionId) ID() string {
	fmtString := "/roleManagement/entitlementManagement/roleDefinitions/%s"
	return fmt.Sprintf(fmtString, id.UnifiedRoleDefinitionId)
}
