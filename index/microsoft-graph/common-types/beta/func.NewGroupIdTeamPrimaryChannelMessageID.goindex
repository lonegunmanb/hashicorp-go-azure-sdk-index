func NewGroupIdTeamPrimaryChannelMessageID(groupId string, chatMessageId string) GroupIdTeamPrimaryChannelMessageId {
	return GroupIdTeamPrimaryChannelMessageId{
		GroupId:       groupId,
		ChatMessageId: chatMessageId,
	}
}
