package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
func (s VirtualEventTownhall) VirtualEvent() BaseVirtualEventImpl {
	return BaseVirtualEventImpl{
		CreatedBy:                s.CreatedBy,
		Description:              s.Description,
		DisplayName:              s.DisplayName,
		EndDateTime:              s.EndDateTime,
		ExternalEventInformation: s.ExternalEventInformation,
		Presenters:               s.Presenters,
		Sessions:                 s.Sessions,
		Settings:                 s.Settings,
		StartDateTime:            s.StartDateTime,
		Status:                   s.Status,
		Id:                       s.Id,
		ODataId:                  s.ODataId,
		ODataType:                s.ODataType,
	}
}
