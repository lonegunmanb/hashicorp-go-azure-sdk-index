func (id *IdentityGovernanceLifecycleWorkflowWorkflowTemplateId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.WorkflowTemplateId, ok = input.Parsed["workflowTemplateId"]; !ok {
