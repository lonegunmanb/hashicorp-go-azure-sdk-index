func NewGroupIdSiteIdContentTypeID(groupId string, siteId string, contentTypeId string) GroupIdSiteIdContentTypeId {
	return GroupIdSiteIdContentTypeId{
		GroupId:       groupId,
		SiteId:        siteId,
		ContentTypeId: contentTypeId,
	}
}
