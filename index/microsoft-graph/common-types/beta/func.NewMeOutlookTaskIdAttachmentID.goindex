func NewMeOutlookTaskIdAttachmentID(outlookTaskId string, attachmentId string) MeOutlookTaskIdAttachmentId {
	return MeOutlookTaskIdAttachmentId{
		OutlookTaskId: outlookTaskId,
		AttachmentId:  attachmentId,
	}
}
