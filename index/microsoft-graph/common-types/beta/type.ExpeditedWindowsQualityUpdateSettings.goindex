package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta

type ExpeditedWindowsQualityUpdateSettings struct {
	// The number of days after installation that forced reboot will happen.
	DaysUntilForcedReboot *int64 `json:"daysUntilForcedReboot,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// The release date to identify a quality update.
	QualityUpdateRelease *string `json:"qualityUpdateRelease,omitempty"`
}
