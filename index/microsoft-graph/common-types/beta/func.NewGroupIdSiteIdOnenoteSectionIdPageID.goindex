package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewGroupIdSiteIdOnenoteSectionIdPageID(groupId string, siteId string, onenoteSectionId string, onenotePageId string) GroupIdSiteIdOnenoteSectionIdPageId {
	return GroupIdSiteIdOnenoteSectionIdPageId{
		GroupId:          groupId,
		SiteId:           siteId,
		OnenoteSectionId: onenoteSectionId,
		OnenotePageId:    onenotePageId,
	}
}
