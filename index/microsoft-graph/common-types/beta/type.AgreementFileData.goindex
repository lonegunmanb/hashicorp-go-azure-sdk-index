import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type AgreementFileData struct {
	// Data that represents the terms of use PDF document. Read-only. Note: You can use the .NET Convert.ToBase64String
	// method to convert your file to binary data for uploading using the Create agreements API. A sample syntax using this
	// method in PowerShell is [convert]::ToBase64String((Get-Content -path 'yourfilepath' -Encoding byte)).
	Data nullable.Type[string] `json:"data,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`
}
