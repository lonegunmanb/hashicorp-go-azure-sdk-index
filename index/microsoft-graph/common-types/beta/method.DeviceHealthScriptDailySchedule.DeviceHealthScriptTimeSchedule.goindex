func (s DeviceHealthScriptDailySchedule) DeviceHealthScriptTimeSchedule() BaseDeviceHealthScriptTimeScheduleImpl {
	return BaseDeviceHealthScriptTimeScheduleImpl{
		Time:      s.Time,
		UseUtc:    s.UseUtc,
		Interval:  s.Interval,
		ODataId:   s.ODataId,
		ODataType: s.ODataType,
	}
}
