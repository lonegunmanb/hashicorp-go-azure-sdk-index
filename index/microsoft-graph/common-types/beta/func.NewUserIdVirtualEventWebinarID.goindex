func NewUserIdVirtualEventWebinarID(userId string, virtualEventWebinarId string) UserIdVirtualEventWebinarId {
	return UserIdVirtualEventWebinarId{
		UserId:                userId,
		VirtualEventWebinarId: virtualEventWebinarId,
	}
}
