func (id *ReportUserInsightMonthlyMfaRegisteredUserId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.MfaUserCountMetricId, ok = input.Parsed["mfaUserCountMetricId"]; !ok {
