func NewGroupIdDriveIdListColumnID(groupId string, driveId string, columnDefinitionId string) GroupIdDriveIdListColumnId {
	return GroupIdDriveIdListColumnId{
		GroupId:            groupId,
		DriveId:            driveId,
		ColumnDefinitionId: columnDefinitionId,
	}
}
