package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePriority(input string) (*Priority, error) {
	vals := map[string]Priority{
		"high": Priority_High,
		"low":  Priority_Low,
		"none": Priority_None,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Priority(input)
	return &out, nil
}
