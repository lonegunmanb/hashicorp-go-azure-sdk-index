func PossibleValuesForWiFiAuthenticationMethod() []string {
	return []string{
		string(WiFiAuthenticationMethod_Certificate),
		string(WiFiAuthenticationMethod_DerivedCredential),
		string(WiFiAuthenticationMethod_UsernameAndPassword),
