func NewMeDriveIdItemIdExtensionID(driveId string, driveItemId string, extensionId string) MeDriveIdItemIdExtensionId {
	return MeDriveIdItemIdExtensionId{
		DriveId:     driveId,
		DriveItemId: driveItemId,
		ExtensionId: extensionId,
	}
}
