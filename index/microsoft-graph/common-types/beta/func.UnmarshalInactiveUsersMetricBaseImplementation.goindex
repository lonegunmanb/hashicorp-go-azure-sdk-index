	}

	var parent BaseInactiveUsersMetricBaseImpl
	if err := json.Unmarshal(input, &parent); err != nil {
		return nil, fmt.Errorf("unmarshaling into BaseInactiveUsersMetricBaseImpl: %+v", err)
