func PossibleValuesForPrintScaling() []string {
	return []string{
		string(PrintScaling_Auto),
		string(PrintScaling_Fill),
		string(PrintScaling_Fit),
		string(PrintScaling_None),
		string(PrintScaling_ShrinkToFit),
	}
}
