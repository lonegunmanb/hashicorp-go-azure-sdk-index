package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type TeamworkSoftwareUpdateStatus struct {
	// The available software version to update.
	AvailableVersion nullable.Type[string] `json:"availableVersion,omitempty"`

	// The current software version.
	CurrentVersion nullable.Type[string] `json:"currentVersion,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// The update status of the software. The possible values are: unknown, latest, updateAvailable, unknownFutureValue.
	SoftwareFreshness *TeamworkSoftwareFreshness `json:"softwareFreshness,omitempty"`
}
