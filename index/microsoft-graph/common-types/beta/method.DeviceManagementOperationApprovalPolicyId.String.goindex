package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id DeviceManagementOperationApprovalPolicyId) String() string {
	components := []string{
		fmt.Sprintf("Operation Approval Policy: %q", id.OperationApprovalPolicyId),
	}
	return fmt.Sprintf("Device Management Operation Approval Policy (%s)", strings.Join(components, "\n"))
}
