func (s EnumeratedScopeSensitivityLabels) ScopeSensitivityLabels() BaseScopeSensitivityLabelsImpl {
	return BaseScopeSensitivityLabelsImpl{
		LabelKind: s.LabelKind,
		ODataId:   s.ODataId,
		ODataType: s.ODataType,
	}
}
