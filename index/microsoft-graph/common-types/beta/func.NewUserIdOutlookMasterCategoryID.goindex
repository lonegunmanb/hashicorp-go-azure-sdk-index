func NewUserIdOutlookMasterCategoryID(userId string, outlookCategoryId string) UserIdOutlookMasterCategoryId {
	return UserIdOutlookMasterCategoryId{
		UserId:            userId,
		OutlookCategoryId: outlookCategoryId,
	}
}
