package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
)
func (s ItemInsights) OfficeGraphInsights() BaseOfficeGraphInsightsImpl {
	return BaseOfficeGraphInsightsImpl{
		Shared:    s.Shared,
		Trending:  s.Trending,
		Used:      s.Used,
		Id:        s.Id,
		ODataId:   s.ODataId,
		ODataType: s.ODataType,
	}
}
