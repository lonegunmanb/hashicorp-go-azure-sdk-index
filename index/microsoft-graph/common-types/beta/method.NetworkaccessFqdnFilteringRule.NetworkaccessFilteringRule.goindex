func (s NetworkaccessFqdnFilteringRule) NetworkaccessFilteringRule() BaseNetworkaccessFilteringRuleImpl {
	return BaseNetworkaccessFilteringRuleImpl{
		Destinations: s.Destinations,
		RuleType:     s.RuleType,
		Name:         s.Name,
		Id:           s.Id,
		ODataId:      s.ODataId,
		ODataType:    s.ODataType,
	}
}
