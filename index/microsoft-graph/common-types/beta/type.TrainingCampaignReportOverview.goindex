package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta

type TrainingCampaignReportOverview struct {
	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// Aggregate data of training completion.
	TrainingModuleCompletion *TrainingEventsContent `json:"trainingModuleCompletion,omitempty"`

	// Aggregate data of training mail delivery over the course of the training campaign.
	TrainingNotificationDeliveryStatus *TrainingNotificationDelivery `json:"trainingNotificationDeliveryStatus,omitempty"`

	// Aggregate data of users training progress.
	UserCompletionStatus *UserTrainingCompletionSummary `json:"userCompletionStatus,omitempty"`
}
