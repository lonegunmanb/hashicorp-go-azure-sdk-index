func NewGroupIdDriveIdRootExtensionID(groupId string, driveId string, extensionId string) GroupIdDriveIdRootExtensionId {
	return GroupIdDriveIdRootExtensionId{
		GroupId:     groupId,
		DriveId:     driveId,
		ExtensionId: extensionId,
	}
}
