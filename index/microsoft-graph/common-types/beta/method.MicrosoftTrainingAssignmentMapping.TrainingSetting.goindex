func (s MicrosoftTrainingAssignmentMapping) TrainingSetting() BaseTrainingSettingImpl {
	return BaseTrainingSettingImpl{
		ODataId:     s.ODataId,
		ODataType:   s.ODataType,
		SettingType: s.SettingType,
	}
}
