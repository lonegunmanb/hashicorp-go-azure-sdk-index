package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseEmailType(input string) (*EmailType, error) {
	vals := map[string]EmailType{
		"main":     EmailType_Main,
		"other":    EmailType_Other,
		"personal": EmailType_Personal,
		"unknown":  EmailType_Unknown,
		"work":     EmailType_Work,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := EmailType(input)
	return &out, nil
}
