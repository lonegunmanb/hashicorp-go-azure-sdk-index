	// DoNotDisturb, InACall, InAConferenceCall, Inactive, InAMeeting, Offline, OffWork, OutOfOffice, PresenceUnknown,
	// Presenting, UrgentInterruptionsOnly.
	Activity nullable.Type[string] `json:"activity,omitempty"`

