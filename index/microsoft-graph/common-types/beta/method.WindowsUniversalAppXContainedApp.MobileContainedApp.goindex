func (s WindowsUniversalAppXContainedApp) MobileContainedApp() BaseMobileContainedAppImpl {
	return BaseMobileContainedAppImpl{
		Id:        s.Id,
		ODataId:   s.ODataId,
		ODataType: s.ODataType,
	}
}
