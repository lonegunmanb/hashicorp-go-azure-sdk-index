package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type Currency struct {
	AmountDecimalPlaces     nullable.Type[string]  `json:"amountDecimalPlaces,omitempty"`
	AmountRoundingPrecision nullable.Type[float64] `json:"amountRoundingPrecision,omitempty"`
	Code                    nullable.Type[string]  `json:"code,omitempty"`
	DisplayName             nullable.Type[string]  `json:"displayName,omitempty"`
	Id                      *string                `json:"id,omitempty"`
	LastModifiedDateTime    nullable.Type[string]  `json:"lastModifiedDateTime,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	Symbol nullable.Type[string] `json:"symbol,omitempty"`
}
