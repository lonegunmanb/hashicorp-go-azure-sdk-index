func NewMeDriveIdRootThumbnailID(driveId string, thumbnailSetId string) MeDriveIdRootThumbnailId {
	return MeDriveIdRootThumbnailId{
		DriveId:        driveId,
		ThumbnailSetId: thumbnailSetId,
	}
}
