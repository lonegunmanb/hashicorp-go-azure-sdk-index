package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
func (s NetworkaccessForwardingPolicy) NetworkaccessPolicy() BaseNetworkaccessPolicyImpl {
	return BaseNetworkaccessPolicyImpl{
		Description: s.Description,
		Name:        s.Name,
		PolicyRules: s.PolicyRules,
		Version:     s.Version,
		Id:          s.Id,
		ODataId:     s.ODataId,
		ODataType:   s.ODataType,
	}
}
