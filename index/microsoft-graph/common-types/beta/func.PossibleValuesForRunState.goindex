func PossibleValuesForRunState() []string {
	return []string{
		string(RunState_Fail),
		string(RunState_NotApplicable),
		string(RunState_Pending),
		string(RunState_ScriptError),
		string(RunState_Success),
		string(RunState_Unknown),
	}
}
