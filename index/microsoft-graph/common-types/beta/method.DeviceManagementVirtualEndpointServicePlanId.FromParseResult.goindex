func (id *DeviceManagementVirtualEndpointServicePlanId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.CloudPCServicePlanId, ok = input.Parsed["cloudPCServicePlanId"]; !ok {
