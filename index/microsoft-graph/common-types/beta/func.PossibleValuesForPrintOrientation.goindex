func PossibleValuesForPrintOrientation() []string {
	return []string{
		string(PrintOrientation_Landscape),
		string(PrintOrientation_Portrait),
		string(PrintOrientation_ReverseLandscape),
		string(PrintOrientation_ReversePortrait),
	}
}
