func NewGroupIdSiteIdDriveID(groupId string, siteId string, driveId string) GroupIdSiteIdDriveId {
	return GroupIdSiteIdDriveId{
		GroupId: groupId,
		SiteId:  siteId,
		DriveId: driveId,
	}
}
