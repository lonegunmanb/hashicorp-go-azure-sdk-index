package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
func (s ProcessingError) ClassificationError() BaseClassificationErrorImpl {
	return BaseClassificationErrorImpl{
		Details:    s.Details,
		Code:       s.Code,
		InnerError: s.InnerError,
		Message:    s.Message,
		ODataId:    s.ODataId,
		ODataType:  s.ODataType,
		Target:     s.Target,
	}
}
