func NewMeDeviceIdDeviceTemplateID(deviceId string, deviceTemplateId string) MeDeviceIdDeviceTemplateId {
	return MeDeviceIdDeviceTemplateId{
		DeviceId:         deviceId,
		DeviceTemplateId: deviceTemplateId,
	}
}
