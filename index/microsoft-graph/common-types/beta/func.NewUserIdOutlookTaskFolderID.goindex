func NewUserIdOutlookTaskFolderID(userId string, outlookTaskFolderId string) UserIdOutlookTaskFolderId {
	return UserIdOutlookTaskFolderId{
		UserId:              userId,
		OutlookTaskFolderId: outlookTaskFolderId,
	}
}
