func NewGroupIdTransitiveMemberID(groupId string, directoryObjectId string) GroupIdTransitiveMemberId {
	return GroupIdTransitiveMemberId{
		GroupId:           groupId,
		DirectoryObjectId: directoryObjectId,
	}
}
