func NewUserIdContactFolderIdContactID(userId string, contactFolderId string, contactId string) UserIdContactFolderIdContactId {
	return UserIdContactFolderIdContactId{
		UserId:          userId,
		ContactFolderId: contactFolderId,
		ContactId:       contactId,
	}
}
