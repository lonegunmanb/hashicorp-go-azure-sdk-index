func NewGroupIdDriveIdListItemID(groupId string, driveId string, listItemId string) GroupIdDriveIdListItemId {
	return GroupIdDriveIdListItemId{
		GroupId:    groupId,
		DriveId:    driveId,
		ListItemId: listItemId,
	}
}
