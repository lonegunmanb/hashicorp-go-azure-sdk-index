func (id IdentityGovernanceAccessReviewHistoryDefinitionId) ID() string {
	fmtString := "/identityGovernance/accessReviews/historyDefinitions/%s"
	return fmt.Sprintf(fmtString, id.AccessReviewHistoryDefinitionId)
}
