	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id DeviceManagementUserExperienceAnalyticsAppHealthApplicationPerformanceByOSVersionId) String() string {
	components := []string{
		fmt.Sprintf("User Experience Analytics App Health App Performance By O S Version: %q", id.UserExperienceAnalyticsAppHealthAppPerformanceByOSVersionId),
