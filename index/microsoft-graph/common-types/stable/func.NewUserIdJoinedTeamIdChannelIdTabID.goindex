func NewUserIdJoinedTeamIdChannelIdTabID(userId string, teamId string, channelId string, teamsTabId string) UserIdJoinedTeamIdChannelIdTabId {
	return UserIdJoinedTeamIdChannelIdTabId{
		UserId:     userId,
		TeamId:     teamId,
		ChannelId:  channelId,
		TeamsTabId: teamsTabId,
	}
}
