func NewGroupIdGroupLifecyclePolicyID(groupId string, groupLifecyclePolicyId string) GroupIdGroupLifecyclePolicyId {
	return GroupIdGroupLifecyclePolicyId{
		GroupId:                groupId,
		GroupLifecyclePolicyId: groupLifecyclePolicyId,
	}
}
