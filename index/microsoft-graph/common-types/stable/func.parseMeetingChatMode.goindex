package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMeetingChatMode(input string) (*MeetingChatMode, error) {
	vals := map[string]MeetingChatMode{
		"disabled": MeetingChatMode_Disabled,
		"enabled":  MeetingChatMode_Enabled,
		"limited":  MeetingChatMode_Limited,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MeetingChatMode(input)
	return &out, nil
}
