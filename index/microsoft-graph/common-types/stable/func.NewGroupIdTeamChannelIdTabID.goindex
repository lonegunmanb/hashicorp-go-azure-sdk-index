func NewGroupIdTeamChannelIdTabID(groupId string, channelId string, teamsTabId string) GroupIdTeamChannelIdTabId {
	return GroupIdTeamChannelIdTabId{
		GroupId:    groupId,
		ChannelId:  channelId,
		TeamsTabId: teamsTabId,
	}
}
