func NewGroupIdSiteIdOnenoteNotebookID(groupId string, siteId string, notebookId string) GroupIdSiteIdOnenoteNotebookId {
	return GroupIdSiteIdOnenoteNotebookId{
		GroupId:    groupId,
		SiteId:     siteId,
		NotebookId: notebookId,
	}
}
