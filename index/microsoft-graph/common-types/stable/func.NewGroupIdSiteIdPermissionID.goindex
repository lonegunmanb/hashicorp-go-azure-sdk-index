func NewGroupIdSiteIdPermissionID(groupId string, siteId string, permissionId string) GroupIdSiteIdPermissionId {
	return GroupIdSiteIdPermissionId{
		GroupId:      groupId,
		SiteId:       siteId,
		PermissionId: permissionId,
	}
}
