package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseImportance(input string) (*Importance, error) {
	vals := map[string]Importance{
		"high":   Importance_High,
		"low":    Importance_Low,
		"normal": Importance_Normal,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Importance(input)
	return &out, nil
}
