func NewMeChatIdPinnedMessageID(chatId string, pinnedChatMessageInfoId string) MeChatIdPinnedMessageId {
	return MeChatIdPinnedMessageId{
		ChatId:                  chatId,
		PinnedChatMessageInfoId: pinnedChatMessageInfoId,
	}
}
