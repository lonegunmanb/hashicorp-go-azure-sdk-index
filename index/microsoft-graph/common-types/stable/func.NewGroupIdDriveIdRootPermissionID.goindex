func NewGroupIdDriveIdRootPermissionID(groupId string, driveId string, permissionId string) GroupIdDriveIdRootPermissionId {
	return GroupIdDriveIdRootPermissionId{
		GroupId:      groupId,
		DriveId:      driveId,
		PermissionId: permissionId,
	}
}
