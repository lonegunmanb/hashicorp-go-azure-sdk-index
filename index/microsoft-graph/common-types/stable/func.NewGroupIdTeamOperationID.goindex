func NewGroupIdTeamOperationID(groupId string, teamsAsyncOperationId string) GroupIdTeamOperationId {
	return GroupIdTeamOperationId{
		GroupId:               groupId,
		TeamsAsyncOperationId: teamsAsyncOperationId,
	}
}
