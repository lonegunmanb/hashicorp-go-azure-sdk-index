func NewUserIdAuthenticationOperationID(userId string, longRunningOperationId string) UserIdAuthenticationOperationId {
	return UserIdAuthenticationOperationId{
		UserId:                 userId,
		LongRunningOperationId: longRunningOperationId,
	}
}
