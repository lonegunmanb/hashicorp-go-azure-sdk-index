func (s EducationFeedbackOutcome) EducationOutcome() BaseEducationOutcomeImpl {
	return BaseEducationOutcomeImpl{
		LastModifiedBy:       s.LastModifiedBy,
		LastModifiedDateTime: s.LastModifiedDateTime,
		Id:                   s.Id,
		ODataId:              s.ODataId,
		ODataType:            s.ODataType,
	}
}
