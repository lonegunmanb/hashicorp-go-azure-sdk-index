func NewUserIdJoinedTeamIdTagID(userId string, teamId string, teamworkTagId string) UserIdJoinedTeamIdTagId {
	return UserIdJoinedTeamIdTagId{
		UserId:        userId,
		TeamId:        teamId,
		TeamworkTagId: teamworkTagId,
