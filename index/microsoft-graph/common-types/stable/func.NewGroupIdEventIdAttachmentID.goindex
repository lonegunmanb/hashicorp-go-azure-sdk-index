func NewGroupIdEventIdAttachmentID(groupId string, eventId string, attachmentId string) GroupIdEventIdAttachmentId {
	return GroupIdEventIdAttachmentId{
		GroupId:      groupId,
		EventId:      eventId,
		AttachmentId: attachmentId,
	}
}
