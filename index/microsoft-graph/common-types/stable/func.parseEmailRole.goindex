package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseEmailRole(input string) (*EmailRole, error) {
	vals := map[string]EmailRole{
		"recipient": EmailRole_Recipient,
		"sender":    EmailRole_Sender,
		"unknown":   EmailRole_Unknown,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := EmailRole(input)
	return &out, nil
}
