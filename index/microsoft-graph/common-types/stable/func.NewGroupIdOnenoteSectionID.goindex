func NewGroupIdOnenoteSectionID(groupId string, onenoteSectionId string) GroupIdOnenoteSectionId {
	return GroupIdOnenoteSectionId{
		GroupId:          groupId,
		OnenoteSectionId: onenoteSectionId,
	}
}
