func NewApplicationIdOwnerID(applicationId string, directoryObjectId string) ApplicationIdOwnerId {
	return ApplicationIdOwnerId{
		ApplicationId:     applicationId,
		DirectoryObjectId: directoryObjectId,
	}
}
