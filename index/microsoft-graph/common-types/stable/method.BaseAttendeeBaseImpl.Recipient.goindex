func (s BaseAttendeeBaseImpl) Recipient() BaseRecipientImpl {
	return BaseRecipientImpl{
		EmailAddress: s.EmailAddress,
		ODataId:      s.ODataId,
		ODataType:    s.ODataType,
	}
}
