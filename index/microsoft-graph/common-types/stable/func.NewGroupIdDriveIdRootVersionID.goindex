func NewGroupIdDriveIdRootVersionID(groupId string, driveId string, driveItemVersionId string) GroupIdDriveIdRootVersionId {
	return GroupIdDriveIdRootVersionId{
		GroupId:            groupId,
		DriveId:            driveId,
		DriveItemVersionId: driveItemVersionId,
	}
}
