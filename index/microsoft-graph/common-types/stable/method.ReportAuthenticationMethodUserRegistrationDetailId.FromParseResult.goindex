func (id *ReportAuthenticationMethodUserRegistrationDetailId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.UserRegistrationDetailsId, ok = input.Parsed["userRegistrationDetailsId"]; !ok {
