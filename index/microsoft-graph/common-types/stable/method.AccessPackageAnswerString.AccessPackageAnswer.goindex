func (s AccessPackageAnswerString) AccessPackageAnswer() BaseAccessPackageAnswerImpl {
	return BaseAccessPackageAnswerImpl{
		AnsweredQuestion: s.AnsweredQuestion,
		DisplayValue:     s.DisplayValue,
		ODataId:          s.ODataId,
		ODataType:        s.ODataType,
	}
}
