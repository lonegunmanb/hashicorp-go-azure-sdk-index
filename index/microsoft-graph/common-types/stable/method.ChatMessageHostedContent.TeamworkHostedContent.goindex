func (s ChatMessageHostedContent) TeamworkHostedContent() BaseTeamworkHostedContentImpl {
	return BaseTeamworkHostedContentImpl{
		ContentBytes: s.ContentBytes,
		ContentType:  s.ContentType,
		Id:           s.Id,
		ODataId:      s.ODataId,
		ODataType:    s.ODataType,
	}
}
