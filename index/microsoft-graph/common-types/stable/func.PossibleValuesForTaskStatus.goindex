func PossibleValuesForTaskStatus() []string {
	return []string{
		string(TaskStatus_Completed),
		string(TaskStatus_Deferred),
		string(TaskStatus_InProgress),
		string(TaskStatus_NotStarted),
		string(TaskStatus_WaitingOnOthers),
	}
}
