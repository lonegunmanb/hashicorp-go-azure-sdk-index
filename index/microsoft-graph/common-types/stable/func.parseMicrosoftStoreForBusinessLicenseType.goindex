package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMicrosoftStoreForBusinessLicenseType(input string) (*MicrosoftStoreForBusinessLicenseType, error) {
	vals := map[string]MicrosoftStoreForBusinessLicenseType{
		"offline": MicrosoftStoreForBusinessLicenseType_Offline,
		"online":  MicrosoftStoreForBusinessLicenseType_Online,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MicrosoftStoreForBusinessLicenseType(input)
	return &out, nil
}
