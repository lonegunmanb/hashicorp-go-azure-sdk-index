func NewUserIdJoinedTeamIdScheduleOpenShiftID(userId string, teamId string, openShiftId string) UserIdJoinedTeamIdScheduleOpenShiftId {
	return UserIdJoinedTeamIdScheduleOpenShiftId{
		UserId:      userId,
		TeamId:      teamId,
		OpenShiftId: openShiftId,
	}
}
