package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id GroupIdSiteIdOnenoteSectionIdPageId) ID() string {
	fmtString := "/groups/%s/sites/%s/onenote/sections/%s/pages/%s"
	return fmt.Sprintf(fmtString, id.GroupId, id.SiteId, id.OnenoteSectionId, id.OnenotePageId)
}
