func NewGroupIdCalendarEventIdExtensionID(groupId string, eventId string, extensionId string) GroupIdCalendarEventIdExtensionId {
	return GroupIdCalendarEventIdExtensionId{
		GroupId:     groupId,
		EventId:     eventId,
		ExtensionId: extensionId,
	}
}
