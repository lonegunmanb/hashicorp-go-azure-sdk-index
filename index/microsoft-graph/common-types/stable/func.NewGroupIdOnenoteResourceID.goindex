func NewGroupIdOnenoteResourceID(groupId string, onenoteResourceId string) GroupIdOnenoteResourceId {
	return GroupIdOnenoteResourceId{
		GroupId:           groupId,
		OnenoteResourceId: onenoteResourceId,
	}
}
