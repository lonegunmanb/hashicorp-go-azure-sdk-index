func NewGroupIdOnenoteSectionGroupID(groupId string, sectionGroupId string) GroupIdOnenoteSectionGroupId {
	return GroupIdOnenoteSectionGroupId{
		GroupId:        groupId,
		SectionGroupId: sectionGroupId,
	}
}
