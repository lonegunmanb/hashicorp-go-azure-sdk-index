func (s VirtualEventPresenterInfo) MeetingParticipantInfo() BaseMeetingParticipantInfoImpl {
	return BaseMeetingParticipantInfoImpl{
		Identity:  s.Identity,
		ODataId:   s.ODataId,
		ODataType: s.ODataType,
		Role:      s.Role,
		Upn:       s.Upn,
	}
}
