package github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/nullable"
)
type TeamsTab struct {
	// Container for custom settings applied to a tab. The tab is considered configured only once this property is set.
	Configuration *TeamsTabConfiguration `json:"configuration,omitempty"`

	// Name of the tab.
	DisplayName nullable.Type[string] `json:"displayName,omitempty"`

	// The application that is linked to the tab. This can't be changed after tab creation.
	TeamsApp *TeamsApp `json:"teamsApp,omitempty"`

	// Deep link URL of the tab instance. Read only.
	WebUrl nullable.Type[string] `json:"webUrl,omitempty"`

	// Fields inherited from Entity

	// The unique identifier for an entity. Read-only.
	Id *string `json:"id,omitempty"`

	// The OData ID of this entity
	ODataId *string `json:"@odata.id,omitempty"`

	// The OData Type of this entity
	ODataType *string `json:"@odata.type,omitempty"`

	// Model Behaviors
	OmitDiscriminatedValue bool `json:"-"`
}
