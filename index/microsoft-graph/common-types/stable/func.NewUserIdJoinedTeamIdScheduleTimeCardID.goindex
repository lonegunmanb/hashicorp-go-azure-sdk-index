func NewUserIdJoinedTeamIdScheduleTimeCardID(userId string, teamId string, timeCardId string) UserIdJoinedTeamIdScheduleTimeCardId {
	return UserIdJoinedTeamIdScheduleTimeCardId{
		UserId:     userId,
		TeamId:     teamId,
		TimeCardId: timeCardId,
	}
}
