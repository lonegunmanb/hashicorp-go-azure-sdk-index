func NewGroupIdDriveIdBundleID(groupId string, driveId string, driveItemId string) GroupIdDriveIdBundleId {
	return GroupIdDriveIdBundleId{
		GroupId:     groupId,
		DriveId:     driveId,
		DriveItemId: driveItemId,
	}
}
