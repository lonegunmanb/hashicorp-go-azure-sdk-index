func NewDomainIdDomainNameReferenceID(domainId string, directoryObjectId string) DomainIdDomainNameReferenceId {
	return DomainIdDomainNameReferenceId{
		DomainId:          domainId,
		DirectoryObjectId: directoryObjectId,
	}
}
