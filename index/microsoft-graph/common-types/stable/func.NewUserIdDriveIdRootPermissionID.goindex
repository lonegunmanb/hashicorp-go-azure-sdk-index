func NewUserIdDriveIdRootPermissionID(userId string, driveId string, permissionId string) UserIdDriveIdRootPermissionId {
	return UserIdDriveIdRootPermissionId{
		UserId:       userId,
		DriveId:      driveId,
		PermissionId: permissionId,
	}
}
