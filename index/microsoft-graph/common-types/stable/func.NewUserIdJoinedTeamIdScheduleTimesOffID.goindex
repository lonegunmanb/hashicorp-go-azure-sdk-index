func NewUserIdJoinedTeamIdScheduleTimesOffID(userId string, teamId string, timeOffId string) UserIdJoinedTeamIdScheduleTimesOffId {
	return UserIdJoinedTeamIdScheduleTimesOffId{
		UserId:    userId,
		TeamId:    teamId,
		TimeOffId: timeOffId,
	}
}
