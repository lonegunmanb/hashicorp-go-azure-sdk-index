func NewUserIdDriveIdListItemID(userId string, driveId string, listItemId string) UserIdDriveIdListItemId {
	return UserIdDriveIdListItemId{
		UserId:     userId,
		DriveId:    driveId,
		ListItemId: listItemId,
	}
}
