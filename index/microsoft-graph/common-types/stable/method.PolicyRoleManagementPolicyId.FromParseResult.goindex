func (id *PolicyRoleManagementPolicyId) FromParseResult(input resourceids.ParseResult) error {
	var ok bool

	if id.UnifiedRoleManagementPolicyId, ok = input.Parsed["unifiedRoleManagementPolicyId"]; !ok {
