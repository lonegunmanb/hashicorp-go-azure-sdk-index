func NewUserIdCloudClipboardItemID(userId string, cloudClipboardItemId string) UserIdCloudClipboardItemId {
	return UserIdCloudClipboardItemId{
		UserId:               userId,
		CloudClipboardItemId: cloudClipboardItemId,
	}
}
