func NewGroupIdTeamInstalledAppID(groupId string, teamsAppInstallationId string) GroupIdTeamInstalledAppId {
	return GroupIdTeamInstalledAppId{
		GroupId:                groupId,
		TeamsAppInstallationId: teamsAppInstallationId,
	}
}
