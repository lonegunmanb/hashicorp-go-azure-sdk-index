package github.com/hashicorp/go-azure-sdk/microsoft-graph/reports/beta/partnerbillingmanifest
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c PartnerBillingManifestClient) ListPartnerBillingManifestsCompleteMatchingPredicate(ctx context.Context, options ListPartnerBillingManifestsOperationOptions, predicate PartnersBillingManifestOperationPredicate) (result ListPartnerBillingManifestsCompleteResult, err error) {
	items := make([]beta.PartnersBillingManifest, 0)

	resp, err := c.ListPartnerBillingManifests(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListPartnerBillingManifestsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
