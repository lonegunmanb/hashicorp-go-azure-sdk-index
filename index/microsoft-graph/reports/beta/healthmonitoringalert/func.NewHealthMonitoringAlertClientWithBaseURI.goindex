import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewHealthMonitoringAlertClientWithBaseURI(sdkApi sdkEnv.Api) (*HealthMonitoringAlertClient, error) {
	client, err := msgraph.NewClient(sdkApi, "healthmonitoringalert", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating HealthMonitoringAlertClient: %+v", err)
	}

	return &HealthMonitoringAlertClient{
		Client: client,
	}, nil
}
