	items := make([]stable.UserExperienceAnalyticsAppHealthOSVersionPerformance, 0)

	resp, err := c.ListUserExperienceAnalyticsAppHealthOSVersionPerformances(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
