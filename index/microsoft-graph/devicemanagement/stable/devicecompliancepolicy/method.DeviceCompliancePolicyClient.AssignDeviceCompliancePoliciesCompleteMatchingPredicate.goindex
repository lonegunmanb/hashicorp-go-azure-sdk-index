package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/stable/devicecompliancepolicy
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceCompliancePolicyClient) AssignDeviceCompliancePoliciesCompleteMatchingPredicate(ctx context.Context, id stable.DeviceManagementDeviceCompliancePolicyId, input AssignDeviceCompliancePoliciesRequest, options AssignDeviceCompliancePoliciesOperationOptions, predicate DeviceCompliancePolicyAssignmentOperationPredicate) (result AssignDeviceCompliancePoliciesCompleteResult, err error) {
	items := make([]stable.DeviceCompliancePolicyAssignment, 0)

	resp, err := c.AssignDeviceCompliancePolicies(ctx, id, input, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = AssignDeviceCompliancePoliciesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
