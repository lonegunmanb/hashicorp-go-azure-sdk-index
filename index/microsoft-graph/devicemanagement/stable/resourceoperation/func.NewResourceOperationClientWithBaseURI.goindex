package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/stable/resourceoperation
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewResourceOperationClientWithBaseURI(sdkApi sdkEnv.Api) (*ResourceOperationClient, error) {
	client, err := msgraph.NewClient(sdkApi, "resourceoperation", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ResourceOperationClient: %+v", err)
	}

	return &ResourceOperationClient{
		Client: client,
	}, nil
}
