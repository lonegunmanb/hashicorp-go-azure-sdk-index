package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/stable/devicemanagementpartner
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceManagementPartnerClient) ListDeviceManagementPartnersCompleteMatchingPredicate(ctx context.Context, options ListDeviceManagementPartnersOperationOptions, predicate DeviceManagementPartnerOperationPredicate) (result ListDeviceManagementPartnersCompleteResult, err error) {
	items := make([]stable.DeviceManagementPartner, 0)

	resp, err := c.ListDeviceManagementPartners(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDeviceManagementPartnersCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
