package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/templatecategory
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TemplateCategoryClient) ListTemplateCategoriesCompleteMatchingPredicate(ctx context.Context, id beta.DeviceManagementTemplateId, options ListTemplateCategoriesOperationOptions, predicate DeviceManagementTemplateSettingCategoryOperationPredicate) (result ListTemplateCategoriesCompleteResult, err error) {
	items := make([]beta.DeviceManagementTemplateSettingCategory, 0)

	resp, err := c.ListTemplateCategories(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTemplateCategoriesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
