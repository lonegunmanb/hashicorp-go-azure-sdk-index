func NewConfigurationPolicyTemplateClientWithBaseURI(sdkApi sdkEnv.Api) (*ConfigurationPolicyTemplateClient, error) {
	client, err := msgraph.NewClient(sdkApi, "configurationpolicytemplate", defaultApiVersion)
