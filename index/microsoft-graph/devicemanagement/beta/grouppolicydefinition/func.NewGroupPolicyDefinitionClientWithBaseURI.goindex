func NewGroupPolicyDefinitionClientWithBaseURI(sdkApi sdkEnv.Api) (*GroupPolicyDefinitionClient, error) {
	client, err := msgraph.NewClient(sdkApi, "grouppolicydefinition", defaultApiVersion)
