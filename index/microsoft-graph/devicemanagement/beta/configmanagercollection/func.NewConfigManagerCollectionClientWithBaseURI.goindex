import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewConfigManagerCollectionClientWithBaseURI(sdkApi sdkEnv.Api) (*ConfigManagerCollectionClient, error) {
	client, err := msgraph.NewClient(sdkApi, "configmanagercollection", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ConfigManagerCollectionClient: %+v", err)
	}

	return &ConfigManagerCollectionClient{
		Client: client,
	}, nil
}
