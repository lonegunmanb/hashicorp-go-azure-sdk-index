package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/hardwareconfigurationuserrunstate
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c HardwareConfigurationUserRunStateClient) ListHardwareConfigurationUserRunStatesCompleteMatchingPredicate(ctx context.Context, id beta.DeviceManagementHardwareConfigurationId, options ListHardwareConfigurationUserRunStatesOperationOptions, predicate HardwareConfigurationUserStateOperationPredicate) (result ListHardwareConfigurationUserRunStatesCompleteResult, err error) {
	items := make([]beta.HardwareConfigurationUserState, 0)

	resp, err := c.ListHardwareConfigurationUserRunStates(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListHardwareConfigurationUserRunStatesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
