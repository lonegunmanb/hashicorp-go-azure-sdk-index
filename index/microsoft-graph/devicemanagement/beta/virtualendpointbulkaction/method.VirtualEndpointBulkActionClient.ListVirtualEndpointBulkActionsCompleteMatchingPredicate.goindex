package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/virtualendpointbulkaction
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c VirtualEndpointBulkActionClient) ListVirtualEndpointBulkActionsCompleteMatchingPredicate(ctx context.Context, options ListVirtualEndpointBulkActionsOperationOptions, predicate CloudPCBulkActionOperationPredicate) (result ListVirtualEndpointBulkActionsCompleteResult, err error) {
	items := make([]beta.CloudPCBulkAction, 0)

	resp, err := c.ListVirtualEndpointBulkActions(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListVirtualEndpointBulkActionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
