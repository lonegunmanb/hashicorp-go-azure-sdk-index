package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/templatesettingsettingdefinition
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TemplateSettingSettingDefinitionClient) ListTemplateSettingDefinitionsCompleteMatchingPredicate(ctx context.Context, id beta.DeviceManagementTemplateSettingId, options ListTemplateSettingDefinitionsOperationOptions, predicate DeviceManagementConfigurationSettingDefinitionOperationPredicate) (result ListTemplateSettingDefinitionsCompleteResult, err error) {
	items := make([]beta.DeviceManagementConfigurationSettingDefinition, 0)

	resp, err := c.ListTemplateSettingDefinitions(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTemplateSettingDefinitionsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
