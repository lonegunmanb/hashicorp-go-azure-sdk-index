func NewHardwarePasswordDetailClientWithBaseURI(sdkApi sdkEnv.Api) (*HardwarePasswordDetailClient, error) {
	client, err := msgraph.NewClient(sdkApi, "hardwarepassworddetail", defaultApiVersion)
