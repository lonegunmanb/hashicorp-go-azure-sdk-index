func NewDeviceComplianceScriptClientWithBaseURI(sdkApi sdkEnv.Api) (*DeviceComplianceScriptClient, error) {
	client, err := msgraph.NewClient(sdkApi, "devicecompliancescript", defaultApiVersion)
	if err != nil {
