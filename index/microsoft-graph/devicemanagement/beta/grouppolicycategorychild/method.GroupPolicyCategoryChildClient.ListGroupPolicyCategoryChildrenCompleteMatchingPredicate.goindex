package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/grouppolicycategorychild
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c GroupPolicyCategoryChildClient) ListGroupPolicyCategoryChildrenCompleteMatchingPredicate(ctx context.Context, id beta.DeviceManagementGroupPolicyCategoryId, options ListGroupPolicyCategoryChildrenOperationOptions, predicate GroupPolicyCategoryOperationPredicate) (result ListGroupPolicyCategoryChildrenCompleteResult, err error) {
	items := make([]beta.GroupPolicyCategory, 0)

	resp, err := c.ListGroupPolicyCategoryChildren(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListGroupPolicyCategoryChildrenCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
