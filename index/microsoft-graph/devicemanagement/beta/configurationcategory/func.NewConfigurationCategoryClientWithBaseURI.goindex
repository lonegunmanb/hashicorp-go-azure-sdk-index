	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewConfigurationCategoryClientWithBaseURI(sdkApi sdkEnv.Api) (*ConfigurationCategoryClient, error) {
	client, err := msgraph.NewClient(sdkApi, "configurationcategory", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ConfigurationCategoryClient: %+v", err)
	}

	return &ConfigurationCategoryClient{
		Client: client,
	}, nil
}
