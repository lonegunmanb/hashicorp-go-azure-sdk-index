import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewApplePushNotificationCertificateClientWithBaseURI(sdkApi sdkEnv.Api) (*ApplePushNotificationCertificateClient, error) {
	client, err := msgraph.NewClient(sdkApi, "applepushnotificationcertificate", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ApplePushNotificationCertificateClient: %+v", err)
	}

	return &ApplePushNotificationCertificateClient{
		Client: client,
	}, nil
}
