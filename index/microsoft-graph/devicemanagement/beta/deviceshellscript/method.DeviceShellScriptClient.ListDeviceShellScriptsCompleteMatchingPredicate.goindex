package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/deviceshellscript
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c DeviceShellScriptClient) ListDeviceShellScriptsCompleteMatchingPredicate(ctx context.Context, options ListDeviceShellScriptsOperationOptions, predicate DeviceShellScriptOperationPredicate) (result ListDeviceShellScriptsCompleteResult, err error) {
	items := make([]beta.DeviceShellScript, 0)

	resp, err := c.ListDeviceShellScripts(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListDeviceShellScriptsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
