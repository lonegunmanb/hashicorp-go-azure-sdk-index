package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/userpfxcertificate
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewUserPfxCertificateClientWithBaseURI(sdkApi sdkEnv.Api) (*UserPfxCertificateClient, error) {
	client, err := msgraph.NewClient(sdkApi, "userpfxcertificate", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating UserPfxCertificateClient: %+v", err)
	}

	return &UserPfxCertificateClient{
		Client: client,
	}, nil
}
