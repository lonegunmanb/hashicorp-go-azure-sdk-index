func NewHardwarePasswordInfoClientWithBaseURI(sdkApi sdkEnv.Api) (*HardwarePasswordInfoClient, error) {
	client, err := msgraph.NewClient(sdkApi, "hardwarepasswordinfo", defaultApiVersion)
