package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/roledefinitionroleassignment
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c RoleDefinitionRoleAssignmentClient) ListRoleDefinitionRoleAssignmentsCompleteMatchingPredicate(ctx context.Context, id beta.DeviceManagementRoleDefinitionId, options ListRoleDefinitionRoleAssignmentsOperationOptions, predicate RoleAssignmentOperationPredicate) (result ListRoleDefinitionRoleAssignmentsCompleteResult, err error) {
	items := make([]beta.RoleAssignment, 0)

	resp, err := c.ListRoleDefinitionRoleAssignments(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListRoleDefinitionRoleAssignmentsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
