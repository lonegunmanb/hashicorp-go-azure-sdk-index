func (c DeviceConfigurationClient) AssignDeviceConfigurationsComplete(ctx context.Context, id beta.DeviceManagementDeviceConfigurationId, input AssignDeviceConfigurationsRequest, options AssignDeviceConfigurationsOperationOptions) (AssignDeviceConfigurationsCompleteResult, error) {
