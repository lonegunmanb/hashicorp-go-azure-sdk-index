package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/template
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TemplateClient) ListTemplateImportOffice365DeviceConfigurationPoliciesCompleteMatchingPredicate(ctx context.Context, options ListTemplateImportOffice365DeviceConfigurationPoliciesOperationOptions, predicate DeviceManagementIntentOperationPredicate) (result ListTemplateImportOffice365DeviceConfigurationPoliciesCompleteResult, err error) {
	items := make([]beta.DeviceManagementIntent, 0)

	resp, err := c.ListTemplateImportOffice365DeviceConfigurationPolicies(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListTemplateImportOffice365DeviceConfigurationPoliciesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
