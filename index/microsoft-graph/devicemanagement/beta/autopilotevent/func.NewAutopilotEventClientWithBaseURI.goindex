package github.com/hashicorp/go-azure-sdk/microsoft-graph/devicemanagement/beta/autopilotevent
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewAutopilotEventClientWithBaseURI(sdkApi sdkEnv.Api) (*AutopilotEventClient, error) {
	client, err := msgraph.NewClient(sdkApi, "autopilotevent", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating AutopilotEventClient: %+v", err)
	}

	return &AutopilotEventClient{
		Client: client,
	}, nil
}
