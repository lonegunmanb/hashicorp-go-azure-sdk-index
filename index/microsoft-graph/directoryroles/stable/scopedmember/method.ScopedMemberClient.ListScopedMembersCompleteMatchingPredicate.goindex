package github.com/hashicorp/go-azure-sdk/microsoft-graph/directoryroles/stable/scopedmember
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ScopedMemberClient) ListScopedMembersCompleteMatchingPredicate(ctx context.Context, id stable.DirectoryRoleId, options ListScopedMembersOperationOptions, predicate ScopedRoleMembershipOperationPredicate) (result ListScopedMembersCompleteResult, err error) {
	items := make([]stable.ScopedRoleMembership, 0)

	resp, err := c.ListScopedMembers(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListScopedMembersCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
