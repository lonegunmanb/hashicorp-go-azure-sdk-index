package github.com/hashicorp/go-azure-sdk/microsoft-graph/directoryroles/stable/scopedmember
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
