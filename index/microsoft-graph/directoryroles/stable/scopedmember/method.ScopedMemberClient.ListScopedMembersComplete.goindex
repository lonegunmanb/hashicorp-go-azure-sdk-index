func (c ScopedMemberClient) ListScopedMembersComplete(ctx context.Context, id stable.DirectoryRoleId, options ListScopedMembersOperationOptions) (ListScopedMembersCompleteResult, error) {
	return c.ListScopedMembersCompleteMatchingPredicate(ctx, id, options, ScopedRoleMembershipOperationPredicate{})
}
