package github.com/hashicorp/go-azure-sdk/microsoft-graph/directory/beta/administrativeunitmember
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c AdministrativeUnitMemberClient) ListAdministrativeUnitMemberApplicationsCompleteMatchingPredicate(ctx context.Context, id beta.DirectoryAdministrativeUnitId, options ListAdministrativeUnitMemberApplicationsOperationOptions, predicate ApplicationOperationPredicate) (result ListAdministrativeUnitMemberApplicationsCompleteResult, err error) {
	items := make([]beta.Application, 0)

	resp, err := c.ListAdministrativeUnitMemberApplications(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListAdministrativeUnitMemberApplicationsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
