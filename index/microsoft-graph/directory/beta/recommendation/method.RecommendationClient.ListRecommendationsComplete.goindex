package github.com/hashicorp/go-azure-sdk/microsoft-graph/directory/beta/recommendation
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c RecommendationClient) ListRecommendationsComplete(ctx context.Context, options ListRecommendationsOperationOptions) (ListRecommendationsCompleteResult, error) {
	return c.ListRecommendationsCompleteMatchingPredicate(ctx, options, RecommendationOperationPredicate{})
}
