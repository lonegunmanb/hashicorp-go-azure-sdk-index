package github.com/hashicorp/go-azure-sdk/microsoft-graph/directory/beta/recommendation
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/msgraph"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewRecommendationClientWithBaseURI(sdkApi sdkEnv.Api) (*RecommendationClient, error) {
	client, err := msgraph.NewClient(sdkApi, "recommendation", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating RecommendationClient: %+v", err)
	}

	return &RecommendationClient{
		Client: client,
	}, nil
}
