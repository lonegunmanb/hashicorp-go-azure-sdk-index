func (c CertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthorityClient) ListCertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthoritiesCompleteMatchingPredicate(ctx context.Context, id beta.DirectoryCertificateAuthorityCertificateBasedApplicationConfigurationId, options ListCertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthoritiesOperationOptions, predicate CertificateAuthorityAsEntityOperationPredicate) (result ListCertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthoritiesCompleteResult, err error) {
	items := make([]beta.CertificateAuthorityAsEntity, 0)

	resp, err := c.ListCertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthorities(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListCertificateAuthorityCertificateBasedApplicationConfigurationTrustedCertificateAuthoritiesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
