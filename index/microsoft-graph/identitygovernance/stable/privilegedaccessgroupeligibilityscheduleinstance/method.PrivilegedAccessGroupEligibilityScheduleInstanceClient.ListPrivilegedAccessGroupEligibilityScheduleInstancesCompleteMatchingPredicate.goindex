	items := make([]stable.PrivilegedAccessGroupEligibilityScheduleInstance, 0)

	resp, err := c.ListPrivilegedAccessGroupEligibilityScheduleInstances(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
