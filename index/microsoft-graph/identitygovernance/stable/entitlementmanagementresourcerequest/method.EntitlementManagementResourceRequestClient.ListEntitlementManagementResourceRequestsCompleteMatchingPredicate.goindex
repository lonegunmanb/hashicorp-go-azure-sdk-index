package github.com/hashicorp/go-azure-sdk/microsoft-graph/identitygovernance/stable/entitlementmanagementresourcerequest
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/stable"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EntitlementManagementResourceRequestClient) ListEntitlementManagementResourceRequestsCompleteMatchingPredicate(ctx context.Context, options ListEntitlementManagementResourceRequestsOperationOptions, predicate AccessPackageResourceRequestOperationPredicate) (result ListEntitlementManagementResourceRequestsCompleteResult, err error) {
	items := make([]stable.AccessPackageResourceRequest, 0)

	resp, err := c.ListEntitlementManagementResourceRequests(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListEntitlementManagementResourceRequestsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
