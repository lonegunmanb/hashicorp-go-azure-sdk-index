package github.com/hashicorp/go-azure-sdk/microsoft-graph/identitygovernance/beta/entitlementmanagementaccesspackagecatalogaccesspackage
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c EntitlementManagementAccessPackageCatalogAccessPackageClient) ListEntitlementManagementAccessPackageCatalogAccessPackagesCompleteMatchingPredicate(ctx context.Context, id beta.IdentityGovernanceEntitlementManagementAccessPackageCatalogId, options ListEntitlementManagementAccessPackageCatalogAccessPackagesOperationOptions, predicate AccessPackageOperationPredicate) (result ListEntitlementManagementAccessPackageCatalogAccessPackagesCompleteResult, err error) {
	items := make([]beta.AccessPackage, 0)

	resp, err := c.ListEntitlementManagementAccessPackageCatalogAccessPackages(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListEntitlementManagementAccessPackageCatalogAccessPackagesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
