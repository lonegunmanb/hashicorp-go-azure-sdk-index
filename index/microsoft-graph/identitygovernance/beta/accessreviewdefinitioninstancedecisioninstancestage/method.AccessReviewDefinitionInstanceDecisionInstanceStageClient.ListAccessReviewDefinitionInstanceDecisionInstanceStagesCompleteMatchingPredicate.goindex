func (c AccessReviewDefinitionInstanceDecisionInstanceStageClient) ListAccessReviewDefinitionInstanceDecisionInstanceStagesCompleteMatchingPredicate(ctx context.Context, id beta.IdentityGovernanceAccessReviewDefinitionIdInstanceIdDecisionId, options ListAccessReviewDefinitionInstanceDecisionInstanceStagesOperationOptions, predicate AccessReviewStageOperationPredicate) (result ListAccessReviewDefinitionInstanceDecisionInstanceStagesCompleteResult, err error) {
	items := make([]beta.AccessReviewStage, 0)

	resp, err := c.ListAccessReviewDefinitionInstanceDecisionInstanceStages(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListAccessReviewDefinitionInstanceDecisionInstanceStagesCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
