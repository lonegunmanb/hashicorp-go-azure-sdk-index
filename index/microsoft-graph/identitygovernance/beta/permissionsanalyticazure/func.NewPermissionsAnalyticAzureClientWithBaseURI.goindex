func NewPermissionsAnalyticAzureClientWithBaseURI(sdkApi sdkEnv.Api) (*PermissionsAnalyticAzureClient, error) {
	client, err := msgraph.NewClient(sdkApi, "permissionsanalyticazure", defaultApiVersion)
