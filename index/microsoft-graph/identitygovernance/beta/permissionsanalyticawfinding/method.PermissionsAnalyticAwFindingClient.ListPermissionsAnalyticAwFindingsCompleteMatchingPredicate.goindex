package github.com/hashicorp/go-azure-sdk/microsoft-graph/identitygovernance/beta/permissionsanalyticawfinding
import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/microsoft-graph/common-types/beta"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c PermissionsAnalyticAwFindingClient) ListPermissionsAnalyticAwFindingsCompleteMatchingPredicate(ctx context.Context, options ListPermissionsAnalyticAwFindingsOperationOptions, predicate FindingOperationPredicate) (result ListPermissionsAnalyticAwFindingsCompleteResult, err error) {
	items := make([]beta.Finding, 0)

	resp, err := c.ListPermissionsAnalyticAwFindings(ctx, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListPermissionsAnalyticAwFindingsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
