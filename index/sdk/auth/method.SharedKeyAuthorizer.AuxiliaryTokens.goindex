func (s *SharedKeyAuthorizer) AuxiliaryTokens(_ context.Context, _ *http.Request) ([]*oauth2.Token, error) {
	// Auxiliary tokens are not supported with SharedKey authentication
	return []*oauth2.Token{}, nil
}
