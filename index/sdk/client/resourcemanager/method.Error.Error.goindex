package github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager
import (
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
)
func (e Error) Error() string {
	return fmt.Sprintf(`the Azure API returned the following error:

Status: %q
Code: %q
Message: %q
Activity Id: %q

---

API Response:

----[start]----
%s
-----[end]-----
`, e.Status, e.Code, e.Message, e.ActivityId, e.FullHttpBody)
}
