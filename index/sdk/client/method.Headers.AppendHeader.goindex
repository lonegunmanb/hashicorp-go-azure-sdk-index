package github.com/hashicorp/go-azure-sdk/sdk/client
import (
	"net/http"
	"net/url"

	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (h *Headers) AppendHeader(h2 http.Header) {
	if h.vals == nil {
		h.vals = map[string]string{}
	}
	for k, v := range h2 {
		if len(v) > 0 {
			h.vals[k] = v[0]
		}
	}
}
