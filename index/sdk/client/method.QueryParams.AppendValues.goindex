package github.com/hashicorp/go-azure-sdk/sdk/client
import (
	"net/http"
	"net/url"

	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (q *QueryParams) AppendValues(q2 url.Values) {
	if q.vals == nil {
		q.vals = map[string]string{}
	}
	for k, v := range q2 {
		if len(v) > 0 {
			q.vals[k] = v[0]
		}
	}
}
