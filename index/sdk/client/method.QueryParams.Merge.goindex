package github.com/hashicorp/go-azure-sdk/sdk/client
import (
	"net/http"
	"net/url"

	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (q *QueryParams) Merge(q2 Headers) {
	if q.vals == nil {
		q.vals = map[string]string{}
	}
	if q2.vals == nil {
		return
	}
	for k, v := range q2.vals {
		q.vals[k] = v
	}
}
