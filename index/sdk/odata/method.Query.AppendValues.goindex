package github.com/hashicorp/go-azure-sdk/sdk/odata
import (
	"fmt"
	"net/http"
	"net/url"
	"strconv"
	"strings"
)
func (q Query) AppendValues(values url.Values) url.Values {
	if values == nil {
		values = url.Values{}
	}
	for k, v := range q.Values() {
		if len(v) > 0 {
			values.Set(k, v[0])
		}
	}
	return values
}
