package github.com/hashicorp/go-azure-sdk/sdk/odata
import (
	"fmt"
	"net/http"
	"net/url"
	"strconv"
	"strings"
)
func (q Query) AppendHeaders(header http.Header) http.Header {
	if header == nil {
		header = http.Header{}
	}
	for k, v := range q.Headers() {
		if len(v) > 0 {
			header.Set(k, v[0])
		}
	}
	return header
}
