package github.com/hashicorp/go-azure-sdk/sdk/internal/test
import (
	"bytes"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"regexp"

	"github.com/hashicorp/go-azure-sdk/sdk/environments"
