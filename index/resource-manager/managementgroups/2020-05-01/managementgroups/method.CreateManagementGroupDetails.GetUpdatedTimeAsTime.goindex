package github.com/hashicorp/go-azure-sdk/resource-manager/managementgroups/2020-05-01/managementgroups
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *CreateManagementGroupDetails) GetUpdatedTimeAsTime() (*time.Time, error) {
	if o.UpdatedTime == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.UpdatedTime, "2006-01-02T15:04:05Z07:00")
}
