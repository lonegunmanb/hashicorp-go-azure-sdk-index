func PossibleValuesForStatus() []string {
	return []string{
		string(StatusCancelled),
		string(StatusCompleted),
		string(StatusFailed),
		string(StatusNotStarted),
		string(StatusNotStartedButGroupsExist),
		string(StatusStarted),
	}
}
