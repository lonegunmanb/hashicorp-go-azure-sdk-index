package github.com/hashicorp/go-azure-sdk/resource-manager/hybridazurekubernetesservice/2024-01-01/provisionedclusterinstances
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ProvisionedClusterInstancesClient) ProvisionedClusterInstancesListCompleteMatchingPredicate(ctx context.Context, id commonids.ScopeId, predicate ProvisionedClusterOperationPredicate) (result ProvisionedClusterInstancesListCompleteResult, err error) {
	items := make([]ProvisionedCluster, 0)

	resp, err := c.ProvisionedClusterInstancesList(ctx, id)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ProvisionedClusterInstancesListCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
