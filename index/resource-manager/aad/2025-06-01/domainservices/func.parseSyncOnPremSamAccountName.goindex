package github.com/hashicorp/go-azure-sdk/resource-manager/aad/2025-06-01/domainservices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSyncOnPremSamAccountName(input string) (*SyncOnPremSamAccountName, error) {
	vals := map[string]SyncOnPremSamAccountName{
		"disabled": SyncOnPremSamAccountNameDisabled,
		"enabled":  SyncOnPremSamAccountNameEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SyncOnPremSamAccountName(input)
	return &out, nil
}
