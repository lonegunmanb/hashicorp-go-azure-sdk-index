package github.com/hashicorp/go-azure-sdk/resource-manager/aad/2025-06-01/domainservices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSyncScope(input string) (*SyncScope, error) {
	vals := map[string]SyncScope{
		"all":       SyncScopeAll,
		"cloudonly": SyncScopeCloudOnly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SyncScope(input)
	return &out, nil
}
