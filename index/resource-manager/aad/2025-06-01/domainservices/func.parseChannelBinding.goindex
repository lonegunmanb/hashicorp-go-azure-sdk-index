package github.com/hashicorp/go-azure-sdk/resource-manager/aad/2025-06-01/domainservices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseChannelBinding(input string) (*ChannelBinding, error) {
	vals := map[string]ChannelBinding{
		"disabled": ChannelBindingDisabled,
		"enabled":  ChannelBindingEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ChannelBinding(input)
	return &out, nil
}
