package github.com/hashicorp/go-azure-sdk/resource-manager/aad/2025-06-01/domainservices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLdapSigning(input string) (*LdapSigning, error) {
	vals := map[string]LdapSigning{
		"disabled": LdapSigningDisabled,
		"enabled":  LdapSigningEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LdapSigning(input)
	return &out, nil
}
