package github.com/hashicorp/go-azure-sdk/resource-manager/servicefabric/2021-06-01/application
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ApplicationClient) ListComplete(ctx context.Context, id ClusterId) (ListCompleteResult, error) {
	return c.ListCompleteMatchingPredicate(ctx, id, ApplicationResourceOperationPredicate{})
}
