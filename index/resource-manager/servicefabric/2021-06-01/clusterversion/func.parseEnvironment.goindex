package github.com/hashicorp/go-azure-sdk/resource-manager/servicefabric/2021-06-01/clusterversion
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseEnvironment(input string) (*Environment, error) {
	vals := map[string]Environment{
		"linux":   EnvironmentLinux,
		"windows": EnvironmentWindows,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Environment(input)
	return &out, nil
}
