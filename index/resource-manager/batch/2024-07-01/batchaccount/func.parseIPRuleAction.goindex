package github.com/hashicorp/go-azure-sdk/resource-manager/batch/2024-07-01/batchaccount
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIPRuleAction(input string) (*IPRuleAction, error) {
	vals := map[string]IPRuleAction{
		"allow": IPRuleActionAllow,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IPRuleAction(input)
	return &out, nil
}
