package github.com/hashicorp/go-azure-sdk/resource-manager/redis/2024-03-01/redis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuFamily(input string) (*SkuFamily, error) {
	vals := map[string]SkuFamily{
		"c": SkuFamilyC,
		"p": SkuFamilyP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuFamily(input)
	return &out, nil
}
