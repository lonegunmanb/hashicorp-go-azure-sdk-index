func PossibleValuesForFeatureFlags() []string {
	return []string{
		string(FeatureFlagsEnableConnectivityLogs),
		string(FeatureFlagsEnableLiveTrace),
		string(FeatureFlagsEnableMessagingLogs),
		string(FeatureFlagsServiceMode),
	}
}
