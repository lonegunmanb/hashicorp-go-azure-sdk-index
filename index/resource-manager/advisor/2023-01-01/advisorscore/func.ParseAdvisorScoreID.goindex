package github.com/hashicorp/go-azure-sdk/resource-manager/advisor/2023-01-01/advisorscore
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseAdvisorScoreID(input string) (*AdvisorScoreId, error) {
	parser := resourceids.NewParserFromResourceIdType(&AdvisorScoreId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := AdvisorScoreId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
