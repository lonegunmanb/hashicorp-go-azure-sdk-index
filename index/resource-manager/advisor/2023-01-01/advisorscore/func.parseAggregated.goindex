package github.com/hashicorp/go-azure-sdk/resource-manager/advisor/2023-01-01/advisorscore
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAggregated(input string) (*Aggregated, error) {
	vals := map[string]Aggregated{
		"day":   AggregatedDay,
		"month": AggregatedMonth,
		"week":  AggregatedWeek,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Aggregated(input)
	return &out, nil
}
