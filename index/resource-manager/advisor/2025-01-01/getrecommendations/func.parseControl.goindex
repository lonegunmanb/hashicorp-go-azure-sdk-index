package github.com/hashicorp/go-azure-sdk/resource-manager/advisor/2025-01-01/getrecommendations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseControl(input string) (*Control, error) {
	vals := map[string]Control{
		"businesscontinuity":          ControlBusinessContinuity,
		"disasterrecovery":            ControlDisasterRecovery,
		"highavailability":            ControlHighAvailability,
		"monitoringandalerting":       ControlMonitoringAndAlerting,
		"other":                       ControlOther,
		"personalized":                ControlPersonalized,
		"prioritizedrecommendations":  ControlPrioritizedRecommendations,
		"scalability":                 ControlScalability,
		"serviceupgradeandretirement": ControlServiceUpgradeAndRetirement,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Control(input)
	return &out, nil
}
