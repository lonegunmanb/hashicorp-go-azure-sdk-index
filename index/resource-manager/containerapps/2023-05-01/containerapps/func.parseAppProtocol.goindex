package github.com/hashicorp/go-azure-sdk/resource-manager/containerapps/2023-05-01/containerapps
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAppProtocol(input string) (*AppProtocol, error) {
	vals := map[string]AppProtocol{
		"grpc": AppProtocolGrpc,
		"http": AppProtocolHTTP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AppProtocol(input)
	return &out, nil
}
