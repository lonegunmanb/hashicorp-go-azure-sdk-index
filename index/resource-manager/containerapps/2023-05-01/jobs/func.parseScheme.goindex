package github.com/hashicorp/go-azure-sdk/resource-manager/containerapps/2023-05-01/jobs
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScheme(input string) (*Scheme, error) {
	vals := map[string]Scheme{
		"http":  SchemeHTTP,
		"https": SchemeHTTPS,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Scheme(input)
	return &out, nil
}
