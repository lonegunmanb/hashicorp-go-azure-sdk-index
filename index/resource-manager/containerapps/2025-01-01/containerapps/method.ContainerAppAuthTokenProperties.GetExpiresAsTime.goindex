package github.com/hashicorp/go-azure-sdk/resource-manager/containerapps/2025-01-01/containerapps
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ContainerAppAuthTokenProperties) GetExpiresAsTime() (*time.Time, error) {
	if o.Expires == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Expires, "2006-01-02T15:04:05Z07:00")
}
