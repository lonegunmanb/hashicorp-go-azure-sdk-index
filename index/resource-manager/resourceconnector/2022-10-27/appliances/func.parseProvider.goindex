package github.com/hashicorp/go-azure-sdk/resource-manager/resourceconnector/2022-10-27/appliances
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseProvider(input string) (*Provider, error) {
	vals := map[string]Provider{
		"hci":    ProviderHCI,
		"scvmm":  ProviderSCVMM,
		"vmware": ProviderVMWare,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Provider(input)
	return &out, nil
}
