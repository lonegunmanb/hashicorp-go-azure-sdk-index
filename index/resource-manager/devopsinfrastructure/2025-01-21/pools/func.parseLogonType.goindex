package github.com/hashicorp/go-azure-sdk/resource-manager/devopsinfrastructure/2025-01-21/pools
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLogonType(input string) (*LogonType, error) {
	vals := map[string]LogonType{
		"interactive": LogonTypeInteractive,
		"service":     LogonTypeService,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LogonType(input)
	return &out, nil
}
