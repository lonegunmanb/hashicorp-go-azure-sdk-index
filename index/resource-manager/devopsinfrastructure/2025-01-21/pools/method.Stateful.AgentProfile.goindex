func (s Stateful) AgentProfile() BaseAgentProfileImpl {
	return BaseAgentProfileImpl{
		Kind:                       s.Kind,
		ResourcePredictions:        s.ResourcePredictions,
		ResourcePredictionsProfile: s.ResourcePredictionsProfile,
	}
}
