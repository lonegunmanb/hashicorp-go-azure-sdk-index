import (
	"encoding/json"
	"fmt"
)
type PoolProperties struct {
	AgentProfile               AgentProfile        `json:"agentProfile"`
	DevCenterProjectResourceId string              `json:"devCenterProjectResourceId"`
	FabricProfile              FabricProfile       `json:"fabricProfile"`
