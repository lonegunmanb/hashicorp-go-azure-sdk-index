package github.com/hashicorp/go-azure-sdk/resource-manager/powerbidedicated/2021-01-01/autoscalevcores
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVCoreSkuTier(input string) (*VCoreSkuTier, error) {
	vals := map[string]VCoreSkuTier{
		"autoscale": VCoreSkuTierAutoScale,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VCoreSkuTier(input)
	return &out, nil
}
