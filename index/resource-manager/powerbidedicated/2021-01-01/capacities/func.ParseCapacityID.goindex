package github.com/hashicorp/go-azure-sdk/resource-manager/powerbidedicated/2021-01-01/capacities
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCapacityID(input string) (*CapacityId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CapacityId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CapacityId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
