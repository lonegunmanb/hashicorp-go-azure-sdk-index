package github.com/hashicorp/go-azure-sdk/resource-manager/healthcareapis/2024-03-31/fhirservices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSmartDataActions(input string) (*SmartDataActions, error) {
	vals := map[string]SmartDataActions{
		"read": SmartDataActionsRead,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SmartDataActions(input)
	return &out, nil
}
