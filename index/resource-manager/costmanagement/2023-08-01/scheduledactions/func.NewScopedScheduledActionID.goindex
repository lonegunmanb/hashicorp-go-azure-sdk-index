package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/scheduledactions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScopedScheduledActionID(scope string, scheduledActionName string) ScopedScheduledActionId {
	return ScopedScheduledActionId{
		Scope:               scope,
		ScheduledActionName: scheduledActionName,
	}
}
