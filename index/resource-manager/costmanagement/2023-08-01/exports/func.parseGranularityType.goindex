package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/exports
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGranularityType(input string) (*GranularityType, error) {
	vals := map[string]GranularityType{
		"daily": GranularityTypeDaily,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := GranularityType(input)
	return &out, nil
}
