package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/exports
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStatusType(input string) (*StatusType, error) {
	vals := map[string]StatusType{
		"active":   StatusTypeActive,
		"inactive": StatusTypeInactive,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := StatusType(input)
	return &out, nil
}
