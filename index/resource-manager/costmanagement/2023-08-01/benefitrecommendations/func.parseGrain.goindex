package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/benefitrecommendations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGrain(input string) (*Grain, error) {
	vals := map[string]Grain{
		"daily":   GrainDaily,
		"hourly":  GrainHourly,
		"monthly": GrainMonthly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Grain(input)
	return &out, nil
}
