func NewReservedInstancesClientWithBaseURI(sdkApi sdkEnv.Api) (*ReservedInstancesClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "reservedinstances", defaultApiVersion)
	if err != nil {
