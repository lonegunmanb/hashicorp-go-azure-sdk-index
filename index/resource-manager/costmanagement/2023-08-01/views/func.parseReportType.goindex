package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/views
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseReportType(input string) (*ReportType, error) {
	vals := map[string]ReportType{
		"usage": ReportTypeUsage,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ReportType(input)
	return &out, nil
}
