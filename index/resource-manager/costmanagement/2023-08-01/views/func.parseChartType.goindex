package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2023-08-01/views
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseChartType(input string) (*ChartType, error) {
	vals := map[string]ChartType{
		"area":          ChartTypeArea,
		"groupedcolumn": ChartTypeGroupedColumn,
		"line":          ChartTypeLine,
		"stackedcolumn": ChartTypeStackedColumn,
		"table":         ChartTypeTable,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ChartType(input)
	return &out, nil
}
