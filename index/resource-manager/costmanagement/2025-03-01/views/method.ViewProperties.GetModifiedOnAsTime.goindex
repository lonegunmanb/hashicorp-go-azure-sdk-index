package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/views
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ViewProperties) GetModifiedOnAsTime() (*time.Time, error) {
	if o.ModifiedOn == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ModifiedOn, "2006-01-02T15:04:05Z07:00")
}
