func NewSavingsPlanID(savingsPlanOrderId string, savingsPlanId string) SavingsPlanId {
	return SavingsPlanId{
		SavingsPlanOrderId: savingsPlanOrderId,
		SavingsPlanId:      savingsPlanId,
	}
}
