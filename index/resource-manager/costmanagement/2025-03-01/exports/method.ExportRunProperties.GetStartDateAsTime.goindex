package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/exports
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ExportRunProperties) GetStartDateAsTime() (*time.Time, error) {
	if o.StartDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StartDate, "2006-01-02T15:04:05Z07:00")
}
