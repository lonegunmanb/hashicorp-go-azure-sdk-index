package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/reservedinstances
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ReportURL) GetValidUntilAsTime() (*time.Time, error) {
	if o.ValidUntil == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ValidUntil, "2006-01-02T15:04:05Z07:00")
}
