package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/budgets
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id ScopedBudgetId) ID() string {
	fmtString := "/%s/providers/Microsoft.CostManagement/budgets/%s"
	return fmt.Sprintf(fmtString, strings.TrimPrefix(id.Scope, "/"), id.BudgetName)
}
