package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/alerts
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id ScopedAlertId) ID() string {
	fmtString := "/%s/providers/Microsoft.CostManagement/alerts/%s"
	return fmt.Sprintf(fmtString, strings.TrimPrefix(id.Scope, "/"), id.AlertId)
}
