package github.com/hashicorp/go-azure-sdk/resource-manager/costmanagement/2025-03-01/alerts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAlertSource(input string) (*AlertSource, error) {
	vals := map[string]AlertSource{
		"preset": AlertSourcePreset,
		"user":   AlertSourceUser,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AlertSource(input)
	return &out, nil
}
