package github.com/hashicorp/go-azure-sdk/resource-manager/storagepool/2021-08-01/diskpools
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewDiskPoolID(subscriptionId string, resourceGroupName string, diskPoolName string) DiskPoolId {
	return DiskPoolId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		DiskPoolName:      diskPoolName,
	}
}
