package github.com/hashicorp/go-azure-sdk/resource-manager/alertsmanagement/2021-08-08/alertprocessingrules
import (
	"encoding/json"
	"fmt"
)
func (s DailyRecurrence) Recurrence() BaseRecurrenceImpl {
	return BaseRecurrenceImpl{
		EndTime:        s.EndTime,
		RecurrenceType: s.RecurrenceType,
		StartTime:      s.StartTime,
	}
}
