package github.com/hashicorp/go-azure-sdk/resource-manager/automanage/2022-05-04/bestpractices
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseBestPracticeID(input string) (*BestPracticeId, error) {
	parser := resourceids.NewParserFromResourceIdType(&BestPracticeId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := BestPracticeId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
