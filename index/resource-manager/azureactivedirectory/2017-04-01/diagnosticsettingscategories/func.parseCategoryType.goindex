package github.com/hashicorp/go-azure-sdk/resource-manager/azureactivedirectory/2017-04-01/diagnosticsettingscategories
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCategoryType(input string) (*CategoryType, error) {
	vals := map[string]CategoryType{
		"logs": CategoryTypeLogs,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CategoryType(input)
	return &out, nil
}
