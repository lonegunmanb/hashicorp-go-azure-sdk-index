package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2015-05-01/componentsapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseFlowType(input string) (*FlowType, error) {
	vals := map[string]FlowType{
		"bluefield": FlowTypeBluefield,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := FlowType(input)
	return &out, nil
}
