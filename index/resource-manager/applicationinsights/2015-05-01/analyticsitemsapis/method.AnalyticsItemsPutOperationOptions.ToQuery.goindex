package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2015-05-01/analyticsitemsapis
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o AnalyticsItemsPutOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.OverrideItem != nil {
		out.Append("overrideItem", fmt.Sprintf("%v", *o.OverrideItem))
	}
	return &out
}
