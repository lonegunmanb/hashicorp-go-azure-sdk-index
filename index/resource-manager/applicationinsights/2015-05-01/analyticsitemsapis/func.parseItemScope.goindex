package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2015-05-01/analyticsitemsapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseItemScope(input string) (*ItemScope, error) {
	vals := map[string]ItemScope{
		"shared": ItemScopeShared,
		"user":   ItemScopeUser,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ItemScope(input)
	return &out, nil
}
