package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2015-05-01/webtestsapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseWebTestKind(input string) (*WebTestKind, error) {
	vals := map[string]WebTestKind{
		"multistep": WebTestKindMultistep,
		"ping":      WebTestKindPing,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := WebTestKind(input)
	return &out, nil
}
