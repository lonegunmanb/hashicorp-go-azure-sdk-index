package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2015-05-01/componentannotationsapis
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o AnnotationsListOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.End != nil {
		out.Append("end", fmt.Sprintf("%v", *o.End))
	}
	if o.Start != nil {
		out.Append("start", fmt.Sprintf("%v", *o.Start))
	}
	return &out
}
