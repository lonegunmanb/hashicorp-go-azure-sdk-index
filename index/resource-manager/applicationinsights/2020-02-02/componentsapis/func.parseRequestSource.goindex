package github.com/hashicorp/go-azure-sdk/resource-manager/applicationinsights/2020-02-02/componentsapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRequestSource(input string) (*RequestSource, error) {
	vals := map[string]RequestSource{
		"rest": RequestSourceRest,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RequestSource(input)
	return &out, nil
}
