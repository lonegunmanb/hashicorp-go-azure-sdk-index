package github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/clusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVnetState(input string) (*VnetState, error) {
	vals := map[string]VnetState{
		"disabled": VnetStateDisabled,
		"enabled":  VnetStateEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VnetState(input)
	return &out, nil
}
