package github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/clusters
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ClustersClient) ListFollowerDatabasesGetCompleteMatchingPredicate(ctx context.Context, id commonids.KustoClusterId, predicate FollowerDatabaseDefinitionGetOperationPredicate) (result ListFollowerDatabasesGetCompleteResult, err error) {
	items := make([]FollowerDatabaseDefinitionGet, 0)

	resp, err := c.ListFollowerDatabasesGet(ctx, id)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListFollowerDatabasesGetCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
