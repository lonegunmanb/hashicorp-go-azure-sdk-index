func PossibleValuesForState() []string {
	return []string{
		string(StateCreating),
		string(StateDeleted),
		string(StateDeleting),
		string(StateMigrated),
		string(StateRunning),
		string(StateStarting),
		string(StateStopped),
		string(StateStopping),
		string(StateUnavailable),
		string(StateUpdating),
	}
}
