package github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/dataconnections
import (
	"encoding/json"
	"fmt"
)
func (s EventGridDataConnection) DataConnection() BaseDataConnectionImpl {
	return BaseDataConnectionImpl{
		Id:       s.Id,
		Kind:     s.Kind,
		Location: s.Location,
		Name:     s.Name,
		Type:     s.Type,
	}
}
