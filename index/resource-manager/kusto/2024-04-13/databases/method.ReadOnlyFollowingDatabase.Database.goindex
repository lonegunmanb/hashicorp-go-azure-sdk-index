package github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/databases
import (
	"encoding/json"
	"fmt"
)
func (s ReadOnlyFollowingDatabase) Database() BaseDatabaseImpl {
	return BaseDatabaseImpl{
		Id:       s.Id,
		Kind:     s.Kind,
		Location: s.Location,
		Name:     s.Name,
		Type:     s.Type,
	}
}
