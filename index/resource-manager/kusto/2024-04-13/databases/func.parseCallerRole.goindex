package github.com/hashicorp/go-azure-sdk/resource-manager/kusto/2024-04-13/databases
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCallerRole(input string) (*CallerRole, error) {
	vals := map[string]CallerRole{
		"admin": CallerRoleAdmin,
		"none":  CallerRoleNone,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CallerRole(input)
	return &out, nil
}
