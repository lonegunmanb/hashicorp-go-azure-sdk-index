package github.com/hashicorp/go-azure-sdk/resource-manager/videoindexer/2025-04-01/arc
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewArcClientWithBaseURI(sdkApi sdkEnv.Api) (*ArcClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "arc", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ArcClient: %+v", err)
	}

	return &ArcClient{
		Client: client,
	}, nil
}
