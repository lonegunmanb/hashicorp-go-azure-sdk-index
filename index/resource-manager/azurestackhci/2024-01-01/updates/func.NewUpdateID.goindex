package github.com/hashicorp/go-azure-sdk/resource-manager/azurestackhci/2024-01-01/updates
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewUpdateID(subscriptionId string, resourceGroupName string, clusterName string, updateName string) UpdateId {
	return UpdateId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ClusterName:       clusterName,
		UpdateName:        updateName,
	}
}
