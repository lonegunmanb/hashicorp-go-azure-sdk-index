package github.com/hashicorp/go-azure-sdk/resource-manager/azurestackhci/2024-01-01/publishers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPublisherID(subscriptionId string, resourceGroupName string, clusterName string, publisherName string) PublisherId {
	return PublisherId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ClusterName:       clusterName,
		PublisherName:     publisherName,
	}
}
