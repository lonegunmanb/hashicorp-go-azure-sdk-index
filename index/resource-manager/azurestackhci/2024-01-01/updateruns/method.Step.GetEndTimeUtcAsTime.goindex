package github.com/hashicorp/go-azure-sdk/resource-manager/azurestackhci/2024-01-01/updateruns
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *Step) GetEndTimeUtcAsTime() (*time.Time, error) {
	if o.EndTimeUtc == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.EndTimeUtc, "2006-01-02T15:04:05Z07:00")
}
