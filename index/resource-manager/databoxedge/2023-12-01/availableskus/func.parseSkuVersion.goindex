package github.com/hashicorp/go-azure-sdk/resource-manager/databoxedge/2023-12-01/availableskus
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuVersion(input string) (*SkuVersion, error) {
	vals := map[string]SkuVersion{
		"preview": SkuVersionPreview,
		"stable":  SkuVersionStable,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuVersion(input)
	return &out, nil
}
