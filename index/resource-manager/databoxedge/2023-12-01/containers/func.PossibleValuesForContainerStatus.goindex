func PossibleValuesForContainerStatus() []string {
	return []string{
		string(ContainerStatusNeedsAttention),
		string(ContainerStatusOK),
		string(ContainerStatusOffline),
		string(ContainerStatusUnknown),
		string(ContainerStatusUpdating),
	}
}
