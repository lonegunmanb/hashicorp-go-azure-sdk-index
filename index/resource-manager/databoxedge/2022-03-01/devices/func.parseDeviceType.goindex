package github.com/hashicorp/go-azure-sdk/resource-manager/databoxedge/2022-03-01/devices
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDeviceType(input string) (*DeviceType, error) {
	vals := map[string]DeviceType{
		"databoxedgedevice": DeviceTypeDataBoxEdgeDevice,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DeviceType(input)
	return &out, nil
}
