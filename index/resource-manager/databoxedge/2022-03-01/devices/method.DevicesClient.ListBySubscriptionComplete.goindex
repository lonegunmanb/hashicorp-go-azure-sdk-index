package github.com/hashicorp/go-azure-sdk/resource-manager/databoxedge/2022-03-01/devices
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
