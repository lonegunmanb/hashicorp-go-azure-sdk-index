func PossibleValuesForShareStatus() []string {
	return []string{
		string(ShareStatusNeedsAttention),
		string(ShareStatusOK),
		string(ShareStatusOffline),
		string(ShareStatusUnknown),
		string(ShareStatusUpdating),
	}
}
