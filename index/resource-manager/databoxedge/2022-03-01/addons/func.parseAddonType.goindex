package github.com/hashicorp/go-azure-sdk/resource-manager/databoxedge/2022-03-01/addons
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAddonType(input string) (*AddonType, error) {
	vals := map[string]AddonType{
		"arcforkubernetes": AddonTypeArcForKubernetes,
		"iotedge":          AddonTypeIotEdge,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AddonType(input)
	return &out, nil
}
