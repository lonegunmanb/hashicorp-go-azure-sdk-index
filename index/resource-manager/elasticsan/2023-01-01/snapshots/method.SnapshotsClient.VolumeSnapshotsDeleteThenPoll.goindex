package github.com/hashicorp/go-azure-sdk/resource-manager/elasticsan/2023-01-01/snapshots
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SnapshotsClient) VolumeSnapshotsDeleteThenPoll(ctx context.Context, id SnapshotId) error {
	result, err := c.VolumeSnapshotsDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing VolumeSnapshotsDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after VolumeSnapshotsDelete: %+v", err)
	}

	return nil
}
