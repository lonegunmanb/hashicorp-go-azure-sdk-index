package github.com/hashicorp/go-azure-sdk/resource-manager/elasticsan/2023-01-01/volumes
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseVolumeGroupIDInsensitively(input string) (*VolumeGroupId, error) {
	parser := resourceids.NewParserFromResourceIdType(&VolumeGroupId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := VolumeGroupId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
