	KeyFilePath             *interface{}                     `json:"keyFilePath,omitempty"`
	Project                 interface{}                      `json:"project"`
	RefreshToken            SecretBase                       `json:"refreshToken"`
	RequestGoogleDriveScope *bool                            `json:"requestGoogleDriveScope,omitempty"`
