)
func (s SquareLinkedService) MarshalJSON() ([]byte, error) {
	type wrapper SquareLinkedService
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling SquareLinkedService: %+v", err)
	}

	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling SquareLinkedService: %+v", err)
	}

	decoded["type"] = "Square"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling SquareLinkedService: %+v", err)
	}

	return encoded, nil
}
