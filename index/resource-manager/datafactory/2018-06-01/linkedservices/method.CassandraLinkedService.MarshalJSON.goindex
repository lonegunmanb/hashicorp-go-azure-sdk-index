	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling CassandraLinkedService: %+v", err)
	}

	decoded["type"] = "Cassandra"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling CassandraLinkedService: %+v", err)
	}

