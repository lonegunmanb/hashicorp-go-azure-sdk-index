package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/credentials
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewCredentialID(subscriptionId string, resourceGroupName string, factoryName string, credentialName string) CredentialId {
	return CredentialId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		FactoryName:       factoryName,
		CredentialName:    credentialName,
	}
}
