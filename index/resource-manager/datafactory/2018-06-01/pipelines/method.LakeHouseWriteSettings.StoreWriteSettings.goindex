package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/pipelines
import (
	"encoding/json"
	"fmt"
)
func (s LakeHouseWriteSettings) StoreWriteSettings() BaseStoreWriteSettingsImpl {
	return BaseStoreWriteSettingsImpl{
		CopyBehavior:             s.CopyBehavior,
		DisableMetricsCollection: s.DisableMetricsCollection,
		MaxConcurrentConnections: s.MaxConcurrentConnections,
		Metadata:                 s.Metadata,
		Type:                     s.Type,
	}
}
