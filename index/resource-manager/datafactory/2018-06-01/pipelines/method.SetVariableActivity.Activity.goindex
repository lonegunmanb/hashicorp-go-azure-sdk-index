package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/pipelines
import (
	"encoding/json"
	"fmt"
)
func (s SetVariableActivity) Activity() BaseActivityImpl {
	return BaseActivityImpl{
		DependsOn:        s.DependsOn,
		Description:      s.Description,
		Name:             s.Name,
		OnInactiveMarkAs: s.OnInactiveMarkAs,
		State:            s.State,
		Type:             s.Type,
		UserProperties:   s.UserProperties,
	}
}
