package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/pipelines
import (
	"encoding/json"
	"fmt"
)
func (s HubspotSource) MarshalJSON() ([]byte, error) {
	type wrapper HubspotSource
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling HubspotSource: %+v", err)
	}

	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling HubspotSource: %+v", err)
	}

	decoded["type"] = "HubspotSource"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling HubspotSource: %+v", err)
	}

	return encoded, nil
}
