package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/integrationruntimes
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *SelfHostedIntegrationRuntimeNode) SetLastStopTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.LastStopTime = &formatted
}
