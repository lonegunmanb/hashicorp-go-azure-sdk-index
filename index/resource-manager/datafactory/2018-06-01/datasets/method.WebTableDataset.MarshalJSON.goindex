package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/datasets
import (
	"encoding/json"
	"fmt"
)
func (s WebTableDataset) MarshalJSON() ([]byte, error) {
	type wrapper WebTableDataset
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling WebTableDataset: %+v", err)
	}

	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling WebTableDataset: %+v", err)
	}

	decoded["type"] = "WebTable"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling WebTableDataset: %+v", err)
	}

	return encoded, nil
}
