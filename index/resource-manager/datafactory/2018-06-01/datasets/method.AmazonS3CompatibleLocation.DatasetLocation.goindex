package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/datasets
import (
	"encoding/json"
	"fmt"
)
func (s AmazonS3CompatibleLocation) DatasetLocation() BaseDatasetLocationImpl {
	return BaseDatasetLocationImpl{
		FileName:   s.FileName,
		FolderPath: s.FolderPath,
		Type:       s.Type,
	}
}
