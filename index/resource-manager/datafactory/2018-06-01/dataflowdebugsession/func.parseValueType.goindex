package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/dataflowdebugsession
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseValueType(input string) (*ValueType, error) {
	vals := map[string]ValueType{
		"actual":  ValueTypeActual,
		"display": ValueTypeDisplay,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ValueType(input)
	return &out, nil
}
