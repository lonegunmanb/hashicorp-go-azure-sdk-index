package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/pipelineruns
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o CancelOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.IsRecursive != nil {
		out.Append("isRecursive", fmt.Sprintf("%v", *o.IsRecursive))
	}
	return &out
}
