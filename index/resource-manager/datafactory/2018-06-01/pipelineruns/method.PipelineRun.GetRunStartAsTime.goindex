package github.com/hashicorp/go-azure-sdk/resource-manager/datafactory/2018-06-01/pipelineruns
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *PipelineRun) GetRunStartAsTime() (*time.Time, error) {
	if o.RunStart == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.RunStart, "2006-01-02T15:04:05Z07:00")
}
