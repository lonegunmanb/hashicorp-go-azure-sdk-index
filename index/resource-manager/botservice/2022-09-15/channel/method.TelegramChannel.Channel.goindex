package github.com/hashicorp/go-azure-sdk/resource-manager/botservice/2022-09-15/channel
import (
	"encoding/json"
	"fmt"
)
func (s TelegramChannel) Channel() BaseChannelImpl {
	return BaseChannelImpl{
		ChannelName:       s.ChannelName,
		Etag:              s.Etag,
		Location:          s.Location,
		ProvisioningState: s.ProvisioningState,
	}
}
