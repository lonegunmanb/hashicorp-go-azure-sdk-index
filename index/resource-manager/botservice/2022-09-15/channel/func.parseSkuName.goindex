package github.com/hashicorp/go-azure-sdk/resource-manager/botservice/2022-09-15/channel
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuName(input string) (*SkuName, error) {
	vals := map[string]SkuName{
		"f0": SkuNameFZero,
		"s1": SkuNameSOne,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuName(input)
	return &out, nil
}
