package github.com/hashicorp/go-azure-sdk/resource-manager/botservice/2022-09-15/privateendpointconnections
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateEndpointConnectionID(subscriptionId string, resourceGroupName string, botServiceName string, privateEndpointConnectionName string) PrivateEndpointConnectionId {
	return PrivateEndpointConnectionId{
		SubscriptionId:                subscriptionId,
		ResourceGroupName:             resourceGroupName,
		BotServiceName:                botServiceName,
		PrivateEndpointConnectionName: privateEndpointConnectionName,
	}
}
