package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2025-06-01/alertruletemplates
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/systemdata"
)
func (s FusionAlertRuleTemplate) AlertRuleTemplate() BaseAlertRuleTemplateImpl {
	return BaseAlertRuleTemplateImpl{
		Id:         s.Id,
		Kind:       s.Kind,
		Name:       s.Name,
		SystemData: s.SystemData,
		Type:       s.Type,
	}
}
