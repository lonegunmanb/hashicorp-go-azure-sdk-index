func PossibleValuesForDeliveryAction() []string {
	return []string{
		string(DeliveryActionBlocked),
		string(DeliveryActionDelivered),
		string(DeliveryActionDeliveredAsSpam),
		string(DeliveryActionReplaced),
		string(DeliveryActionUnknown),
	}
}
