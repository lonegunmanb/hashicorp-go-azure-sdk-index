func (s HuntingBookmark) MarshalJSON() ([]byte, error) {
	type wrapper HuntingBookmark
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling HuntingBookmark: %+v", err)
	}

	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling HuntingBookmark: %+v", err)
	}

	decoded["kind"] = "Bookmark"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling HuntingBookmark: %+v", err)
	}

	return encoded, nil
}
