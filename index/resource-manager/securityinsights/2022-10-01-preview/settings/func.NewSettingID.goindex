package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2022-10-01-preview/settings
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSettingID(subscriptionId string, resourceGroupName string, workspaceName string, settingName string) SettingId {
	return SettingId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		WorkspaceName:     workspaceName,
		SettingName:       settingName,
	}
}
