func (s ActivityEntityQuery) MarshalJSON() ([]byte, error) {
	type wrapper ActivityEntityQuery
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling ActivityEntityQuery: %+v", err)
