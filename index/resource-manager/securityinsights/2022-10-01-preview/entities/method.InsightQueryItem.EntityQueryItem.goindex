package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2022-10-01-preview/entities
import (
	"encoding/json"
	"fmt"
)
func (s InsightQueryItem) EntityQueryItem() BaseEntityQueryItemImpl {
	return BaseEntityQueryItemImpl{
		Id:   s.Id,
		Kind: s.Kind,
		Name: s.Name,
		Type: s.Type,
	}
}
