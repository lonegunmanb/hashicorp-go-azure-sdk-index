package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2022-10-01-preview/entities
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseOutputType(input string) (*OutputType, error) {
	vals := map[string]OutputType{
		"date":   OutputTypeDate,
		"entity": OutputTypeEntity,
		"number": OutputTypeNumber,
		"string": OutputTypeString,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := OutputType(input)
	return &out, nil
}
