package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2022-10-01-preview/enrichment
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *EnrichmentDomainWhois) GetExpiresAsTime() (*time.Time, error) {
	if o.Expires == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Expires, "2006-01-02T15:04:05Z07:00")
}
