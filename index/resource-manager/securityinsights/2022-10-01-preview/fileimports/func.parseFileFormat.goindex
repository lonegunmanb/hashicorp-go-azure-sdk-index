package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2022-10-01-preview/fileimports
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseFileFormat(input string) (*FileFormat, error) {
	vals := map[string]FileFormat{
		"csv":         FileFormatCSV,
		"json":        FileFormatJSON,
		"unspecified": FileFormatUnspecified,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := FileFormat(input)
	return &out, nil
}
