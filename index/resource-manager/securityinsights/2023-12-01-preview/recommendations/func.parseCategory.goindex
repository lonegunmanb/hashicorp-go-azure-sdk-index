package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/recommendations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCategory(input string) (*Category, error) {
	vals := map[string]Category{
		"costoptimization": CategoryCostOptimization,
		"demo":             CategoryDemo,
		"newfeature":       CategoryNewFeature,
		"onboarding":       CategoryOnboarding,
		"socefficiency":    CategorySocEfficiency,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Category(input)
	return &out, nil
}
