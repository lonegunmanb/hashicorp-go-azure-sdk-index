package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/settings
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/systemdata"
)
func (s EntityAnalytics) Settings() BaseSettingsImpl {
	return BaseSettingsImpl{
		Etag:       s.Etag,
		Id:         s.Id,
		Kind:       s.Kind,
		Name:       s.Name,
		SystemData: s.SystemData,
		Type:       s.Type,
	}
}
