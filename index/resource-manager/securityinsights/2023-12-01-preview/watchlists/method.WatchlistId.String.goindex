package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/watchlists
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id WatchlistId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Workspace Name: %q", id.WorkspaceName),
		fmt.Sprintf("Watchlist Alias: %q", id.WatchlistAlias),
	}
	return fmt.Sprintf("Watchlist (%s)", strings.Join(components, "\n"))
}
