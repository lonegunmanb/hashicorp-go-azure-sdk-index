package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/billingstatistics
import (
	"encoding/json"
	"fmt"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/systemdata"
)
func (s SapSolutionUsageStatistic) BillingStatistic() BaseBillingStatisticImpl {
	return BaseBillingStatisticImpl{
		Etag:       s.Etag,
		Id:         s.Id,
		Kind:       s.Kind,
		Name:       s.Name,
		SystemData: s.SystemData,
		Type:       s.Type,
	}
}
