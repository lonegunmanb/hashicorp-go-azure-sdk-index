package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/sourcecontrols
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVersion(input string) (*Version, error) {
	vals := map[string]Version{
		"v1": VersionVOne,
		"v2": VersionVTwo,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Version(input)
	return &out, nil
}
