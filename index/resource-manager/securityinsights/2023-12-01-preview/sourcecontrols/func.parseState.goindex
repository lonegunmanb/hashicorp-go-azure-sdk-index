package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/sourcecontrols
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseState(input string) (*State, error) {
	vals := map[string]State{
		"closed": StateClosed,
		"open":   StateOpen,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := State(input)
	return &out, nil
}
