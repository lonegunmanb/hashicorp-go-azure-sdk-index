package github.com/hashicorp/go-azure-sdk/resource-manager/securityinsights/2023-12-01-preview/incidentalerts
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *HuntingBookmarkProperties) GetUpdatedAsTime() (*time.Time, error) {
	if o.Updated == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Updated, "2006-01-02T15:04:05Z07:00")
}
