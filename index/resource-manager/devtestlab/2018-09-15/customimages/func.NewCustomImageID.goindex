package github.com/hashicorp/go-azure-sdk/resource-manager/devtestlab/2018-09-15/customimages
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewCustomImageID(subscriptionId string, resourceGroupName string, labName string, customImageName string) CustomImageId {
	return CustomImageId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LabName:           labName,
		CustomImageName:   customImageName,
	}
}
