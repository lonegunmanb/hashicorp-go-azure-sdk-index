package github.com/hashicorp/go-azure-sdk/resource-manager/devtestlab/2018-09-15/schedules
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
