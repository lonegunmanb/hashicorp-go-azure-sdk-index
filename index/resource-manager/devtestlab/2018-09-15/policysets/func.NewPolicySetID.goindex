package github.com/hashicorp/go-azure-sdk/resource-manager/devtestlab/2018-09-15/policysets
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPolicySetID(subscriptionId string, resourceGroupName string, labName string, policySetName string) PolicySetId {
	return PolicySetId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LabName:           labName,
		PolicySetName:     policySetName,
	}
}
