package github.com/hashicorp/go-azure-sdk/resource-manager/devtestlab/2018-09-15/policies
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c PoliciesClient) ListComplete(ctx context.Context, id PolicySetId, options ListOperationOptions) (ListCompleteResult, error) {
	return c.ListCompleteMatchingPredicate(ctx, id, options, PolicyOperationPredicate{})
}
