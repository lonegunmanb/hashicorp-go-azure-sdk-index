package github.com/hashicorp/go-azure-sdk/resource-manager/devtestlab/2018-09-15/costs
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id CostId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Lab Name: %q", id.LabName),
		fmt.Sprintf("Cost Name: %q", id.CostName),
	}
	return fmt.Sprintf("Cost (%s)", strings.Join(components, "\n"))
}
