package github.com/hashicorp/go-azure-sdk/resource-manager/postgresqlhsc/2022-11-08/privatelinkresources
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateLinkResourceID(subscriptionId string, resourceGroupName string, serverGroupsv2Name string, privateLinkResourceName string) PrivateLinkResourceId {
	return PrivateLinkResourceId{
		SubscriptionId:          subscriptionId,
		ResourceGroupName:       resourceGroupName,
		ServerGroupsv2Name:      serverGroupsv2Name,
		PrivateLinkResourceName: privateLinkResourceName,
	}
}
