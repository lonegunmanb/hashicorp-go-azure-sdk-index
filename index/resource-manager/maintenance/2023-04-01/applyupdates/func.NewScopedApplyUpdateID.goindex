package github.com/hashicorp/go-azure-sdk/resource-manager/maintenance/2023-04-01/applyupdates
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScopedApplyUpdateID(scope string, applyUpdateName string) ScopedApplyUpdateId {
	return ScopedApplyUpdateId{
		Scope:           scope,
		ApplyUpdateName: applyUpdateName,
	}
}
