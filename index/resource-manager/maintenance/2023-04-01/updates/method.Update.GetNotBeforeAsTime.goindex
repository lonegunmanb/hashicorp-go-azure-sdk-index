package github.com/hashicorp/go-azure-sdk/resource-manager/maintenance/2023-04-01/updates
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *Update) GetNotBeforeAsTime() (*time.Time, error) {
	if o.NotBefore == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.NotBefore, "2006-01-02T15:04:05Z07:00")
}
