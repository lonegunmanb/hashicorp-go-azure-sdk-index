package github.com/hashicorp/go-azure-sdk/resource-manager/maintenance/2023-04-01/publicmaintenanceconfigurations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVisibility(input string) (*Visibility, error) {
	vals := map[string]Visibility{
		"custom": VisibilityCustom,
		"public": VisibilityPublic,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Visibility(input)
	return &out, nil
}
