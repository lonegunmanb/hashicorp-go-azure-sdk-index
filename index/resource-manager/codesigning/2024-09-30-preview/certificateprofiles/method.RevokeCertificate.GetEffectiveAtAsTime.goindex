package github.com/hashicorp/go-azure-sdk/resource-manager/codesigning/2024-09-30-preview/certificateprofiles
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *RevokeCertificate) GetEffectiveAtAsTime() (*time.Time, error) {
	return dates.ParseAsFormat(&o.EffectiveAt, "2006-01-02T15:04:05Z07:00")
}
