)
func NewCodeSigningAccountsClientWithBaseURI(sdkApi sdkEnv.Api) (*CodeSigningAccountsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "codesigningaccounts", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating CodeSigningAccountsClient: %+v", err)
	}

	return &CodeSigningAccountsClient{
		Client: client,
	}, nil
}
