package github.com/hashicorp/go-azure-sdk/resource-manager/networkcloud/2025-02-01/networkclouds
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDiskType(input string) (*DiskType, error) {
	vals := map[string]DiskType{
		"hdd": DiskTypeHDD,
		"ssd": DiskTypeSSD,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DiskType(input)
	return &out, nil
}
