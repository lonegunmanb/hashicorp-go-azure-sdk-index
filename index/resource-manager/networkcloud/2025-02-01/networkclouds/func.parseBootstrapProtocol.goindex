package github.com/hashicorp/go-azure-sdk/resource-manager/networkcloud/2025-02-01/networkclouds
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBootstrapProtocol(input string) (*BootstrapProtocol, error) {
	vals := map[string]BootstrapProtocol{
		"pxe": BootstrapProtocolPXE,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BootstrapProtocol(input)
	return &out, nil
}
