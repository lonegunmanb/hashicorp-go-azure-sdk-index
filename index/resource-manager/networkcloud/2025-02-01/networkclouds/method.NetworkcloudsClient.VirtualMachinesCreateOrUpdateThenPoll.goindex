package github.com/hashicorp/go-azure-sdk/resource-manager/networkcloud/2025-02-01/networkclouds
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c NetworkcloudsClient) VirtualMachinesCreateOrUpdateThenPoll(ctx context.Context, id VirtualMachineId, input VirtualMachine, options VirtualMachinesCreateOrUpdateOperationOptions) error {
	result, err := c.VirtualMachinesCreateOrUpdate(ctx, id, input, options)
	if err != nil {
		return fmt.Errorf("performing VirtualMachinesCreateOrUpdate: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after VirtualMachinesCreateOrUpdate: %+v", err)
	}

	return nil
}
