package github.com/hashicorp/go-azure-sdk/resource-manager/networkcloud/2025-02-01/networkclouds
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c NetworkcloudsClient) KubernetesClusterFeaturesDeleteThenPoll(ctx context.Context, id FeatureId, options KubernetesClusterFeaturesDeleteOperationOptions) error {
	result, err := c.KubernetesClusterFeaturesDelete(ctx, id, options)
	if err != nil {
		return fmt.Errorf("performing KubernetesClusterFeaturesDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after KubernetesClusterFeaturesDelete: %+v", err)
	}

	return nil
}
