package github.com/hashicorp/go-azure-sdk/resource-manager/networkcloud/2025-02-01/networkclouds
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBgpMultiHop(input string) (*BgpMultiHop, error) {
	vals := map[string]BgpMultiHop{
		"false": BgpMultiHopFalse,
		"true":  BgpMultiHopTrue,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BgpMultiHop(input)
	return &out, nil
}
