package github.com/hashicorp/go-azure-sdk/resource-manager/appplatform/2024-01-01-preview/appplatform
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePowerState(input string) (*PowerState, error) {
	vals := map[string]PowerState{
		"running": PowerStateRunning,
		"stopped": PowerStateStopped,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PowerState(input)
	return &out, nil
}
