package github.com/hashicorp/go-azure-sdk/resource-manager/appplatform/2024-05-01-preview/appplatform
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseJobResourceProvisioningState(input string) (*JobResourceProvisioningState, error) {
	vals := map[string]JobResourceProvisioningState{
		"canceled":  JobResourceProvisioningStateCanceled,
		"creating":  JobResourceProvisioningStateCreating,
		"deleting":  JobResourceProvisioningStateDeleting,
		"failed":    JobResourceProvisioningStateFailed,
		"succeeded": JobResourceProvisioningStateSucceeded,
		"updating":  JobResourceProvisioningStateUpdating,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := JobResourceProvisioningState(input)
	return &out, nil
}
