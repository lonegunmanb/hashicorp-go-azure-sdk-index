package github.com/hashicorp/go-azure-sdk/resource-manager/appplatform/2024-05-01-preview/appplatform
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o AppsGetOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.SyncStatus != nil {
		out.Append("syncStatus", fmt.Sprintf("%v", *o.SyncStatus))
	}
	return &out
}
