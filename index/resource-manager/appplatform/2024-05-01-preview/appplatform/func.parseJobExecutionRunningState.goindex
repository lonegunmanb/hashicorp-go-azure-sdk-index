package github.com/hashicorp/go-azure-sdk/resource-manager/appplatform/2024-05-01-preview/appplatform
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseJobExecutionRunningState(input string) (*JobExecutionRunningState, error) {
	vals := map[string]JobExecutionRunningState{
		"canceled":  JobExecutionRunningStateCanceled,
		"completed": JobExecutionRunningStateCompleted,
		"failed":    JobExecutionRunningStateFailed,
		"pending":   JobExecutionRunningStatePending,
		"running":   JobExecutionRunningStateRunning,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := JobExecutionRunningState(input)
	return &out, nil
}
