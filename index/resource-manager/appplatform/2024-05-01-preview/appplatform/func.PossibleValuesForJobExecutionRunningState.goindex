func PossibleValuesForJobExecutionRunningState() []string {
	return []string{
		string(JobExecutionRunningStateCanceled),
		string(JobExecutionRunningStateCompleted),
		string(JobExecutionRunningStateFailed),
		string(JobExecutionRunningStatePending),
		string(JobExecutionRunningStateRunning),
	}
}
