package github.com/hashicorp/go-azure-sdk/resource-manager/informatica/2024-05-08/organizations
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewOrganizationID(subscriptionId string, resourceGroupName string, organizationName string) OrganizationId {
	return OrganizationId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		OrganizationName:  organizationName,
	}
}
