package github.com/hashicorp/go-azure-sdk/resource-manager/informatica/2024-05-08/organizations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRuntimeType(input string) (*RuntimeType, error) {
	vals := map[string]RuntimeType{
		"serverless": RuntimeTypeSERVERLESS,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RuntimeType(input)
	return &out, nil
}
