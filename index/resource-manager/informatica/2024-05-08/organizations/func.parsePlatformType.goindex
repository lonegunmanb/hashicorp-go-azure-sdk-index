package github.com/hashicorp/go-azure-sdk/resource-manager/informatica/2024-05-08/organizations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePlatformType(input string) (*PlatformType, error) {
	vals := map[string]PlatformType{
		"azure": PlatformTypeAZURE,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PlatformType(input)
	return &out, nil
}
