package github.com/hashicorp/go-azure-sdk/resource-manager/informatica/2024-05-08/serverlessruntimes
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id OrganizationId) ID() string {
	fmtString := "/subscriptions/%s/resourceGroups/%s/providers/Informatica.DataManagement/organizations/%s"
	return fmt.Sprintf(fmtString, id.SubscriptionId, id.ResourceGroupName, id.OrganizationName)
}
