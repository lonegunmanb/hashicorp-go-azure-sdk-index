package github.com/hashicorp/go-azure-sdk/resource-manager/systemcentervirtualmachinemanager/2025-03-13/virtualnetworks
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseForceDelete(input string) (*ForceDelete, error) {
	vals := map[string]ForceDelete{
		"false": ForceDeleteFalse,
		"true":  ForceDeleteTrue,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ForceDelete(input)
	return &out, nil
}
