func (o DeleteOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.DeleteFromHost != nil {
		out.Append("deleteFromHost", fmt.Sprintf("%v", *o.DeleteFromHost))
	}
	if o.Force != nil {
		out.Append("force", fmt.Sprintf("%v", *o.Force))
	}
	return &out
}
