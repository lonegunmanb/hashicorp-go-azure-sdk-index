package github.com/hashicorp/go-azure-sdk/resource-manager/systemcentervirtualmachinemanager/2025-03-13/virtualmachineinstances
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c VirtualMachineInstancesClient) DeleteCheckpointThenPoll(ctx context.Context, id commonids.ScopeId, input VirtualMachineDeleteCheckpoint) error {
	result, err := c.DeleteCheckpoint(ctx, id, input)
	if err != nil {
		return fmt.Errorf("performing DeleteCheckpoint: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after DeleteCheckpoint: %+v", err)
	}

	return nil
}
