package github.com/hashicorp/go-azure-sdk/resource-manager/systemcentervirtualmachinemanager/2023-10-07/virtualmachinetemplates
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIsCustomizable(input string) (*IsCustomizable, error) {
	vals := map[string]IsCustomizable{
		"false": IsCustomizableFalse,
		"true":  IsCustomizableTrue,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IsCustomizable(input)
	return &out, nil
}
