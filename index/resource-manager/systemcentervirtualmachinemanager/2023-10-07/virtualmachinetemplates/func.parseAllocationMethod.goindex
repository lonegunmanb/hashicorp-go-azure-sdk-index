package github.com/hashicorp/go-azure-sdk/resource-manager/systemcentervirtualmachinemanager/2023-10-07/virtualmachinetemplates
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAllocationMethod(input string) (*AllocationMethod, error) {
	vals := map[string]AllocationMethod{
		"dynamic": AllocationMethodDynamic,
		"static":  AllocationMethodStatic,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AllocationMethod(input)
	return &out, nil
}
