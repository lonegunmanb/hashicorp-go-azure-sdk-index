package github.com/hashicorp/go-azure-sdk/resource-manager/systemcentervirtualmachinemanager/2023-10-07/virtualmachineinstances
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkipShutdown(input string) (*SkipShutdown, error) {
	vals := map[string]SkipShutdown{
		"false": SkipShutdownFalse,
		"true":  SkipShutdownTrue,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkipShutdown(input)
	return &out, nil
}
