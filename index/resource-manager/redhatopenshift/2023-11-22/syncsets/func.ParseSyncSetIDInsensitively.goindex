package github.com/hashicorp/go-azure-sdk/resource-manager/redhatopenshift/2023-11-22/syncsets
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseSyncSetIDInsensitively(input string) (*SyncSetId, error) {
	parser := resourceids.NewParserFromResourceIdType(&SyncSetId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := SyncSetId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
