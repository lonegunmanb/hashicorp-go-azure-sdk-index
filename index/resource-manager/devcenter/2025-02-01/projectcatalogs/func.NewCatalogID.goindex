package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/projectcatalogs
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewCatalogID(subscriptionId string, resourceGroupName string, projectName string, catalogName string) CatalogId {
	return CatalogId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ProjectName:       projectName,
		CatalogName:       catalogName,
	}
}
