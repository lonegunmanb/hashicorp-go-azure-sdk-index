package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/pools
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLicenseType(input string) (*LicenseType, error) {
	vals := map[string]LicenseType{
		"windows_client": LicenseTypeWindowsClient,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LicenseType(input)
	return &out, nil
}
