func PossibleValuesForHealthStatus() []string {
	return []string{
		string(HealthStatusHealthy),
		string(HealthStatusPending),
		string(HealthStatusUnhealthy),
		string(HealthStatusUnknown),
		string(HealthStatusWarning),
	}
}
