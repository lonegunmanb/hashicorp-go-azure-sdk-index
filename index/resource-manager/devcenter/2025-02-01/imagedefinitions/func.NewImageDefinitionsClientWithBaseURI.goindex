package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/imagedefinitions
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewImageDefinitionsClientWithBaseURI(sdkApi sdkEnv.Api) (*ImageDefinitionsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "imagedefinitions", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ImageDefinitionsClient: %+v", err)
	}

	return &ImageDefinitionsClient{
		Client: client,
	}, nil
}
