func PossibleValuesForParameterType() []string {
	return []string{
		string(ParameterTypeArray),
		string(ParameterTypeBoolean),
		string(ParameterTypeInteger),
		string(ParameterTypeNumber),
		string(ParameterTypeObject),
		string(ParameterTypeString),
