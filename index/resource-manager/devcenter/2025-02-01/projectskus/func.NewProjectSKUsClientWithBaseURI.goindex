package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/projectskus
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewProjectSKUsClientWithBaseURI(sdkApi sdkEnv.Api) (*ProjectSKUsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "projectskus", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ProjectSKUsClient: %+v", err)
	}

	return &ProjectSKUsClient{
		Client: client,
	}, nil
}
