package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/customizationtasks
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewTaskID(subscriptionId string, resourceGroupName string, devCenterName string, catalogName string, taskName string) TaskId {
	return TaskId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		DevCenterName:     devCenterName,
		CatalogName:       catalogName,
		TaskName:          taskName,
	}
}
