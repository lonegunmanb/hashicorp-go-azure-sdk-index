package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/customizationtasks
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id TaskId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Dev Center Name: %q", id.DevCenterName),
		fmt.Sprintf("Catalog Name: %q", id.CatalogName),
		fmt.Sprintf("Task Name: %q", id.TaskName),
	}
	return fmt.Sprintf("Task (%s)", strings.Join(components, "\n"))
}
