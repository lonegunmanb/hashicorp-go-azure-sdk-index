package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/images
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewGalleryID(subscriptionId string, resourceGroupName string, devCenterName string, galleryName string) GalleryId {
	return GalleryId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		DevCenterName:     devCenterName,
		GalleryName:       galleryName,
	}
}
