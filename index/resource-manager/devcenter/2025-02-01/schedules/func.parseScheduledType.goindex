package github.com/hashicorp/go-azure-sdk/resource-manager/devcenter/2025-02-01/schedules
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScheduledType(input string) (*ScheduledType, error) {
	vals := map[string]ScheduledType{
		"stopdevbox": ScheduledTypeStopDevBox,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScheduledType(input)
	return &out, nil
}
