package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2023-07-01/credentialsets
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCredentialName(input string) (*CredentialName, error) {
	vals := map[string]CredentialName{
		"credential1": CredentialNameCredentialOne,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CredentialName(input)
	return &out, nil
}
