package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2023-07-01/cacherules
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCacheRuleID(input string) (*CacheRuleId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CacheRuleId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CacheRuleId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
