package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2025-04-01/tokens
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *TokenPassword) GetExpiryAsTime() (*time.Time, error) {
	if o.Expiry == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Expiry, "2006-01-02T15:04:05Z07:00")
}
