package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2025-04-01/connectedregistries
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCertificateType(input string) (*CertificateType, error) {
	vals := map[string]CertificateType{
		"localdirectory": CertificateTypeLocalDirectory,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CertificateType(input)
	return &out, nil
}
