package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2025-04-01/webhooks
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewWebHookID(subscriptionId string, resourceGroupName string, registryName string, webHookName string) WebHookId {
	return WebHookId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		RegistryName:      registryName,
		WebHookName:       webHookName,
	}
}
