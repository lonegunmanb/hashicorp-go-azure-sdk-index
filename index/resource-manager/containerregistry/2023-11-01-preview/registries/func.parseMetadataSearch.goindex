package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2023-11-01-preview/registries
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMetadataSearch(input string) (*MetadataSearch, error) {
	vals := map[string]MetadataSearch{
		"disabled": MetadataSearchDisabled,
		"enabled":  MetadataSearchEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MetadataSearch(input)
	return &out, nil
}
