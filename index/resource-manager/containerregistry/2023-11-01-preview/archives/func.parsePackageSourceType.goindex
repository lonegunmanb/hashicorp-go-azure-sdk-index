package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2023-11-01-preview/archives
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePackageSourceType(input string) (*PackageSourceType, error) {
	vals := map[string]PackageSourceType{
		"remote": PackageSourceTypeRemote,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PackageSourceType(input)
	return &out, nil
}
