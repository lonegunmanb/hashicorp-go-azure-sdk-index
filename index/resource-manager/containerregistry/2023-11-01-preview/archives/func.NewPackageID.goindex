package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2023-11-01-preview/archives
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPackageID(subscriptionId string, resourceGroupName string, registryName string, packageName string) PackageId {
	return PackageId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		RegistryName:      registryName,
		PackageName:       packageName,
	}
}
