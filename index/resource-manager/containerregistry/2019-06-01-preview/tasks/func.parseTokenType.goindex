package github.com/hashicorp/go-azure-sdk/resource-manager/containerregistry/2019-06-01-preview/tasks
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseTokenType(input string) (*TokenType, error) {
	vals := map[string]TokenType{
		"oauth": TokenTypeOAuth,
		"pat":   TokenTypePAT,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := TokenType(input)
	return &out, nil
}
