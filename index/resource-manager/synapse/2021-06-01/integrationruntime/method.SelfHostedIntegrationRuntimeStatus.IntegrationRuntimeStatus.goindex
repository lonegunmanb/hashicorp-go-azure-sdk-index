func (s SelfHostedIntegrationRuntimeStatus) IntegrationRuntimeStatus() BaseIntegrationRuntimeStatusImpl {
	return BaseIntegrationRuntimeStatusImpl{
		DataFactoryName: s.DataFactoryName,
		State:           s.State,
		Type:            s.Type,
	}
}
