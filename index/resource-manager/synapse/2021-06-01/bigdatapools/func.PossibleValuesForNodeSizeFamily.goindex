func PossibleValuesForNodeSizeFamily() []string {
	return []string{
		string(NodeSizeFamilyHardwareAcceleratedFPGA),
		string(NodeSizeFamilyHardwareAcceleratedGPU),
		string(NodeSizeFamilyMemoryOptimized),
