func PossibleValuesForNodeSize() []string {
	return []string{
		string(NodeSizeLarge),
		string(NodeSizeMedium),
		string(NodeSizeNone),
		string(NodeSizeSmall),
		string(NodeSizeXLarge),
		string(NodeSizeXXLarge),
