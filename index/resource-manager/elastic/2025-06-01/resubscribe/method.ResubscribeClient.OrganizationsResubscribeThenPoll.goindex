package github.com/hashicorp/go-azure-sdk/resource-manager/elastic/2025-06-01/resubscribe
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ResubscribeClient) OrganizationsResubscribeThenPoll(ctx context.Context, id MonitorId, input ResubscribeProperties) error {
	result, err := c.OrganizationsResubscribe(ctx, id, input)
	if err != nil {
		return fmt.Errorf("performing OrganizationsResubscribe: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after OrganizationsResubscribe: %+v", err)
	}

	return nil
}
