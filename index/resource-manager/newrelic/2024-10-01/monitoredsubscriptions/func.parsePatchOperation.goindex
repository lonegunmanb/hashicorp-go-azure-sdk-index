package github.com/hashicorp/go-azure-sdk/resource-manager/newrelic/2024-10-01/monitoredsubscriptions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePatchOperation(input string) (*PatchOperation, error) {
	vals := map[string]PatchOperation{
		"active":         PatchOperationActive,
		"addbegin":       PatchOperationAddBegin,
		"addcomplete":    PatchOperationAddComplete,
		"deletebegin":    PatchOperationDeleteBegin,
		"deletecomplete": PatchOperationDeleteComplete,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PatchOperation(input)
	return &out, nil
}
