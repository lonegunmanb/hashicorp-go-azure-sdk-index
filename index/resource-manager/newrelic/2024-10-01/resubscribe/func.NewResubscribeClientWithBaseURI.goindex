package github.com/hashicorp/go-azure-sdk/resource-manager/newrelic/2024-10-01/resubscribe
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewResubscribeClientWithBaseURI(sdkApi sdkEnv.Api) (*ResubscribeClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "resubscribe", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating ResubscribeClient: %+v", err)
	}

	return &ResubscribeClient{
		Client: client,
	}, nil
}
