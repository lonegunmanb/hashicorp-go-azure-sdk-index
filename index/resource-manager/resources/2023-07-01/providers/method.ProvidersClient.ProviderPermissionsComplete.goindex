package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2023-07-01/providers
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
