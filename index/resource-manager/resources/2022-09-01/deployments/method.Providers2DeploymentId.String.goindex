package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2022-09-01/deployments
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id Providers2DeploymentId) String() string {
	components := []string{
		fmt.Sprintf("Group: %q", id.GroupId),
		fmt.Sprintf("Deployment Name: %q", id.DeploymentName),
	}
	return fmt.Sprintf("Providers 2 Deployment (%s)", strings.Join(components, "\n"))
}
