package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2025-04-01/deployments
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLevel(input string) (*Level, error) {
	vals := map[string]Level{
		"error":   LevelError,
		"info":    LevelInfo,
		"warning": LevelWarning,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Level(input)
	return &out, nil
}
