package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2025-04-01/deployments
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseValidationLevel(input string) (*ValidationLevel, error) {
	vals := map[string]ValidationLevel{
		"provider":       ValidationLevelProvider,
		"providernorbac": ValidationLevelProviderNoRbac,
		"template":       ValidationLevelTemplate,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ValidationLevel(input)
	return &out, nil
}
