package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2015-11-01/subscriptions
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c SubscriptionsClient) ListComplete(ctx context.Context) (ListCompleteResult, error) {
	return c.ListCompleteMatchingPredicate(ctx, SubscriptionOperationPredicate{})
}
