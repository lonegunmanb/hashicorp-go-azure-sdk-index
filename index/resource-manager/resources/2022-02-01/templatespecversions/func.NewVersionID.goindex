package github.com/hashicorp/go-azure-sdk/resource-manager/resources/2022-02-01/templatespecversions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewVersionID(builtInTemplateSpecName string, versionName string) VersionId {
	return VersionId{
		BuiltInTemplateSpecName: builtInTemplateSpecName,
		VersionName:             versionName,
	}
}
