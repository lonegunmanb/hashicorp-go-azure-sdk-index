package github.com/hashicorp/go-azure-sdk/resource-manager/mariadb/2018-06-01/querytexts
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o ListByServerOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.QueryIds != nil {
		out.Append("queryIds", fmt.Sprintf("%v", *o.QueryIds))
	}
	return &out
}
