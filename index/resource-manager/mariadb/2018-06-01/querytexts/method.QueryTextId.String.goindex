package github.com/hashicorp/go-azure-sdk/resource-manager/mariadb/2018-06-01/querytexts
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id QueryTextId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Server Name: %q", id.ServerName),
		fmt.Sprintf("Query: %q", id.QueryId),
	}
	return fmt.Sprintf("Query Text (%s)", strings.Join(components, "\n"))
}
