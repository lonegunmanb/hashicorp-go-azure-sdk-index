package github.com/hashicorp/go-azure-sdk/resource-manager/mariadb/2018-06-01/querytexts
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c QueryTextsClient) ListByServerCompleteMatchingPredicate(ctx context.Context, id ServerId, options ListByServerOperationOptions, predicate QueryTextOperationPredicate) (result ListByServerCompleteResult, err error) {
	items := make([]QueryText, 0)

	resp, err := c.ListByServer(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListByServerCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
