package github.com/hashicorp/go-azure-sdk/resource-manager/apicenter/2024-03-15-preview/apis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseApiKind(input string) (*ApiKind, error) {
	vals := map[string]ApiKind{
		"graphql":   ApiKindGraphql,
		"grpc":      ApiKindGrpc,
		"rest":      ApiKindRest,
		"soap":      ApiKindSoap,
		"webhook":   ApiKindWebhook,
		"websocket": ApiKindWebsocket,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ApiKind(input)
	return &out, nil
}
