package github.com/hashicorp/go-azure-sdk/resource-manager/subscription/2021-10-01/subscriptions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id SubscriptionOperationId) String() string {
	components := []string{
		fmt.Sprintf("Operation: %q", id.OperationId),
	}
	return fmt.Sprintf("Subscription Operation (%s)", strings.Join(components, "\n"))
}
