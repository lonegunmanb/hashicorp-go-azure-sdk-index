package github.com/hashicorp/go-azure-sdk/resource-manager/subscription/2021-10-01/subscriptions
import (
	"context"
	"net/http"

	"github.com/Azure/go-autorest/autorest"
	"github.com/Azure/go-autorest/autorest/azure"
)
func (c SubscriptionsClient) responderForAliasDelete(resp *http.Response) (result AliasDeleteOperationResponse, err error) {
	err = autorest.Respond(
		resp,
		azure.WithErrorUnlessStatusCode(http.StatusNoContent, http.StatusOK),
		autorest.ByClosing())
	result.HttpResponse = resp

	return
}
