package github.com/hashicorp/go-azure-sdk/resource-manager/streamanalytics/2021-10-01-preview/functions
import (
	"encoding/json"
	"fmt"
)
func (s AggregateFunctionProperties) FunctionProperties() BaseFunctionPropertiesImpl {
	return BaseFunctionPropertiesImpl{
		Etag:       s.Etag,
		Properties: s.Properties,
		Type:       s.Type,
	}
}
