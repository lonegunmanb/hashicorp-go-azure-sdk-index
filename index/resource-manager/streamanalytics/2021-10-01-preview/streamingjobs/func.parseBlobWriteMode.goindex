package github.com/hashicorp/go-azure-sdk/resource-manager/streamanalytics/2021-10-01-preview/streamingjobs
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBlobWriteMode(input string) (*BlobWriteMode, error) {
	vals := map[string]BlobWriteMode{
		"append": BlobWriteModeAppend,
		"once":   BlobWriteModeOnce,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BlobWriteMode(input)
	return &out, nil
}
