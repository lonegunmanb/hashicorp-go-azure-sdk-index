func (s ScalarFunctionProperties) FunctionProperties() BaseFunctionPropertiesImpl {
	return BaseFunctionPropertiesImpl{
		Etag:       s.Etag,
		Properties: s.Properties,
		Type:       s.Type,
	}
}
