package github.com/hashicorp/go-azure-sdk/resource-manager/streamanalytics/2020-03-01/transformations
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseTransformationID(input string) (*TransformationId, error) {
	parser := resourceids.NewParserFromResourceIdType(&TransformationId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := TransformationId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
