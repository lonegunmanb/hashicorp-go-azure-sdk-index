package github.com/hashicorp/go-azure-sdk/resource-manager/streamanalytics/2020-03-01/streamingjobs
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *StartStreamingJobParameters) SetOutputStartTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.OutputStartTime = &formatted
}
