package github.com/hashicorp/go-azure-sdk/resource-manager/streamanalytics/2020-03-01/inputs
import (
	"encoding/json"
	"fmt"
)
func (s StreamInputProperties) InputProperties() BaseInputPropertiesImpl {
	return BaseInputPropertiesImpl{
		Compression:   s.Compression,
		Diagnostics:   s.Diagnostics,
		Etag:          s.Etag,
		PartitionKey:  s.PartitionKey,
		Serialization: s.Serialization,
		Type:          s.Type,
	}
}
