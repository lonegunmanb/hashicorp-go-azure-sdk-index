func PossibleValuesForActivationState() []string {
	return []string{
		string(ActivationStateActive),
		string(ActivationStateFailed),
		string(ActivationStateNotActivated),
		string(ActivationStateNotDefined),
		string(ActivationStateUnknown),
	}
}
