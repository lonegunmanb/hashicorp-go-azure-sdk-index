package github.com/hashicorp/go-azure-sdk/resource-manager/hardwaresecuritymodules/2025-03-31/privateendpointconnections
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateEndpointConnectionID(subscriptionId string, resourceGroupName string, cloudHsmClusterName string, privateEndpointConnectionName string) PrivateEndpointConnectionId {
	return PrivateEndpointConnectionId{
		SubscriptionId:                subscriptionId,
		ResourceGroupName:             resourceGroupName,
		CloudHsmClusterName:           cloudHsmClusterName,
		PrivateEndpointConnectionName: privateEndpointConnectionName,
	}
}
