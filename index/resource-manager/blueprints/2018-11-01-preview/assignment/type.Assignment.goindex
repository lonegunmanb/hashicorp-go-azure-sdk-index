package github.com/hashicorp/go-azure-sdk/resource-manager/blueprints/2018-11-01-preview/assignment
import (
	"github.com/hashicorp/go-azure-helpers/resourcemanager/identity"
)
type Assignment struct {
	Id         *string                          `json:"id,omitempty"`
	Identity   identity.SystemOrUserAssignedMap `json:"identity"`
	Location   string                           `json:"location"`
	Name       *string                          `json:"name,omitempty"`
	Properties AssignmentProperties             `json:"properties"`
	Type       *string                          `json:"type,omitempty"`
}
