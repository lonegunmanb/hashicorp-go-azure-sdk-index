package github.com/hashicorp/go-azure-sdk/resource-manager/redisenterprise/2025-04-01/databases
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAofFrequency(input string) (*AofFrequency, error) {
	vals := map[string]AofFrequency{
		"always": AofFrequencyAlways,
		"1s":     AofFrequencyOnes,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AofFrequency(input)
	return &out, nil
}
