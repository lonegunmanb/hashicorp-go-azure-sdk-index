package github.com/hashicorp/go-azure-sdk/resource-manager/redisenterprise/2025-04-01/redisenterprise
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseKind(input string) (*Kind, error) {
	vals := map[string]Kind{
		"v1": KindVOne,
		"v2": KindVTwo,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Kind(input)
	return &out, nil
}
