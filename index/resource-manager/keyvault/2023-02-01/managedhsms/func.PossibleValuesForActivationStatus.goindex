import (
	"strings"
)
func PossibleValuesForActivationStatus() []string {
	return []string{
		string(ActivationStatusActive),
		string(ActivationStatusFailed),
		string(ActivationStatusNotActivated),
		string(ActivationStatusUnknown),
	}
}
