package github.com/hashicorp/go-azure-sdk/resource-manager/authorization/2020-10-01/roleassignmentscheduleinstances
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *RoleAssignmentScheduleInstanceProperties) SetEndDateTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.EndDateTime = &formatted
}
