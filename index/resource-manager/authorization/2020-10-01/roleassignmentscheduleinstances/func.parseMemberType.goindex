package github.com/hashicorp/go-azure-sdk/resource-manager/authorization/2020-10-01/roleassignmentscheduleinstances
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMemberType(input string) (*MemberType, error) {
	vals := map[string]MemberType{
		"direct":    MemberTypeDirect,
		"group":     MemberTypeGroup,
		"inherited": MemberTypeInherited,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MemberType(input)
	return &out, nil
}
