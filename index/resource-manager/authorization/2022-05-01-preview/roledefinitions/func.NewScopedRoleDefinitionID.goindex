package github.com/hashicorp/go-azure-sdk/resource-manager/authorization/2022-05-01-preview/roledefinitions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScopedRoleDefinitionID(scope string, roleDefinitionId string) ScopedRoleDefinitionId {
	return ScopedRoleDefinitionId{
		Scope:            scope,
		RoleDefinitionId: roleDefinitionId,
	}
}
