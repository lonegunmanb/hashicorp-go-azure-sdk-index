package github.com/hashicorp/go-azure-sdk/resource-manager/authorization/2022-04-01/roledefinitions
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewRoleDefinitionsClientWithBaseURI(sdkApi sdkEnv.Api) (*RoleDefinitionsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "roledefinitions", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating RoleDefinitionsClient: %+v", err)
	}

	return &RoleDefinitionsClient{
		Client: client,
	}, nil
}
