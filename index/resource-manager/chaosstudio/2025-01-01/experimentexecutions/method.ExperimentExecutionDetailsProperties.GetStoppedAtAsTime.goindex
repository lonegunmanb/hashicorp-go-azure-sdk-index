package github.com/hashicorp/go-azure-sdk/resource-manager/chaosstudio/2025-01-01/experimentexecutions
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ExperimentExecutionDetailsProperties) GetStoppedAtAsTime() (*time.Time, error) {
	if o.StoppedAt == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StoppedAt, "2006-01-02T15:04:05Z07:00")
}
