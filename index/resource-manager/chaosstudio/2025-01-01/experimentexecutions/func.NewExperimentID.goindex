package github.com/hashicorp/go-azure-sdk/resource-manager/chaosstudio/2025-01-01/experimentexecutions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewExperimentID(subscriptionId string, resourceGroupName string, experimentName string) ExperimentId {
	return ExperimentId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ExperimentName:    experimentName,
	}
}
