package github.com/hashicorp/go-azure-sdk/resource-manager/chaosstudio/2023-11-01/experiments
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
