package github.com/hashicorp/go-azure-sdk/resource-manager/chaosstudio/2023-11-01/capabilities
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCapabilityTypeID(input string) (*CapabilityTypeId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CapabilityTypeId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CapabilityTypeId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
