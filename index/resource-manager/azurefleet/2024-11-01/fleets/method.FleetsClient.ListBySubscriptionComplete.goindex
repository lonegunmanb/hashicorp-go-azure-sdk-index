package github.com/hashicorp/go-azure-sdk/resource-manager/azurefleet/2024-11-01/fleets
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
