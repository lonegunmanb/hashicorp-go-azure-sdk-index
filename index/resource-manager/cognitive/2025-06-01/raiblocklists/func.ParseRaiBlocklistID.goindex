package github.com/hashicorp/go-azure-sdk/resource-manager/cognitive/2025-06-01/raiblocklists
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseRaiBlocklistID(input string) (*RaiBlocklistId, error) {
	parser := resourceids.NewParserFromResourceIdType(&RaiBlocklistId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := RaiBlocklistId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
