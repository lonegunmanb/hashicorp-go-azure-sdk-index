package github.com/hashicorp/go-azure-sdk/resource-manager/cognitive/2025-06-01/cognitiveservicesaccounts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScenarioType(input string) (*ScenarioType, error) {
	vals := map[string]ScenarioType{
		"agent": ScenarioTypeAgent,
		"none":  ScenarioTypeNone,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScenarioType(input)
	return &out, nil
}
