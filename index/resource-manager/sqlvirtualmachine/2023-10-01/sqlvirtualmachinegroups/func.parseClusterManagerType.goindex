package github.com/hashicorp/go-azure-sdk/resource-manager/sqlvirtualmachine/2023-10-01/sqlvirtualmachinegroups
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseClusterManagerType(input string) (*ClusterManagerType, error) {
	vals := map[string]ClusterManagerType{
		"wsfc": ClusterManagerTypeWSFC,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ClusterManagerType(input)
	return &out, nil
}
