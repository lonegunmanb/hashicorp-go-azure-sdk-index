package github.com/hashicorp/go-azure-sdk/resource-manager/deviceregistry/2024-09-01-preview/schemas
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseFormat(input string) (*Format, error) {
	vals := map[string]Format{
		"delta/1.0":           FormatDeltaOnePointZero,
		"jsonschema/draft-07": FormatJsonSchemaDraftNegativeZeroSeven,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Format(input)
	return &out, nil
}
