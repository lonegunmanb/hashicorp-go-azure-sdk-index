package github.com/hashicorp/go-azure-sdk/resource-manager/deviceregistry/2024-09-01-preview/schemas
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSchemaType(input string) (*SchemaType, error) {
	vals := map[string]SchemaType{
		"messageschema": SchemaTypeMessageSchema,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SchemaType(input)
	return &out, nil
}
