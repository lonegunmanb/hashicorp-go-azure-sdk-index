package github.com/hashicorp/go-azure-sdk/resource-manager/deviceregistry/2024-09-01-preview/schemas
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSchemaID(subscriptionId string, resourceGroupName string, schemaRegistryName string, schemaName string) SchemaId {
	return SchemaId{
		SubscriptionId:     subscriptionId,
		ResourceGroupName:  resourceGroupName,
		SchemaRegistryName: schemaRegistryName,
		SchemaName:         schemaName,
	}
}
