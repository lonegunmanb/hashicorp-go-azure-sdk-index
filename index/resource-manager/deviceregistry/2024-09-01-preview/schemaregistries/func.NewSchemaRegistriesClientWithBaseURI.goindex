func NewSchemaRegistriesClientWithBaseURI(sdkApi sdkEnv.Api) (*SchemaRegistriesClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "schemaregistries", defaultApiVersion)
	if err != nil {
