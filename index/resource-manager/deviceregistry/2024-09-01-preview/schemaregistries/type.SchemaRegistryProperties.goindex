package github.com/hashicorp/go-azure-sdk/resource-manager/deviceregistry/2024-09-01-preview/schemaregistries

type SchemaRegistryProperties struct {
	Description                *string            `json:"description,omitempty"`
	DisplayName                *string            `json:"displayName,omitempty"`
	Namespace                  string             `json:"namespace"`
	ProvisioningState          *ProvisioningState `json:"provisioningState,omitempty"`
	StorageAccountContainerURL string             `json:"storageAccountContainerUrl"`
	Uuid                       *string            `json:"uuid,omitempty"`
}
