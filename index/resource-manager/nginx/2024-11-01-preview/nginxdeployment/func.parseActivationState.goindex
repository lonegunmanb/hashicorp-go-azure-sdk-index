package github.com/hashicorp/go-azure-sdk/resource-manager/nginx/2024-11-01-preview/nginxdeployment
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseActivationState(input string) (*ActivationState, error) {
	vals := map[string]ActivationState{
		"disabled": ActivationStateDisabled,
		"enabled":  ActivationStateEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ActivationState(input)
	return &out, nil
}
