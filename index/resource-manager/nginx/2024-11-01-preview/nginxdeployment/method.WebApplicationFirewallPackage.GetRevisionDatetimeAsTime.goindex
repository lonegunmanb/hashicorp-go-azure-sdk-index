package github.com/hashicorp/go-azure-sdk/resource-manager/nginx/2024-11-01-preview/nginxdeployment
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *WebApplicationFirewallPackage) GetRevisionDatetimeAsTime() (*time.Time, error) {
	return dates.ParseAsFormat(&o.RevisionDatetime, "2006-01-02T15:04:05Z07:00")
}
