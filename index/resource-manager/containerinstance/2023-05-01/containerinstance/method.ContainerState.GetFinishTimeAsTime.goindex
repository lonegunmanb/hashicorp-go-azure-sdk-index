package github.com/hashicorp/go-azure-sdk/resource-manager/containerinstance/2023-05-01/containerinstance
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ContainerState) GetFinishTimeAsTime() (*time.Time, error) {
	if o.FinishTime == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.FinishTime, "2006-01-02T15:04:05Z07:00")
}
