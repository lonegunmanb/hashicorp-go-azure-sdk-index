package github.com/hashicorp/go-azure-sdk/resource-manager/operationsmanagement/2015-11-01-preview/solution
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSolutionID(subscriptionId string, resourceGroupName string, solutionName string) SolutionId {
	return SolutionId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		SolutionName:      solutionName,
	}
}
