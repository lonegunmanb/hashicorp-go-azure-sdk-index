package github.com/hashicorp/go-azure-sdk/resource-manager/fluidrelay/2022-05-26/fluidrelayservers
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStorageSKU(input string) (*StorageSKU, error) {
	vals := map[string]StorageSKU{
		"basic":    StorageSKUBasic,
		"standard": StorageSKUStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := StorageSKU(input)
	return &out, nil
}
