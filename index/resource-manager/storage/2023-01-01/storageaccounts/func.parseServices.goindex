package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-01-01/storageaccounts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseServices(input string) (*Services, error) {
	vals := map[string]Services{
		"b": ServicesB,
		"f": ServicesF,
		"q": ServicesQ,
		"t": ServicesT,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Services(input)
	return &out, nil
}
