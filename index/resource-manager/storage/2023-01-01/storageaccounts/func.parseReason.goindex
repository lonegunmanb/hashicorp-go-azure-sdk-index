package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-01-01/storageaccounts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseReason(input string) (*Reason, error) {
	vals := map[string]Reason{
		"accountnameinvalid": ReasonAccountNameInvalid,
		"alreadyexists":      ReasonAlreadyExists,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Reason(input)
	return &out, nil
}
