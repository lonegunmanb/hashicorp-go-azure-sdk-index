package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-01-01/blobinventorypolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSchedule(input string) (*Schedule, error) {
	vals := map[string]Schedule{
		"daily":  ScheduleDaily,
		"weekly": ScheduleWeekly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Schedule(input)
	return &out, nil
}
