package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/storagetaskassignments
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIntervalUnit(input string) (*IntervalUnit, error) {
	vals := map[string]IntervalUnit{
		"days": IntervalUnitDays,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IntervalUnit(input)
	return &out, nil
}
