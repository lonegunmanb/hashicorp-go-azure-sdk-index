package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/storagetaskassignments
import (
	"encoding/json"
	"fmt"
	"strings"
)
func PossibleValuesForProvisioningState() []string {
	return []string{
		string(ProvisioningStateAccepted),
		string(ProvisioningStateCanceled),
		string(ProvisioningStateCreating),
		string(ProvisioningStateDeleting),
		string(ProvisioningStateFailed),
		string(ProvisioningStateSucceeded),
		string(ProvisioningStateValidateSubscriptionQuotaBegin),
		string(ProvisioningStateValidateSubscriptionQuotaEnd),
	}
}
