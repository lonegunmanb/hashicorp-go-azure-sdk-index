package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/storagetaskassignments
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *TriggerParameters) GetStartFromAsTime() (*time.Time, error) {
	if o.StartFrom == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StartFrom, "2006-01-02T15:04:05Z07:00")
}
