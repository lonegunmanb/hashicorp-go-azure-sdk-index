package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/blobinventorypolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseObjectType(input string) (*ObjectType, error) {
	vals := map[string]ObjectType{
		"blob":      ObjectTypeBlob,
		"container": ObjectTypeContainer,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ObjectType(input)
	return &out, nil
}
