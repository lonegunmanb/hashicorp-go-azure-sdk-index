package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/queueservice
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewQueueID(subscriptionId string, resourceGroupName string, storageAccountName string, queueName string) QueueId {
	return QueueId{
		SubscriptionId:     subscriptionId,
		ResourceGroupName:  resourceGroupName,
		StorageAccountName: storageAccountName,
		QueueName:          queueName,
	}
}
