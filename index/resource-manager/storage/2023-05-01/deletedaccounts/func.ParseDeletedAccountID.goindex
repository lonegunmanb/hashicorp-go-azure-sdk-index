package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/deletedaccounts
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseDeletedAccountID(input string) (*DeletedAccountId, error) {
	parser := resourceids.NewParserFromResourceIdType(&DeletedAccountId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := DeletedAccountId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
