package github.com/hashicorp/go-azure-sdk/resource-manager/storage/2023-05-01/tableservice
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewTableID(subscriptionId string, resourceGroupName string, storageAccountName string, tableName string) TableId {
	return TableId{
		SubscriptionId:     subscriptionId,
		ResourceGroupName:  resourceGroupName,
		StorageAccountName: storageAccountName,
		TableName:          tableName,
	}
}
