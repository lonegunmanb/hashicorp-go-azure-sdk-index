package github.com/hashicorp/go-azure-sdk/resource-manager/eventhub/2021-11-01/schemaregistry
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSchemaType(input string) (*SchemaType, error) {
	vals := map[string]SchemaType{
		"avro":    SchemaTypeAvro,
		"unknown": SchemaTypeUnknown,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SchemaType(input)
	return &out, nil
}
