package github.com/hashicorp/go-azure-sdk/resource-manager/marketplaceordering/2015-06-01/agreements
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewOfferPlanID(subscriptionId string, publisherId string, offerId string, planId string) OfferPlanId {
	return OfferPlanId{
		SubscriptionId: subscriptionId,
		PublisherId:    publisherId,
		OfferId:        offerId,
		PlanId:         planId,
	}
}
