package github.com/hashicorp/go-azure-sdk/resource-manager/netapp/2025-01-01/snapshots
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *SnapshotProperties) GetCreatedAsTime() (*time.Time, error) {
	if o.Created == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Created, "2006-01-02T15:04:05Z07:00")
}
