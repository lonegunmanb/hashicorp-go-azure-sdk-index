package github.com/hashicorp/go-azure-sdk/resource-manager/netapp/2025-03-01/snapshotpolicylistvolumes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSecurityStyle(input string) (*SecurityStyle, error) {
	vals := map[string]SecurityStyle{
		"ntfs": SecurityStyleNtfs,
		"unix": SecurityStyleUnix,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SecurityStyle(input)
	return &out, nil
}
