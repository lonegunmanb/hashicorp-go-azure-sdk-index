package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2024-04-01/fleetmembers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewMemberID(subscriptionId string, resourceGroupName string, fleetName string, memberName string) MemberId {
	return MemberId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		FleetName:         fleetName,
		MemberName:        memberName,
	}
}
