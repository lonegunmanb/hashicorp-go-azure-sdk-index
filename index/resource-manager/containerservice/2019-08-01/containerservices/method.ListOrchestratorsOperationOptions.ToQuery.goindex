func (o ListOrchestratorsOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.ResourceType != nil {
		out.Append("resource-type", fmt.Sprintf("%v", *o.ResourceType))
	}
	return &out
}
