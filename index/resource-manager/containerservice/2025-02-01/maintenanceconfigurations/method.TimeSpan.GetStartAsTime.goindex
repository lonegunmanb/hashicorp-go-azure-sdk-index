package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2025-02-01/maintenanceconfigurations
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *TimeSpan) GetStartAsTime() (*time.Time, error) {
	if o.Start == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Start, "2006-01-02T15:04:05Z07:00")
}
