package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2025-02-01/managedclusters
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCommandResultID(input string) (*CommandResultId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CommandResultId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CommandResultId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
