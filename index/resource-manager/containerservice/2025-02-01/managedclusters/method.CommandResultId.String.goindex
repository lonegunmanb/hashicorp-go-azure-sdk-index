package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2025-02-01/managedclusters
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id CommandResultId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Managed Cluster Name: %q", id.ManagedClusterName),
		fmt.Sprintf("Command: %q", id.CommandId),
	}
	return fmt.Sprintf("Command Result (%s)", strings.Join(components, "\n"))
}
