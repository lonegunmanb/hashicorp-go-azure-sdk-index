package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2025-02-01/managedclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNetworkPluginMode(input string) (*NetworkPluginMode, error) {
	vals := map[string]NetworkPluginMode{
		"overlay": NetworkPluginModeOverlay,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := NetworkPluginMode(input)
	return &out, nil
}
