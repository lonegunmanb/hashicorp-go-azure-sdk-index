package github.com/hashicorp/go-azure-sdk/resource-manager/containerservice/2025-02-01/agentpools
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseOSDiskType(input string) (*OSDiskType, error) {
	vals := map[string]OSDiskType{
		"ephemeral": OSDiskTypeEphemeral,
		"managed":   OSDiskTypeManaged,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := OSDiskType(input)
	return &out, nil
}
