package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/cloudexadatainfrastructures
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePatchingMode(input string) (*PatchingMode, error) {
	vals := map[string]PatchingMode{
		"nonrolling": PatchingModeNonRolling,
		"rolling":    PatchingModeRolling,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PatchingMode(input)
	return &out, nil
}
