package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/autonomousdatabaseversions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseWorkloadType(input string) (*WorkloadType, error) {
	vals := map[string]WorkloadType{
		"ajd":  WorkloadTypeAJD,
		"apex": WorkloadTypeAPEX,
		"dw":   WorkloadTypeDW,
		"oltp": WorkloadTypeOLTP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := WorkloadType(input)
	return &out, nil
}
