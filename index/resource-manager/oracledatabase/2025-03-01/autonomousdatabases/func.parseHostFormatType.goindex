package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/autonomousdatabases
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseHostFormatType(input string) (*HostFormatType, error) {
	vals := map[string]HostFormatType{
		"fqdn": HostFormatTypeFqdn,
		"ip":   HostFormatTypeIP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := HostFormatType(input)
	return &out, nil
}
