package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/autonomousdatabases
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSource(input string) (*Source, error) {
	vals := map[string]Source{
		"backupfromtimestamp":         SourceBackupFromTimestamp,
		"crossregiondisasterrecovery": SourceCrossRegionDisasterRecovery,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Source(input)
	return &out, nil
}
