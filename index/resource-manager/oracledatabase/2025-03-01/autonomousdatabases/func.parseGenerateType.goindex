package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/autonomousdatabases
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGenerateType(input string) (*GenerateType, error) {
	vals := map[string]GenerateType{
		"all":    GenerateTypeAll,
		"single": GenerateTypeSingle,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := GenerateType(input)
	return &out, nil
}
