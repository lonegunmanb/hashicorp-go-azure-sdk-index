package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/flexcomponents
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseHardwareType(input string) (*HardwareType, error) {
	vals := map[string]HardwareType{
		"cell":    HardwareTypeCELL,
		"compute": HardwareTypeCOMPUTE,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := HardwareType(input)
	return &out, nil
}
