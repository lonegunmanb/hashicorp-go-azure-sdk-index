package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/dnsprivatezones
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseZoneType(input string) (*ZoneType, error) {
	vals := map[string]ZoneType{
		"primary":   ZoneTypePrimary,
		"secondary": ZoneTypeSecondary,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ZoneType(input)
	return &out, nil
}
