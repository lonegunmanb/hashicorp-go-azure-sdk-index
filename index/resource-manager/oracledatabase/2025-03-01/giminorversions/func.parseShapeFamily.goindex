package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/giminorversions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseShapeFamily(input string) (*ShapeFamily, error) {
	vals := map[string]ShapeFamily{
		"exadata":  ShapeFamilyEXADATA,
		"exadb_xs": ShapeFamilyEXADBXS,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ShapeFamily(input)
	return &out, nil
}
