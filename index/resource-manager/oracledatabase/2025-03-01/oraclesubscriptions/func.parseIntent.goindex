package github.com/hashicorp/go-azure-sdk/resource-manager/oracledatabase/2025-03-01/oraclesubscriptions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIntent(input string) (*Intent, error) {
	vals := map[string]Intent{
		"reset":  IntentReset,
		"retain": IntentRetain,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Intent(input)
	return &out, nil
}
