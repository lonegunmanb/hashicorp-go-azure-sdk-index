func PossibleValuesForCloudAccountProvisioningState() []string {
	return []string{
		string(CloudAccountProvisioningStateAvailable),
		string(CloudAccountProvisioningStatePending),
		string(CloudAccountProvisioningStateProvisioning),
	}
}
