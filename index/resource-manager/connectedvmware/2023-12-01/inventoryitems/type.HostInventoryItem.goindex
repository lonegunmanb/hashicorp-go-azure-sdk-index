type HostInventoryItem struct {
	CpuModel          *string               `json:"cpuModel,omitempty"`
	MemorySizeGB      *int64                `json:"memorySizeGB,omitempty"`
	NumCoresPerSocket *int64                `json:"numCoresPerSocket,omitempty"`
