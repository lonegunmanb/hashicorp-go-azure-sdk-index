	Host                    *InventoryItemDetails    `json:"host,omitempty"`
	IPAddresses             *[]string                `json:"ipAddresses,omitempty"`
	InstanceUuid            *string                  `json:"instanceUuid,omitempty"`
	MaxSnapshots            *int64                   `json:"maxSnapshots,omitempty"`
