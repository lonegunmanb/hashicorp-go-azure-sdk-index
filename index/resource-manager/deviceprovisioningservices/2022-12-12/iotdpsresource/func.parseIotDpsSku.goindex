package github.com/hashicorp/go-azure-sdk/resource-manager/deviceprovisioningservices/2022-12-12/iotdpsresource
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIotDpsSku(input string) (*IotDpsSku, error) {
	vals := map[string]IotDpsSku{
		"s1": IotDpsSkuSOne,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IotDpsSku(input)
	return &out, nil
}
