package github.com/hashicorp/go-azure-sdk/resource-manager/iotcentral/2021-11-01-preview/apps
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAppSku(input string) (*AppSku, error) {
	vals := map[string]AppSku{
		"st1": AppSkuSTOne,
		"st2": AppSkuSTTwo,
		"st0": AppSkuSTZero,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AppSku(input)
	return &out, nil
}
