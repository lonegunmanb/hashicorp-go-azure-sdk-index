package github.com/hashicorp/go-azure-sdk/resource-manager/iotcentral/2021-11-01-preview/apps
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAppState(input string) (*AppState, error) {
	vals := map[string]AppState{
		"created":   AppStateCreated,
		"suspended": AppStateSuspended,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AppState(input)
	return &out, nil
}
