package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/billingrequest
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id BillingRequestId) Segments() []resourceids.Segment {
	return []resourceids.Segment{
		resourceids.StaticSegment("staticProviders", "providers", "providers"),
		resourceids.ResourceProviderSegment("staticMicrosoftBilling", "Microsoft.Billing", "Microsoft.Billing"),
		resourceids.StaticSegment("staticBillingRequests", "billingRequests", "billingRequests"),
		resourceids.UserSpecifiedSegment("billingRequestName", "billingRequestName"),
	}
}
