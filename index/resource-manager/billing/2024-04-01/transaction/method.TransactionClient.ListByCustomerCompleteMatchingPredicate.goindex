package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/transaction
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c TransactionClient) ListByCustomerCompleteMatchingPredicate(ctx context.Context, id BillingProfileCustomerId, options ListByCustomerOperationOptions, predicate TransactionOperationPredicate) (result ListByCustomerCompleteResult, err error) {
	items := make([]Transaction, 0)

	resp, err := c.ListByCustomer(ctx, id, options)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListByCustomerCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
