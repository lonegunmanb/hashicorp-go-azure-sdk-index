func PossibleValuesForCreditType() []string {
	return []string{
		string(CreditTypeAzureCreditOffer),
		string(CreditTypeAzureFreeCredit),
		string(CreditTypeOther),
		string(CreditTypeRefund),
		string(CreditTypeServiceInterruption),
	}
}
