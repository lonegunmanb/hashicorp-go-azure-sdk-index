func PossibleValuesForInvoiceStatus() []string {
	return []string{
		string(InvoiceStatusDue),
		string(InvoiceStatusLocked),
		string(InvoiceStatusOther),
		string(InvoiceStatusOverDue),
		string(InvoiceStatusPaid),
		string(InvoiceStatusVoid),
	}
}
