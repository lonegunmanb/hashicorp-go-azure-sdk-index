package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/invoice
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *InvoiceProperties) GetDueDateAsTime() (*time.Time, error) {
	if o.DueDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.DueDate, "2006-01-02T15:04:05Z07:00")
}
