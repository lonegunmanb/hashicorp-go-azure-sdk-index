package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/billingproperty
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o GetOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.IncludeBillingCountry != nil {
		out.Append("includeBillingCountry", fmt.Sprintf("%v", *o.IncludeBillingCountry))
	}
	if o.IncludeTransitionStatus != nil {
		out.Append("includeTransitionStatus", fmt.Sprintf("%v", *o.IncludeTransitionStatus))
	}
	return &out
}
