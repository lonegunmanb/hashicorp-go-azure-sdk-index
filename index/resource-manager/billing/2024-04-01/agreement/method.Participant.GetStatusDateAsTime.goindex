package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/agreement
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *Participant) GetStatusDateAsTime() (*time.Time, error) {
	if o.StatusDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StatusDate, "2006-01-02T15:04:05Z07:00")
}
