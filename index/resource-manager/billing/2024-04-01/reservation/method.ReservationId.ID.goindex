package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/reservation
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id ReservationId) ID() string {
	fmtString := "/providers/Microsoft.Billing/billingAccounts/%s/reservationOrders/%s/reservations/%s"
	return fmt.Sprintf(fmtString, id.BillingAccountName, id.ReservationOrderId, id.ReservationId)
}
