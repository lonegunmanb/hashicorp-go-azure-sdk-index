package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/billingprofile
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *PaymentTerm) GetEndDateAsTime() (*time.Time, error) {
	if o.EndDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.EndDate, "2006-01-02T15:04:05Z07:00")
}
