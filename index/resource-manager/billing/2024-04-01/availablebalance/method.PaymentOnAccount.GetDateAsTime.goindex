package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/availablebalance
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *PaymentOnAccount) GetDateAsTime() (*time.Time, error) {
	if o.Date == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Date, "2006-01-02T15:04:05Z07:00")
}
