package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/billingaccount
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSpendingLimit(input string) (*SpendingLimit, error) {
	vals := map[string]SpendingLimit{
		"off": SpendingLimitOff,
		"on":  SpendingLimitOn,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SpendingLimit(input)
	return &out, nil
}
