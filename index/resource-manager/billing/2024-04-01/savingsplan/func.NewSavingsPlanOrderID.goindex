func NewSavingsPlanOrderID(billingAccountName string, savingsPlanOrderId string) SavingsPlanOrderId {
	return SavingsPlanOrderId{
		BillingAccountName: billingAccountName,
		SavingsPlanOrderId: savingsPlanOrderId,
	}
}
