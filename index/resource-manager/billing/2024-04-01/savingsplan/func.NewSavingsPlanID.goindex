package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/savingsplan
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSavingsPlanID(billingAccountName string, savingsPlanOrderId string, savingsPlanId string) SavingsPlanId {
	return SavingsPlanId{
		BillingAccountName: billingAccountName,
		SavingsPlanOrderId: savingsPlanOrderId,
		SavingsPlanId:      savingsPlanId,
	}
}
