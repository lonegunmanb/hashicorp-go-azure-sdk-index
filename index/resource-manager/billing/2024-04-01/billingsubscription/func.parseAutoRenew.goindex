package github.com/hashicorp/go-azure-sdk/resource-manager/billing/2024-04-01/billingsubscription
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAutoRenew(input string) (*AutoRenew, error) {
	vals := map[string]AutoRenew{
		"off": AutoRenewOff,
		"on":  AutoRenewOn,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AutoRenew(input)
	return &out, nil
}
