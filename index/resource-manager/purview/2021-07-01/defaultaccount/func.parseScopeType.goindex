package github.com/hashicorp/go-azure-sdk/resource-manager/purview/2021-07-01/defaultaccount
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScopeType(input string) (*ScopeType, error) {
	vals := map[string]ScopeType{
		"subscription": ScopeTypeSubscription,
		"tenant":       ScopeTypeTenant,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScopeType(input)
	return &out, nil
}
