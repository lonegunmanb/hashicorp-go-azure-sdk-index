package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01-preview/managedinstances
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMetricType(input string) (*MetricType, error) {
	vals := map[string]MetricType{
		"cpu":      MetricTypeCpu,
		"dtu":      MetricTypeDtu,
		"duration": MetricTypeDuration,
		"io":       MetricTypeIo,
		"logio":    MetricTypeLogIo,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MetricType(input)
	return &out, nil
}
