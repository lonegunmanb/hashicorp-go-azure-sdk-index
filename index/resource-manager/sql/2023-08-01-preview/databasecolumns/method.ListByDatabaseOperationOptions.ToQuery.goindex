package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01-preview/databasecolumns
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o ListByDatabaseOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.Column != nil {
		out.Append("column", fmt.Sprintf("%v", *o.Column))
	}
	if o.OrderBy != nil {
		out.Append("orderBy", fmt.Sprintf("%v", *o.OrderBy))
	}
	if o.Schema != nil {
		out.Append("schema", fmt.Sprintf("%v", *o.Schema))
	}
	if o.Table != nil {
		out.Append("table", fmt.Sprintf("%v", *o.Table))
	}
	return &out
}
