package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01-preview/databaserecommendedactions
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *RecommendedActionProperties) GetValidSinceAsTime() (*time.Time, error) {
	if o.ValidSince == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ValidSince, "2006-01-02T15:04:05Z07:00")
}
