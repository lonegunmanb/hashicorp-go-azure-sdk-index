package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01-preview/distributedavailabilitygroups
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLinkRole(input string) (*LinkRole, error) {
	vals := map[string]LinkRole{
		"primary":   LinkRolePrimary,
		"secondary": LinkRoleSecondary,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LinkRole(input)
	return &out, nil
}
