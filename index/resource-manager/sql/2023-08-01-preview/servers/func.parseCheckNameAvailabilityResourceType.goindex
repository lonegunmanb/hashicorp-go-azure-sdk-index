	vals := map[string]CheckNameAvailabilityResourceType{
		"microsoft.sql/servers": CheckNameAvailabilityResourceTypeMicrosoftPointSqlServers,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
