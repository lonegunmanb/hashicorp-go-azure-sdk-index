package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01/manageddatabasesecurityevents
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *SecurityEventProperties) GetEventTimeAsTime() (*time.Time, error) {
	if o.EventTime == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.EventTime, "2006-01-02T15:04:05Z07:00")
}
