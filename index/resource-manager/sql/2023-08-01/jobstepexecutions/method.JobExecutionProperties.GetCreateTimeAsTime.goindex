package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01/jobstepexecutions
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *JobExecutionProperties) GetCreateTimeAsTime() (*time.Time, error) {
	if o.CreateTime == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.CreateTime, "2006-01-02T15:04:05Z07:00")
}
