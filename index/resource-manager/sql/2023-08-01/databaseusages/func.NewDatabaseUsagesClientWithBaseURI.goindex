func NewDatabaseUsagesClientWithBaseURI(sdkApi sdkEnv.Api) (*DatabaseUsagesClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "databaseusages", defaultApiVersion)
	if err != nil {
