package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01/databaserecommendedactions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIsRetryable(input string) (*IsRetryable, error) {
	vals := map[string]IsRetryable{
		"no":  IsRetryableNo,
		"yes": IsRetryableYes,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IsRetryable(input)
	return &out, nil
}
