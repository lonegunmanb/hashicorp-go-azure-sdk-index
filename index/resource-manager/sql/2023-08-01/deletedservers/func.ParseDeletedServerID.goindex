package github.com/hashicorp/go-azure-sdk/resource-manager/sql/2023-08-01/deletedservers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseDeletedServerID(input string) (*DeletedServerId, error) {
	parser := resourceids.NewParserFromResourceIdType(&DeletedServerId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := DeletedServerId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
