	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewSecurityPoliciesClientWithBaseURI(sdkApi sdkEnv.Api) (*SecurityPoliciesClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "securitypolicies", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating SecurityPoliciesClient: %+v", err)
	}

	return &SecurityPoliciesClient{
		Client: client,
	}, nil
}
