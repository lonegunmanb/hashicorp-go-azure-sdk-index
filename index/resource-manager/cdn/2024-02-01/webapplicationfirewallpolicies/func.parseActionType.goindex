package github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2024-02-01/webapplicationfirewallpolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseActionType(input string) (*ActionType, error) {
	vals := map[string]ActionType{
		"allow":    ActionTypeAllow,
		"block":    ActionTypeBlock,
		"log":      ActionTypeLog,
		"redirect": ActionTypeRedirect,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ActionType(input)
	return &out, nil
}
