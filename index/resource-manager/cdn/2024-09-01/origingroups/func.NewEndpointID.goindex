package github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2024-09-01/origingroups
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewEndpointID(subscriptionId string, resourceGroupName string, profileName string, endpointName string) EndpointId {
	return EndpointId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ProfileName:       profileName,
		EndpointName:      endpointName,
	}
}
