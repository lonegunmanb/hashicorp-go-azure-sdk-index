package github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2024-09-01/webapplicationfirewallpolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePolicyMode(input string) (*PolicyMode, error) {
	vals := map[string]PolicyMode{
		"detection":  PolicyModeDetection,
		"prevention": PolicyModePrevention,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PolicyMode(input)
	return &out, nil
}
