package github.com/hashicorp/go-azure-sdk/resource-manager/cdn/2025-06-01/loganalytics
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *MetricsResponseSeriesInlinedDataInlined) GetDateTimeAsTime() (*time.Time, error) {
	if o.DateTime == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.DateTime, "2006-01-02T15:04:05Z07:00")
}
