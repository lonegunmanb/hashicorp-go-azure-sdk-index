func PossibleValuesForSecretType() []string {
	return []string{
		string(SecretTypeAzureFirstPartyManagedCertificate),
		string(SecretTypeCustomerCertificate),
		string(SecretTypeManagedCertificate),
		string(SecretTypeURLSigningKey),
	}
}
