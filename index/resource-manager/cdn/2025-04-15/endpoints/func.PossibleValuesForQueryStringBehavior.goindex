func PossibleValuesForQueryStringBehavior() []string {
	return []string{
		string(QueryStringBehaviorExclude),
		string(QueryStringBehaviorExcludeAll),
		string(QueryStringBehaviorInclude),
		string(QueryStringBehaviorIncludeAll),
	}
}
