package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2025-01-13/gateways
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGatewayType(input string) (*GatewayType, error) {
	vals := map[string]GatewayType{
		"public": GatewayTypePublic,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := GatewayType(input)
	return &out, nil
}
