package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2025-01-13/agentversions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id OsTypeId) String() string {
	components := []string{
		fmt.Sprintf("Os Type Name: %q", id.OsTypeName),
	}
	return fmt.Sprintf("Os Type (%s)", strings.Join(components, "\n"))
}
