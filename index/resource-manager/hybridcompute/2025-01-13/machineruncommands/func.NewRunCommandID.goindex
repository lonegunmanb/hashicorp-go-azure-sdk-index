package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2025-01-13/machineruncommands
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewRunCommandID(subscriptionId string, resourceGroupName string, machineName string, runCommandName string) RunCommandId {
	return RunCommandId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		MachineName:       machineName,
		RunCommandName:    runCommandName,
	}
}
