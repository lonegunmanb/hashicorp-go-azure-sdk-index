package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2025-01-13/networkconfigurations
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *KeyDetails) GetRenewAfterAsTime() (*time.Time, error) {
	if o.RenewAfter == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.RenewAfter, "2006-01-02T15:04:05Z07:00")
}
