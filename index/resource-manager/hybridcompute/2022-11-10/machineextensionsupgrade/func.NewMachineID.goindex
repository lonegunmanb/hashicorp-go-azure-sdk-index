package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2022-11-10/machineextensionsupgrade
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewMachineID(subscriptionId string, resourceGroupName string, machineName string) MachineId {
	return MachineId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		MachineName:       machineName,
	}
}
