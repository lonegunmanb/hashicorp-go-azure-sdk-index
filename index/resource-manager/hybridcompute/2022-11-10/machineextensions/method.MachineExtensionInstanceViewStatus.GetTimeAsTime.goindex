package github.com/hashicorp/go-azure-sdk/resource-manager/hybridcompute/2022-11-10/machineextensions
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *MachineExtensionInstanceViewStatus) GetTimeAsTime() (*time.Time, error) {
	if o.Time == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Time, "2006-01-02T15:04:05Z07:00")
}
