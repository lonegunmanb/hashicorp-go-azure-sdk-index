package github.com/hashicorp/go-azure-sdk/resource-manager/customproviders/2018-09-01-preview/customresourceprovider
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseValidationType(input string) (*ValidationType, error) {
	vals := map[string]ValidationType{
		"swagger": ValidationTypeSwagger,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ValidationType(input)
	return &out, nil
}
