package github.com/hashicorp/go-azure-sdk/resource-manager/customproviders/2018-09-01-preview/associations
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScopedAssociationID(scope string, associationName string) ScopedAssociationId {
	return ScopedAssociationId{
		Scope:           scope,
		AssociationName: associationName,
	}
}
