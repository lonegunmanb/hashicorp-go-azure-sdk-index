package github.com/hashicorp/go-azure-sdk/resource-manager/migrate/2020-07-07/privatelinkresources
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateLinkResourceID(subscriptionId string, resourceGroupName string, masterSiteName string, privateLinkResourceName string) PrivateLinkResourceId {
	return PrivateLinkResourceId{
		SubscriptionId:          subscriptionId,
		ResourceGroupName:       resourceGroupName,
		MasterSiteName:          masterSiteName,
		PrivateLinkResourceName: privateLinkResourceName,
	}
}
