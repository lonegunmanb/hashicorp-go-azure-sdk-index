package github.com/hashicorp/go-azure-sdk/resource-manager/migrate/2020-07-07/privateendpointconnection
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateEndpointConnectionID(subscriptionId string, resourceGroupName string, masterSiteName string, privateEndpointConnectionName string) PrivateEndpointConnectionId {
	return PrivateEndpointConnectionId{
		SubscriptionId:                subscriptionId,
		ResourceGroupName:             resourceGroupName,
		MasterSiteName:                masterSiteName,
		PrivateEndpointConnectionName: privateEndpointConnectionName,
	}
}
