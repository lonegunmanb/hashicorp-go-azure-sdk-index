package github.com/hashicorp/go-azure-sdk/resource-manager/migrate/2020-07-07/hypervmachines
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *HyperVMachineProperties) GetGuestDetailsDiscoveryTimestampAsTime() (*time.Time, error) {
	if o.GuestDetailsDiscoveryTimestamp == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.GuestDetailsDiscoveryTimestamp, "2006-01-02T15:04:05Z07:00")
}
