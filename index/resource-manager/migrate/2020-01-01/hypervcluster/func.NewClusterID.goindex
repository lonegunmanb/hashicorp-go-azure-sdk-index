package github.com/hashicorp/go-azure-sdk/resource-manager/migrate/2020-01-01/hypervcluster
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewClusterID(subscriptionId string, resourceGroupName string, hyperVSiteName string, clusterName string) ClusterId {
	return ClusterId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		HyperVSiteName:    hyperVSiteName,
		ClusterName:       clusterName,
	}
}
