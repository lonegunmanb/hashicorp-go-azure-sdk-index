package github.com/hashicorp/go-azure-sdk/resource-manager/operationalinsights/2019-09-01/querypackqueries
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o QueriesSearchOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.IncludeBody != nil {
		out.Append("includeBody", fmt.Sprintf("%v", *o.IncludeBody))
	}
	if o.Top != nil {
		out.Append("$top", fmt.Sprintf("%v", *o.Top))
	}
	return &out
}
