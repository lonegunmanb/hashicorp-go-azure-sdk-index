package github.com/hashicorp/go-azure-sdk/resource-manager/operationalinsights/2025-02-01/workspaces
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ManagementGroupProperties) GetCreatedAsTime() (*time.Time, error) {
	if o.Created == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.Created, "2006-01-02T15:04:05Z07:00")
}
