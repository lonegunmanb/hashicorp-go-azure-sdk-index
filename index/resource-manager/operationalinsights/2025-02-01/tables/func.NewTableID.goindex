package github.com/hashicorp/go-azure-sdk/resource-manager/operationalinsights/2025-02-01/tables
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewTableID(subscriptionId string, resourceGroupName string, workspaceName string, tableName string) TableId {
	return TableId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		WorkspaceName:     workspaceName,
		TableName:         tableName,
	}
}
