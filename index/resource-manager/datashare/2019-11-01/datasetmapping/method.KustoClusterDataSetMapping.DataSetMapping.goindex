package github.com/hashicorp/go-azure-sdk/resource-manager/datashare/2019-11-01/datasetmapping
import (
	"encoding/json"
	"fmt"
)
func (s KustoClusterDataSetMapping) DataSetMapping() BaseDataSetMappingImpl {
	return BaseDataSetMappingImpl{
		Id:   s.Id,
		Kind: s.Kind,
		Name: s.Name,
		Type: s.Type,
	}
}
