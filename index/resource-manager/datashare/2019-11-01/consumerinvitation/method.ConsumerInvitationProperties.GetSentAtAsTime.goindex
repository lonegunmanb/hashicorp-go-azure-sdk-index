package github.com/hashicorp/go-azure-sdk/resource-manager/datashare/2019-11-01/consumerinvitation
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ConsumerInvitationProperties) GetSentAtAsTime() (*time.Time, error) {
	if o.SentAt == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.SentAt, "2006-01-02T15:04:05Z07:00")
}
