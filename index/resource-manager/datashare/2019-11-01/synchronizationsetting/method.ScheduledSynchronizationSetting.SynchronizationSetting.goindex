package github.com/hashicorp/go-azure-sdk/resource-manager/datashare/2019-11-01/synchronizationsetting
import (
	"encoding/json"
	"fmt"
)
func (s ScheduledSynchronizationSetting) SynchronizationSetting() BaseSynchronizationSettingImpl {
	return BaseSynchronizationSettingImpl{
		Id:   s.Id,
		Kind: s.Kind,
		Name: s.Name,
		Type: s.Type,
	}
}
