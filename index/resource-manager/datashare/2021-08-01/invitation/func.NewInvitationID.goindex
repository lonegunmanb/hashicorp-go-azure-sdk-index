package github.com/hashicorp/go-azure-sdk/resource-manager/datashare/2021-08-01/invitation
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewInvitationID(subscriptionId string, resourceGroupName string, accountName string, shareName string, invitationName string) InvitationId {
	return InvitationId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		AccountName:       accountName,
		ShareName:         shareName,
		InvitationName:    invitationName,
	}
}
