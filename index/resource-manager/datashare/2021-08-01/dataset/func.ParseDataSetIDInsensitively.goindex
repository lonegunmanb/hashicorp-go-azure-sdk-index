package github.com/hashicorp/go-azure-sdk/resource-manager/datashare/2021-08-01/dataset
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseDataSetIDInsensitively(input string) (*DataSetId, error) {
	parser := resourceids.NewParserFromResourceIdType(&DataSetId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := DataSetId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
