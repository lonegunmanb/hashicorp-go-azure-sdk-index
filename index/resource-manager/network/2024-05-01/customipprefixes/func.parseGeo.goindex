package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/customipprefixes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGeo(input string) (*Geo, error) {
	vals := map[string]Geo{
		"afri":    GeoAFRI,
		"apac":    GeoAPAC,
		"aq":      GeoAQ,
		"euro":    GeoEURO,
		"global":  GeoGLOBAL,
		"latam":   GeoLATAM,
		"me":      GeoME,
		"nam":     GeoNAM,
		"oceania": GeoOCEANIA,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Geo(input)
	return &out, nil
}
