package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/firewallpolicyrulecollectiongroups
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewFirewallPolicyID(subscriptionId string, resourceGroupName string, firewallPolicyName string) FirewallPolicyId {
	return FirewallPolicyId{
		SubscriptionId:     subscriptionId,
		ResourceGroupName:  resourceGroupName,
		FirewallPolicyName: firewallPolicyName,
	}
}
