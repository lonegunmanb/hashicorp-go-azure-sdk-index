package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/networkmanageractiveconnectivityconfigurations
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ActiveConnectivityConfiguration) SetCommitTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.CommitTime = &formatted
}
