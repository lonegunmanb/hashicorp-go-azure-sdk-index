package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/loadbalancers
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c LoadBalancersClient) InboundNatRulesDeleteThenPoll(ctx context.Context, id InboundNatRuleId) error {
	result, err := c.InboundNatRulesDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing InboundNatRulesDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after InboundNatRulesDelete: %+v", err)
	}

	return nil
}
