package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/loadbalancers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewProbeID(subscriptionId string, resourceGroupName string, loadBalancerName string, probeName string) ProbeId {
	return ProbeId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LoadBalancerName:  loadBalancerName,
		ProbeName:         probeName,
	}
}
