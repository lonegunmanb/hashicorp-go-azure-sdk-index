package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/vipswap
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCloudServiceIDInsensitively(input string) (*CloudServiceId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CloudServiceId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CloudServiceId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
