package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/vpngateways
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseVpnGatewayID(input string) (*VpnGatewayId, error) {
	parser := resourceids.NewParserFromResourceIdType(&VpnGatewayId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := VpnGatewayId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
