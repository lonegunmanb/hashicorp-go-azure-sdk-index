package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-05-01/webapplicationfirewallpolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSensitivityType(input string) (*SensitivityType, error) {
	vals := map[string]SensitivityType{
		"high":   SensitivityTypeHigh,
		"low":    SensitivityTypeLow,
		"medium": SensitivityTypeMedium,
		"none":   SensitivityTypeNone,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SensitivityType(input)
	return &out, nil
}
