package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/loadbalancers
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c LoadBalancersClient) LoadBalancerBackendAddressPoolsDeleteThenPoll(ctx context.Context, id LoadBalancerBackendAddressPoolId) error {
	result, err := c.LoadBalancerBackendAddressPoolsDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing LoadBalancerBackendAddressPoolsDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after LoadBalancerBackendAddressPoolsDelete: %+v", err)
	}

	return nil
}
