package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/vipswap
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSlotType(input string) (*SlotType, error) {
	vals := map[string]SlotType{
		"production": SlotTypeProduction,
		"staging":    SlotTypeStaging,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SlotType(input)
	return &out, nil
}
