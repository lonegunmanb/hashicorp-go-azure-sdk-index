func (o GetResiliencyInformationOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.AttemptRefresh != nil {
		out.Append("attemptRefresh", fmt.Sprintf("%v", *o.AttemptRefresh))
	}
	return &out
}
