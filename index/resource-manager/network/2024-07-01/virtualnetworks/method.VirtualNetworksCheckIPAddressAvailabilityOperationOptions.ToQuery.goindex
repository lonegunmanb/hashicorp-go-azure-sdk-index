package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/virtualnetworks
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o VirtualNetworksCheckIPAddressAvailabilityOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.IPAddress != nil {
		out.Append("ipAddress", fmt.Sprintf("%v", *o.IPAddress))
	}
	return &out
}
