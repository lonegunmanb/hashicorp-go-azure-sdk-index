package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/ipampools
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewIPamPoolsClientWithBaseURI(sdkApi sdkEnv.Api) (*IPamPoolsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "ipampools", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating IPamPoolsClient: %+v", err)
	}

	return &IPamPoolsClient{
		Client: client,
	}, nil
}
