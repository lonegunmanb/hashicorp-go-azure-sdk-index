package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/ipampools
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIPType(input string) (*IPType, error) {
	vals := map[string]IPType{
		"ipv4": IPTypeIPvFour,
		"ipv6": IPTypeIPvSix,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IPType(input)
	return &out, nil
}
