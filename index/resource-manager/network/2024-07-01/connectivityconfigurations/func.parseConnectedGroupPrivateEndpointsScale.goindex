package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/connectivityconfigurations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseConnectedGroupPrivateEndpointsScale(input string) (*ConnectedGroupPrivateEndpointsScale, error) {
	vals := map[string]ConnectedGroupPrivateEndpointsScale{
		"highscale": ConnectedGroupPrivateEndpointsScaleHighScale,
		"standard":  ConnectedGroupPrivateEndpointsScaleStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ConnectedGroupPrivateEndpointsScale(input)
	return &out, nil
}
