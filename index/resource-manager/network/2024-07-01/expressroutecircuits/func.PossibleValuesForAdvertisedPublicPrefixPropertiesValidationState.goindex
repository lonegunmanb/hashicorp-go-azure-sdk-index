func PossibleValuesForAdvertisedPublicPrefixPropertiesValidationState() []string {
	return []string{
		string(AdvertisedPublicPrefixPropertiesValidationStateAsnValidationFailed),
		string(AdvertisedPublicPrefixPropertiesValidationStateCertificateMissingInRoutingRegistry),
		string(AdvertisedPublicPrefixPropertiesValidationStateConfigured),
		string(AdvertisedPublicPrefixPropertiesValidationStateConfiguring),
		string(AdvertisedPublicPrefixPropertiesValidationStateInvalidSignatureEncoding),
		string(AdvertisedPublicPrefixPropertiesValidationStateManualValidationNeeded),
		string(AdvertisedPublicPrefixPropertiesValidationStateNotConfigured),
		string(AdvertisedPublicPrefixPropertiesValidationStateSignatureVerificationFailed),
		string(AdvertisedPublicPrefixPropertiesValidationStateValidationFailed),
		string(AdvertisedPublicPrefixPropertiesValidationStateValidationNeeded),
	}
}
