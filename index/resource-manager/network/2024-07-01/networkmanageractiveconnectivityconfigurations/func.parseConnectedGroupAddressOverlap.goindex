package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-07-01/networkmanageractiveconnectivityconfigurations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseConnectedGroupAddressOverlap(input string) (*ConnectedGroupAddressOverlap, error) {
	vals := map[string]ConnectedGroupAddressOverlap{
		"allowed":    ConnectedGroupAddressOverlapAllowed,
		"disallowed": ConnectedGroupAddressOverlapDisallowed,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ConnectedGroupAddressOverlap(input)
	return &out, nil
}
