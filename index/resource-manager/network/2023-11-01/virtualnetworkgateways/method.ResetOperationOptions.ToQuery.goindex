func (o ResetOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.GatewayVip != nil {
		out.Append("gatewayVip", fmt.Sprintf("%v", *o.GatewayVip))
	}
	return &out
}
