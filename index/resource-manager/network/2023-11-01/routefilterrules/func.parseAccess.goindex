package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/routefilterrules
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAccess(input string) (*Access, error) {
	vals := map[string]Access{
		"allow": AccessAllow,
		"deny":  AccessDeny,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Access(input)
	return &out, nil
}
