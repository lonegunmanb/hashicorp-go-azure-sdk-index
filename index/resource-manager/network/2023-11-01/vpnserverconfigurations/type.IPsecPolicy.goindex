type IPsecPolicy struct {
	DhGroup             DhGroup         `json:"dhGroup"`
	IPsecEncryption     IPsecEncryption `json:"ipsecEncryption"`
	IPsecIntegrity      IPsecIntegrity  `json:"ipsecIntegrity"`
	IkeEncryption       IkeEncryption   `json:"ikeEncryption"`
