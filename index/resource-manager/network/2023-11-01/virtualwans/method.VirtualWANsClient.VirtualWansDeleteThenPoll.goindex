package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/virtualwans
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c VirtualWANsClient) VirtualWansDeleteThenPoll(ctx context.Context, id VirtualWANId) error {
	result, err := c.VirtualWansDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing VirtualWansDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after VirtualWansDelete: %+v", err)
	}

	return nil
}
