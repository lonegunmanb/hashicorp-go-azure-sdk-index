package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/virtualnetworkgatewayconnections
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVpnType(input string) (*VpnType, error) {
	vals := map[string]VpnType{
		"policybased": VpnTypePolicyBased,
		"routebased":  VpnTypeRouteBased,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VpnType(input)
	return &out, nil
}
