package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/networkmanageractiveconnectivityconfigurations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIsGlobal(input string) (*IsGlobal, error) {
	vals := map[string]IsGlobal{
		"false": IsGlobalFalse,
		"true":  IsGlobalTrue,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IsGlobal(input)
	return &out, nil
}
