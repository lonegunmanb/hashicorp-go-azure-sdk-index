package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/firewallpolicies
import (
	"encoding/json"
	"fmt"
)
func (s ApplicationRule) FirewallPolicyRule() BaseFirewallPolicyRuleImpl {
	return BaseFirewallPolicyRuleImpl{
		Description: s.Description,
		Name:        s.Name,
		RuleType:    s.RuleType,
	}
}
