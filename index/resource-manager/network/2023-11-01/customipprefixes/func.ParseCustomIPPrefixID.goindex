package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-11-01/customipprefixes
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseCustomIPPrefixID(input string) (*CustomIPPrefixId, error) {
	parser := resourceids.NewParserFromResourceIdType(&CustomIPPrefixId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := CustomIPPrefixId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
