func (s NatRule) FirewallPolicyRule() BaseFirewallPolicyRuleImpl {
	return BaseFirewallPolicyRuleImpl{
		Description: s.Description,
		Name:        s.Name,
		RuleType:    s.RuleType,
	}
}
