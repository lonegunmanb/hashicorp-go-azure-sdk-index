package github.com/hashicorp/go-azure-sdk/resource-manager/network/2024-01-01/expressroutecrossconnectionarptable
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParsePeeringArpTableID(input string) (*PeeringArpTableId, error) {
	parser := resourceids.NewParserFromResourceIdType(&PeeringArpTableId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := PeeringArpTableId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
