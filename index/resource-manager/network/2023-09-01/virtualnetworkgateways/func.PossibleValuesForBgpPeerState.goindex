func PossibleValuesForBgpPeerState() []string {
	return []string{
		string(BgpPeerStateConnected),
		string(BgpPeerStateConnecting),
		string(BgpPeerStateIdle),
		string(BgpPeerStateStopped),
		string(BgpPeerStateUnknown),
	}
}
