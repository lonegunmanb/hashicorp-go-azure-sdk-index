package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/virtualwans
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNextStep(input string) (*NextStep, error) {
	vals := map[string]NextStep{
		"continue":  NextStepContinue,
		"terminate": NextStepTerminate,
		"unknown":   NextStepUnknown,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := NextStep(input)
	return &out, nil
}
