package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/bastionhosts
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseBastionHostIDInsensitively(input string) (*BastionHostId, error) {
	parser := resourceids.NewParserFromResourceIdType(&BastionHostId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := BastionHostId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
