package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/packetcaptures
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePcProtocol(input string) (*PcProtocol, error) {
	vals := map[string]PcProtocol{
		"any": PcProtocolAny,
		"tcp": PcProtocolTCP,
		"udp": PcProtocolUDP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PcProtocol(input)
	return &out, nil
}
