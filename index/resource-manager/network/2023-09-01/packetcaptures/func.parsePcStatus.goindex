package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/packetcaptures
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePcStatus(input string) (*PcStatus, error) {
	vals := map[string]PcStatus{
		"error":      PcStatusError,
		"notstarted": PcStatusNotStarted,
		"running":    PcStatusRunning,
		"stopped":    PcStatusStopped,
		"unknown":    PcStatusUnknown,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PcStatus(input)
	return &out, nil
}
