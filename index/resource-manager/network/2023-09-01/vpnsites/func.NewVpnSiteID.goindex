package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/vpnsites
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewVpnSiteID(subscriptionId string, resourceGroupName string, vpnSiteName string) VpnSiteId {
	return VpnSiteId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		VpnSiteName:       vpnSiteName,
	}
}
