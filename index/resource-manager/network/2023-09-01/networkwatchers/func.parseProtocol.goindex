package github.com/hashicorp/go-azure-sdk/resource-manager/network/2023-09-01/networkwatchers
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseProtocol(input string) (*Protocol, error) {
	vals := map[string]Protocol{
		"http":  ProtocolHTTP,
		"https": ProtocolHTTPS,
		"icmp":  ProtocolIcmp,
		"tcp":   ProtocolTcp,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Protocol(input)
	return &out, nil
}
