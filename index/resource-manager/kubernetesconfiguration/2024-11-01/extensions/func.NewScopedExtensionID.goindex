package github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2024-11-01/extensions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScopedExtensionID(scope string, extensionName string) ScopedExtensionId {
	return ScopedExtensionId{
		Scope:         scope,
		ExtensionName: extensionName,
	}
}
