package github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2024-11-01/fluxconfiguration
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *FluxConfigurationProperties) SetStatusUpdatedAtAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.StatusUpdatedAt = &formatted
}
