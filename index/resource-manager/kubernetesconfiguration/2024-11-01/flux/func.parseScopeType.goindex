package github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2024-11-01/flux
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScopeType(input string) (*ScopeType, error) {
	vals := map[string]ScopeType{
		"cluster":   ScopeTypeCluster,
		"namespace": ScopeTypeNamespace,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScopeType(input)
	return &out, nil
}
