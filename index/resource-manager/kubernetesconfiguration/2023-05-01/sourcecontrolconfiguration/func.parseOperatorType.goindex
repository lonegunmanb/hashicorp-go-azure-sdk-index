package github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2023-05-01/sourcecontrolconfiguration
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseOperatorType(input string) (*OperatorType, error) {
	vals := map[string]OperatorType{
		"flux": OperatorTypeFlux,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := OperatorType(input)
	return &out, nil
}
