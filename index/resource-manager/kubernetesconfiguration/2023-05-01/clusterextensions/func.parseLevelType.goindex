package github.com/hashicorp/go-azure-sdk/resource-manager/kubernetesconfiguration/2023-05-01/clusterextensions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLevelType(input string) (*LevelType, error) {
	vals := map[string]LevelType{
		"error":       LevelTypeError,
		"information": LevelTypeInformation,
		"warning":     LevelTypeWarning,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LevelType(input)
	return &out, nil
}
