package github.com/hashicorp/go-azure-sdk/resource-manager/quota/2025-07-15/groupquotassubscriptions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSubscriptionID(managementGroupId string, groupQuotaName string, subscriptionId string) SubscriptionId {
	return SubscriptionId{
		ManagementGroupId: managementGroupId,
		GroupQuotaName:    groupQuotaName,
		SubscriptionId:    subscriptionId,
	}
}
