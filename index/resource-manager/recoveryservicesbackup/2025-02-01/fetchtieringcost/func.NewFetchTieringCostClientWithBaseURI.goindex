package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/fetchtieringcost
import "github.com/Azure/go-autorest/autorest"
func NewFetchTieringCostClientWithBaseURI(endpoint string) FetchTieringCostClient {
	return FetchTieringCostClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
