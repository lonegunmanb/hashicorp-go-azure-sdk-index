package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/backupprotectionintent
import "github.com/Azure/go-autorest/autorest"
func NewBackupProtectionIntentClientWithBaseURI(endpoint string) BackupProtectionIntentClient {
	return BackupProtectionIntentClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
