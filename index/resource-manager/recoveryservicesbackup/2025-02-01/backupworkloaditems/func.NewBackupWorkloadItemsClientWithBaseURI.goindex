package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/backupworkloaditems
import "github.com/Azure/go-autorest/autorest"
func NewBackupWorkloadItemsClientWithBaseURI(endpoint string) BackupWorkloadItemsClient {
	return BackupWorkloadItemsClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
