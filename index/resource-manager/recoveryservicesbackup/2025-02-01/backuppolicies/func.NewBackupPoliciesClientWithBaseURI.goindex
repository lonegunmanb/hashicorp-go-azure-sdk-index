package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/backuppolicies
import "github.com/Azure/go-autorest/autorest"
func NewBackupPoliciesClientWithBaseURI(endpoint string) BackupPoliciesClient {
	return BackupPoliciesClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
