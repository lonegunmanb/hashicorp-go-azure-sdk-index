package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/validateoperation
import "github.com/Azure/go-autorest/autorest"
func NewValidateOperationClientWithBaseURI(endpoint string) ValidateOperationClient {
	return ValidateOperationClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
