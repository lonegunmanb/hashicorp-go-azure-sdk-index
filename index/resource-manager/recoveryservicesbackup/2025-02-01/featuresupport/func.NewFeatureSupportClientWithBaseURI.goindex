package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/featuresupport
import "github.com/Azure/go-autorest/autorest"
func NewFeatureSupportClientWithBaseURI(endpoint string) FeatureSupportClient {
	return FeatureSupportClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
