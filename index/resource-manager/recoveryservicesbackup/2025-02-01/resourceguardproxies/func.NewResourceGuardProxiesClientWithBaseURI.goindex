package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2025-02-01/resourceguardproxies
import "github.com/Azure/go-autorest/autorest"
func NewResourceGuardProxiesClientWithBaseURI(endpoint string) ResourceGuardProxiesClient {
	return ResourceGuardProxiesClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
