package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/resourceguardproxy
import "github.com/Azure/go-autorest/autorest"
func NewResourceGuardProxyClientWithBaseURI(endpoint string) ResourceGuardProxyClient {
	return ResourceGuardProxyClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
