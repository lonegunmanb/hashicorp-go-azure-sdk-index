package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/backupusagesummaries
import "github.com/Azure/go-autorest/autorest"
func NewBackupUsageSummariesClientWithBaseURI(endpoint string) BackupUsageSummariesClient {
	return BackupUsageSummariesClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
