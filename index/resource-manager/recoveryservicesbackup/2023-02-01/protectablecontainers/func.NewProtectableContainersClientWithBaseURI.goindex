package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/protectablecontainers
import "github.com/Azure/go-autorest/autorest"
func NewProtectableContainersClientWithBaseURI(endpoint string) ProtectableContainersClient {
	return ProtectableContainersClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
