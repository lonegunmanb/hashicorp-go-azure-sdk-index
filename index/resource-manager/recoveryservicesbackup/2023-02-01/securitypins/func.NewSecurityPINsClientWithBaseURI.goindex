package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/securitypins
import "github.com/Azure/go-autorest/autorest"
func NewSecurityPINsClientWithBaseURI(endpoint string) SecurityPINsClient {
	return SecurityPINsClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
