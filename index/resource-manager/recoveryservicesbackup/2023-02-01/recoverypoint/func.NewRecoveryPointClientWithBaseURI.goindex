package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/recoverypoint
import "github.com/Azure/go-autorest/autorest"
func NewRecoveryPointClientWithBaseURI(endpoint string) RecoveryPointClient {
	return RecoveryPointClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
