package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2023-02-01/jobcancellations
import "github.com/Azure/go-autorest/autorest"
func NewJobCancellationsClientWithBaseURI(endpoint string) JobCancellationsClient {
	return JobCancellationsClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
