func PossibleValuesForSoftDeleteFeatureState() []string {
	return []string{
		string(SoftDeleteFeatureStateAlwaysON),
		string(SoftDeleteFeatureStateDisabled),
		string(SoftDeleteFeatureStateEnabled),
		string(SoftDeleteFeatureStateInvalid),
	}
}
