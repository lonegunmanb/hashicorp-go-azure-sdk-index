package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/protectionintent
import "github.com/Azure/go-autorest/autorest"
func NewProtectionIntentClientWithBaseURI(endpoint string) ProtectionIntentClient {
	return ProtectionIntentClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
