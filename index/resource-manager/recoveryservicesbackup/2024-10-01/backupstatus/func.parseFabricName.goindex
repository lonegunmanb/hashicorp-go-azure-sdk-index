package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/backupstatus
import (
	"strings"
)
func parseFabricName(input string) (*FabricName, error) {
	vals := map[string]FabricName{
		"azure":   FabricNameAzure,
		"invalid": FabricNameInvalid,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := FabricName(input)
	return &out, nil
}
