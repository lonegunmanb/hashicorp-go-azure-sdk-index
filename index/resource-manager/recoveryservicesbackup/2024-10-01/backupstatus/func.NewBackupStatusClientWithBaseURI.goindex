package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/backupstatus
import "github.com/Azure/go-autorest/autorest"
func NewBackupStatusClientWithBaseURI(endpoint string) BackupStatusClient {
	return BackupStatusClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
