package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/backupengines
import "github.com/Azure/go-autorest/autorest"
func NewBackupEnginesClientWithBaseURI(endpoint string) BackupEnginesClient {
	return BackupEnginesClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
