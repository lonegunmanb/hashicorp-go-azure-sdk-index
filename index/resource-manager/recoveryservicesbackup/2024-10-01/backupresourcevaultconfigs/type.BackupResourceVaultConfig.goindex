	SoftDeleteFeatureState           *SoftDeleteFeatureState `json:"softDeleteFeatureState,omitempty"`
	SoftDeleteRetentionPeriodInDays  *int64                  `json:"softDeleteRetentionPeriodInDays,omitempty"`
