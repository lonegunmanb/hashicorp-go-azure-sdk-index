package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/recoverypoints
import "github.com/Azure/go-autorest/autorest"
func NewRecoveryPointsClientWithBaseURI(endpoint string) RecoveryPointsClient {
	return RecoveryPointsClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
