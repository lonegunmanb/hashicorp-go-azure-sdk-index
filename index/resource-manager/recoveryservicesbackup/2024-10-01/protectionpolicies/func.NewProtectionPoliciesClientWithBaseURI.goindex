package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/protectionpolicies
import "github.com/Azure/go-autorest/autorest"
func NewProtectionPoliciesClientWithBaseURI(endpoint string) ProtectionPoliciesClient {
	return ProtectionPoliciesClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
