package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/protectioncontainers
import "github.com/Azure/go-autorest/autorest"
func NewProtectionContainersClientWithBaseURI(endpoint string) ProtectionContainersClient {
	return ProtectionContainersClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
