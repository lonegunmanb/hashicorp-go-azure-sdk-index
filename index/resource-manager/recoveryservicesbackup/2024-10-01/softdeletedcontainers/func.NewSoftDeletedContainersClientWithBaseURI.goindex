package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicesbackup/2024-10-01/softdeletedcontainers
import "github.com/Azure/go-autorest/autorest"
func NewSoftDeletedContainersClientWithBaseURI(endpoint string) SoftDeletedContainersClient {
	return SoftDeletedContainersClient{
		Client:  autorest.NewClientWithUserAgent(userAgent()),
		baseUri: endpoint,
	}
}
