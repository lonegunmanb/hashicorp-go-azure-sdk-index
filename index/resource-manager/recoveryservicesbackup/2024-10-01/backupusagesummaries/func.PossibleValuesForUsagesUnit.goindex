import (
	"strings"
)
func PossibleValuesForUsagesUnit() []string {
	return []string{
		string(UsagesUnitBytes),
		string(UsagesUnitBytesPerSecond),
		string(UsagesUnitCount),
		string(UsagesUnitCountPerSecond),
		string(UsagesUnitPercent),
		string(UsagesUnitSeconds),
	}
}
