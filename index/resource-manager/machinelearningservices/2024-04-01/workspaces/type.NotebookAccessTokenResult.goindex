package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/workspaces

type NotebookAccessTokenResult struct {
	AccessToken        *string `json:"accessToken,omitempty"`
	ExpiresIn          *int64  `json:"expiresIn,omitempty"`
	HostName           *string `json:"hostName,omitempty"`
	NotebookResourceId *string `json:"notebookResourceId,omitempty"`
	PublicDns          *string `json:"publicDns,omitempty"`
	RefreshToken       *string `json:"refreshToken,omitempty"`
	Scope              *string `json:"scope,omitempty"`
	TokenType          *string `json:"tokenType,omitempty"`
}
