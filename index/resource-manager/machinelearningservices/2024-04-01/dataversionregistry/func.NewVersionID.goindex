package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/dataversionregistry
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewVersionID(subscriptionId string, resourceGroupName string, registryName string, dataName string, versionName string) VersionId {
	return VersionId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		RegistryName:      registryName,
		DataName:          dataName,
		VersionName:       versionName,
	}
}
