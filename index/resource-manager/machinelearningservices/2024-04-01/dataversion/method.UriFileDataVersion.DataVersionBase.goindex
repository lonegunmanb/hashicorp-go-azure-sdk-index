package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/dataversion
import (
	"encoding/json"
	"fmt"
)
func (s UriFileDataVersion) DataVersionBase() BaseDataVersionBaseImpl {
	return BaseDataVersionBaseImpl{
		DataType:    s.DataType,
		DataUri:     s.DataUri,
		Description: s.Description,
		IsAnonymous: s.IsAnonymous,
		IsArchived:  s.IsArchived,
		Properties:  s.Properties,
		Tags:        s.Tags,
	}
}
