package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/job
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNodesValueType(input string) (*NodesValueType, error) {
	vals := map[string]NodesValueType{
		"all": NodesValueTypeAll,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := NodesValueType(input)
	return &out, nil
}
