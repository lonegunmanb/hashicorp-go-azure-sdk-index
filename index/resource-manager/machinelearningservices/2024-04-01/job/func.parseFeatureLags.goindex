package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/job
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseFeatureLags(input string) (*FeatureLags, error) {
	vals := map[string]FeatureLags{
		"auto": FeatureLagsAuto,
		"none": FeatureLagsNone,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := FeatureLags(input)
	return &out, nil
}
