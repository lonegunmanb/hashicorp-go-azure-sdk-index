package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/operationalizationclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScheduleStatus(input string) (*ScheduleStatus, error) {
	vals := map[string]ScheduleStatus{
		"disabled": ScheduleStatusDisabled,
		"enabled":  ScheduleStatusEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScheduleStatus(input)
	return &out, nil
}
