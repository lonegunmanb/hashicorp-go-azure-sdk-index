package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/operationalizationclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMountAction(input string) (*MountAction, error) {
	vals := map[string]MountAction{
		"mount":   MountActionMount,
		"unmount": MountActionUnmount,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MountAction(input)
	return &out, nil
}
