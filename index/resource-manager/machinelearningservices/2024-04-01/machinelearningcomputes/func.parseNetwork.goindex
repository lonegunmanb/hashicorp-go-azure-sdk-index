package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2024-04-01/machinelearningcomputes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNetwork(input string) (*Network, error) {
	vals := map[string]Network{
		"bridge": NetworkBridge,
		"host":   NetworkHost,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Network(input)
	return &out, nil
}
