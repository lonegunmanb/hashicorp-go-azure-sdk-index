package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/dataversion
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDataType(input string) (*DataType, error) {
	vals := map[string]DataType{
		"mltable":    DataTypeMltable,
		"uri_file":   DataTypeUriFile,
		"uri_folder": DataTypeUriFolder,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DataType(input)
	return &out, nil
}
