package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/onlinedeployment
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseScaleType(input string) (*ScaleType, error) {
	vals := map[string]ScaleType{
		"default":           ScaleTypeDefault,
		"targetutilization": ScaleTypeTargetUtilization,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ScaleType(input)
	return &out, nil
}
