package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/machinelearningcomputes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAutosave(input string) (*Autosave, error) {
	vals := map[string]Autosave{
		"local":  AutosaveLocal,
		"none":   AutosaveNone,
		"remote": AutosaveRemote,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Autosave(input)
	return &out, nil
}
