func PossibleValuesForNodeState() []string {
	return []string{
		string(NodeStateIdle),
		string(NodeStateLeaving),
		string(NodeStatePreempted),
		string(NodeStatePreparing),
		string(NodeStateRunning),
		string(NodeStateUnusable),
	}
}
