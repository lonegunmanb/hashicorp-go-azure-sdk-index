package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/machinelearningcomputes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNodeState(input string) (*NodeState, error) {
	vals := map[string]NodeState{
		"idle":      NodeStateIdle,
		"leaving":   NodeStateLeaving,
		"preempted": NodeStatePreempted,
		"preparing": NodeStatePreparing,
		"running":   NodeStateRunning,
		"unusable":  NodeStateUnusable,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := NodeState(input)
	return &out, nil
}
