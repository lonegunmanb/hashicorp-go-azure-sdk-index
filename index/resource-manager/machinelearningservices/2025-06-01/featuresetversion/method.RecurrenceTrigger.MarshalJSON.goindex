func (s RecurrenceTrigger) MarshalJSON() ([]byte, error) {
	type wrapper RecurrenceTrigger
	wrapped := wrapper(s)
	encoded, err := json.Marshal(wrapped)
	if err != nil {
		return nil, fmt.Errorf("marshaling RecurrenceTrigger: %+v", err)
	}

	var decoded map[string]interface{}
	if err = json.Unmarshal(encoded, &decoded); err != nil {
		return nil, fmt.Errorf("unmarshaling RecurrenceTrigger: %+v", err)
	}

	decoded["triggerType"] = "Recurrence"

	encoded, err = json.Marshal(decoded)
	if err != nil {
		return nil, fmt.Errorf("re-marshaling RecurrenceTrigger: %+v", err)
	}

	return encoded, nil
}
