func (s RecurrenceTrigger) TriggerBase() BaseTriggerBaseImpl {
	return BaseTriggerBaseImpl{
		EndTime:     s.EndTime,
		StartTime:   s.StartTime,
		TimeZone:    s.TimeZone,
		TriggerType: s.TriggerType,
	}
}
