package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/codecontainer
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewCodeID(subscriptionId string, resourceGroupName string, workspaceName string, codeName string) CodeId {
	return CodeId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		WorkspaceName:     workspaceName,
		CodeName:          codeName,
	}
}
