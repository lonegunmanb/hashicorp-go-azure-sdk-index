package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/datastore
import (
	"encoding/json"
	"fmt"
)
func (s AzureDataLakeGen1Datastore) Datastore() BaseDatastoreImpl {
	return BaseDatastoreImpl{
		Credentials:   s.Credentials,
		DatastoreType: s.DatastoreType,
		Description:   s.Description,
		IsDefault:     s.IsDefault,
		Properties:    s.Properties,
		Tags:          s.Tags,
	}
}
