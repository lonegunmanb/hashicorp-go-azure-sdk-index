func PossibleValuesForCredentialsType() []string {
	return []string{
		string(CredentialsTypeAccountKey),
		string(CredentialsTypeCertificate),
		string(CredentialsTypeNone),
		string(CredentialsTypeSas),
		string(CredentialsTypeServicePrincipal),
	}
}
