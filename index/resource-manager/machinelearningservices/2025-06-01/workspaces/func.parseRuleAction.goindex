package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/workspaces
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRuleAction(input string) (*RuleAction, error) {
	vals := map[string]RuleAction{
		"allow": RuleActionAllow,
		"deny":  RuleActionDeny,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RuleAction(input)
	return &out, nil
}
