package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/workspaces
import (
	"encoding/json"
	"fmt"
)
func (s FqdnOutboundRule) OutboundRule() BaseOutboundRuleImpl {
	return BaseOutboundRuleImpl{
		Category:         s.Category,
		ErrorInformation: s.ErrorInformation,
		ParentRuleNames:  s.ParentRuleNames,
		Status:           s.Status,
		Type:             s.Type,
	}
}
