package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/workspaceprivateendpointconnections
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuTier(input string) (*SkuTier, error) {
	vals := map[string]SkuTier{
		"basic":    SkuTierBasic,
		"free":     SkuTierFree,
		"premium":  SkuTierPremium,
		"standard": SkuTierStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuTier(input)
	return &out, nil
}
