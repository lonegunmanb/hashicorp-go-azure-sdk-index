package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/schedule
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseWebhookType(input string) (*WebhookType, error) {
	vals := map[string]WebhookType{
		"azuredevops": WebhookTypeAzureDevOps,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := WebhookType(input)
	return &out, nil
}
