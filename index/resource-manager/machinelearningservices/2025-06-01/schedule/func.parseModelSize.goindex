package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/schedule
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseModelSize(input string) (*ModelSize, error) {
	vals := map[string]ModelSize{
		"extralarge": ModelSizeExtraLarge,
		"large":      ModelSizeLarge,
		"medium":     ModelSizeMedium,
		"none":       ModelSizeNone,
		"small":      ModelSizeSmall,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ModelSize(input)
	return &out, nil
}
