package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/capabilityhost
import (
	"fmt"

	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	sdkEnv "github.com/hashicorp/go-azure-sdk/sdk/environments"
)
func NewCapabilityHostClientWithBaseURI(sdkApi sdkEnv.Api) (*CapabilityHostClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "capabilityhost", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating CapabilityHostClient: %+v", err)
	}

	return &CapabilityHostClient{
		Client: client,
	}, nil
}
