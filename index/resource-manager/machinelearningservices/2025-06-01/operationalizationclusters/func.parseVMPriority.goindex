package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/operationalizationclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVMPriority(input string) (*VMPriority, error) {
	vals := map[string]VMPriority{
		"dedicated":   VMPriorityDedicated,
		"lowpriority": VMPriorityLowPriority,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VMPriority(input)
	return &out, nil
}
