package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/virtualmachinesizes
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseUnitOfMeasure(input string) (*UnitOfMeasure, error) {
	vals := map[string]UnitOfMeasure{
		"onehour": UnitOfMeasureOneHour,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := UnitOfMeasure(input)
	return &out, nil
}
