package github.com/hashicorp/go-azure-sdk/resource-manager/machinelearningservices/2025-06-01/job
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseJobTier(input string) (*JobTier, error) {
	vals := map[string]JobTier{
		"basic":    JobTierBasic,
		"null":     JobTierNull,
		"premium":  JobTierPremium,
		"spot":     JobTierSpot,
		"standard": JobTierStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := JobTier(input)
	return &out, nil
}
