package github.com/hashicorp/go-azure-sdk/resource-manager/appconfiguration/2024-05-01/deletedconfigurationstores
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *DeletedConfigurationStoreProperties) SetDeletionDateAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.DeletionDate = &formatted
}
