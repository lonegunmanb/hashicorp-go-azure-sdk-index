package github.com/hashicorp/go-azure-sdk/resource-manager/appconfiguration/2024-05-01/keyvalues
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *KeyValueProperties) GetLastModifiedAsTime() (*time.Time, error) {
	if o.LastModified == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.LastModified, "2006-01-02T15:04:05Z07:00")
}
