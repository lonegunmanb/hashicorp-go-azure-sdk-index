package github.com/hashicorp/go-azure-sdk/resource-manager/notificationhubs/2023-09-01/privatelink
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c PrivateLinkClient) PrivateEndpointConnectionsDeleteThenPoll(ctx context.Context, id PrivateEndpointConnectionId) error {
	result, err := c.PrivateEndpointConnectionsDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing PrivateEndpointConnectionsDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after PrivateEndpointConnectionsDelete: %+v", err)
	}

	return nil
}
