func NewGlobalRulestackClientWithBaseURI(sdkApi sdkEnv.Api) (*GlobalRulestackClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "globalrulestack", defaultApiVersion)
	if err != nil {
