package github.com/hashicorp/go-azure-sdk/resource-manager/paloaltonetworks/2025-05-23/firewalls
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseProtocolType(input string) (*ProtocolType, error) {
	vals := map[string]ProtocolType{
		"tcp": ProtocolTypeTCP,
		"udp": ProtocolTypeUDP,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ProtocolType(input)
	return &out, nil
}
