package github.com/hashicorp/go-azure-sdk/resource-manager/paloaltonetworks/2025-05-23/firewalls
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLogOption(input string) (*LogOption, error) {
	vals := map[string]LogOption{
		"individual_destination": LogOptionINDIVIDUALDESTINATION,
		"same_destination":       LogOptionSAMEDESTINATION,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LogOption(input)
	return &out, nil
}
