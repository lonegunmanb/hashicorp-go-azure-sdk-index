package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2019-10-01/reservationrecommendations
import (
	"encoding/json"
	"fmt"
)
func (s LegacyReservationRecommendation) ReservationRecommendation() BaseReservationRecommendationImpl {
	return BaseReservationRecommendationImpl{
		ETag:     s.ETag,
		Id:       s.Id,
		Kind:     s.Kind,
		Location: s.Location,
		Name:     s.Name,
		Sku:      s.Sku,
		Tags:     s.Tags,
		Type:     s.Type,
	}
}
