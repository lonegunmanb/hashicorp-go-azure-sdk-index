package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2019-10-01/forecasts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGrain(input string) (*Grain, error) {
	vals := map[string]Grain{
		"daily":   GrainDaily,
		"monthly": GrainMonthly,
		"yearly":  GrainYearly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Grain(input)
	return &out, nil
}
