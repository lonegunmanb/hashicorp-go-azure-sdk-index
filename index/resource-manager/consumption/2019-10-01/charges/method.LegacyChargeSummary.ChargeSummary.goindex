package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2019-10-01/charges
import (
	"encoding/json"
	"fmt"
)
func (s LegacyChargeSummary) ChargeSummary() BaseChargeSummaryImpl {
	return BaseChargeSummaryImpl{
		ETag: s.ETag,
		Id:   s.Id,
		Kind: s.Kind,
		Name: s.Name,
		Tags: s.Tags,
		Type: s.Type,
	}
}
