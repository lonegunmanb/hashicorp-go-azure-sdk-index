package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2019-10-01/reservationsummaries
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDatagrain(input string) (*Datagrain, error) {
	vals := map[string]Datagrain{
		"daily":   DatagrainDaily,
		"monthly": DatagrainMonthly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Datagrain(input)
	return &out, nil
}
