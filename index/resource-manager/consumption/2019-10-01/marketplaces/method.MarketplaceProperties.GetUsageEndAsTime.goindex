package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2019-10-01/marketplaces
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *MarketplaceProperties) GetUsageEndAsTime() (*time.Time, error) {
	if o.UsageEnd == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.UsageEnd, "2006-01-02T15:04:05Z07:00")
}
