package github.com/hashicorp/go-azure-sdk/resource-manager/consumption/2024-08-01/reservationrecommendations
import (
	"encoding/json"
	"fmt"
)
func (s ModernReservationRecommendation) ReservationRecommendation() BaseReservationRecommendationImpl {
	return BaseReservationRecommendationImpl{
		Etag:     s.Etag,
		Id:       s.Id,
		Kind:     s.Kind,
		Location: s.Location,
		Name:     s.Name,
		Sku:      s.Sku,
		Tags:     s.Tags,
		Type:     s.Type,
	}
}
