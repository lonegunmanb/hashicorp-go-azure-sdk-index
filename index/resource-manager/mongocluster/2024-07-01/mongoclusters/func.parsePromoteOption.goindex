package github.com/hashicorp/go-azure-sdk/resource-manager/mongocluster/2024-07-01/mongoclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePromoteOption(input string) (*PromoteOption, error) {
	vals := map[string]PromoteOption{
		"forced": PromoteOptionForced,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PromoteOption(input)
	return &out, nil
}
