package github.com/hashicorp/go-azure-sdk/resource-manager/mongocluster/2024-07-01/mongoclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePreviewFeature(input string) (*PreviewFeature, error) {
	vals := map[string]PreviewFeature{
		"georeplicas": PreviewFeatureGeoReplicas,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PreviewFeature(input)
	return &out, nil
}
