package github.com/hashicorp/go-azure-sdk/resource-manager/mongocluster/2024-07-01/mongoclusters
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePromoteMode(input string) (*PromoteMode, error) {
	vals := map[string]PromoteMode{
		"switchover": PromoteModeSwitchover,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PromoteMode(input)
	return &out, nil
}
