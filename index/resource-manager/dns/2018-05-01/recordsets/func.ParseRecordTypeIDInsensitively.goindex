package github.com/hashicorp/go-azure-sdk/resource-manager/dns/2018-05-01/recordsets
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseRecordTypeIDInsensitively(input string) (*RecordTypeId, error) {
	parser := resourceids.NewParserFromResourceIdType(&RecordTypeId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := RecordTypeId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
