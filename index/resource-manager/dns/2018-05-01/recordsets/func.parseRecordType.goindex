package github.com/hashicorp/go-azure-sdk/resource-manager/dns/2018-05-01/recordsets
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRecordType(input string) (*RecordType, error) {
	vals := map[string]RecordType{
		"a":     RecordTypeA,
		"aaaa":  RecordTypeAAAA,
		"caa":   RecordTypeCAA,
		"cname": RecordTypeCNAME,
		"mx":    RecordTypeMX,
		"ns":    RecordTypeNS,
		"ptr":   RecordTypePTR,
		"soa":   RecordTypeSOA,
		"srv":   RecordTypeSRV,
		"txt":   RecordTypeTXT,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RecordType(input)
	return &out, nil
}
