package github.com/hashicorp/go-azure-sdk/resource-manager/maps/2023-06-01/accounts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseName(input string) (*Name, error) {
	vals := map[string]Name{
		"g2": NameGTwo,
		"s1": NameSOne,
		"s0": NameSZero,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Name(input)
	return &out, nil
}
