package github.com/hashicorp/go-azure-sdk/resource-manager/resourcegraph/2024-04-01/graphquery
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseResultKind(input string) (*ResultKind, error) {
	vals := map[string]ResultKind{
		"basic": ResultKindBasic,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ResultKind(input)
	return &out, nil
}
