package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2022-05-01/workloadnetworks
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVMTypeEnum(input string) (*VMTypeEnum, error) {
	vals := map[string]VMTypeEnum{
		"edge":    VMTypeEnumEDGE,
		"regular": VMTypeEnumREGULAR,
		"service": VMTypeEnumSERVICE,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VMTypeEnum(input)
	return &out, nil
}
