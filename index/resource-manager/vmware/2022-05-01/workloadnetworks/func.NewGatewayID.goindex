package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2022-05-01/workloadnetworks
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewGatewayID(subscriptionId string, resourceGroupName string, privateCloudName string, gatewayId string) GatewayId {
	return GatewayId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		PrivateCloudName:  privateCloudName,
		GatewayId:         gatewayId,
	}
}
