func PossibleValuesForCloudLinkStatus() []string {
	return []string{
		string(CloudLinkStatusActive),
		string(CloudLinkStatusBuilding),
		string(CloudLinkStatusDeleting),
		string(CloudLinkStatusDisconnected),
		string(CloudLinkStatusFailed),
	}
}
