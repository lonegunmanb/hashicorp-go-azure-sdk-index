package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/cloudlinks
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCloudLinkProvisioningState(input string) (*CloudLinkProvisioningState, error) {
	vals := map[string]CloudLinkProvisioningState{
		"canceled":  CloudLinkProvisioningStateCanceled,
		"failed":    CloudLinkProvisioningStateFailed,
		"succeeded": CloudLinkProvisioningStateSucceeded,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CloudLinkProvisioningState(input)
	return &out, nil
}
