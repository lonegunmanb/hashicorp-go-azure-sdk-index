func PossibleValuesForScriptCmdletProvisioningState() []string {
	return []string{
		string(ScriptCmdletProvisioningStateCanceled),
		string(ScriptCmdletProvisioningStateFailed),
		string(ScriptCmdletProvisioningStateSucceeded),
