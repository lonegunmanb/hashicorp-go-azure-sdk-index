package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/vmwares
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseResourceSkuResourceType(input string) (*ResourceSkuResourceType, error) {
	vals := map[string]ResourceSkuResourceType{
		"privateclouds":          ResourceSkuResourceTypePrivateClouds,
		"privateclouds/clusters": ResourceSkuResourceTypePrivateCloudsClusters,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ResourceSkuResourceType(input)
	return &out, nil
}
