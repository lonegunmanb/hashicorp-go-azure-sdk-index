package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/vmwares
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c VMwaresClient) WorkloadNetworksDeletePublicIPThenPoll(ctx context.Context, id PublicIPId) error {
	result, err := c.WorkloadNetworksDeletePublicIP(ctx, id)
	if err != nil {
		return fmt.Errorf("performing WorkloadNetworksDeletePublicIP: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after WorkloadNetworksDeletePublicIP: %+v", err)
	}

	return nil
}
