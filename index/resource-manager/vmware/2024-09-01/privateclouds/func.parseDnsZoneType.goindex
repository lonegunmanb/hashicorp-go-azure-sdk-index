package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/privateclouds
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDnsZoneType(input string) (*DnsZoneType, error) {
	vals := map[string]DnsZoneType{
		"private": DnsZoneTypePrivate,
		"public":  DnsZoneTypePublic,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DnsZoneType(input)
	return &out, nil
}
