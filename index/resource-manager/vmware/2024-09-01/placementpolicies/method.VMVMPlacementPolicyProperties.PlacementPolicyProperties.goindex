package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/placementpolicies
import (
	"encoding/json"
	"fmt"
)
func (s VMVMPlacementPolicyProperties) PlacementPolicyProperties() BasePlacementPolicyPropertiesImpl {
	return BasePlacementPolicyPropertiesImpl{
		DisplayName:       s.DisplayName,
		ProvisioningState: s.ProvisioningState,
		State:             s.State,
		Type:              s.Type,
	}
}
