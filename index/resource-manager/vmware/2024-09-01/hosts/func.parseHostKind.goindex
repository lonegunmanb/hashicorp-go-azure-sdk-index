package github.com/hashicorp/go-azure-sdk/resource-manager/vmware/2024-09-01/hosts
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseHostKind(input string) (*HostKind, error) {
	vals := map[string]HostKind{
		"general":     HostKindGeneral,
		"specialized": HostKindSpecialized,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := HostKind(input)
	return &out, nil
}
