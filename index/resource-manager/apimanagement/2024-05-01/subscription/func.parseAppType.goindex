package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/subscription
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAppType(input string) (*AppType, error) {
	vals := map[string]AppType{
		"developerportal": AppTypeDeveloperPortal,
		"portal":          AppTypePortal,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AppType(input)
	return &out, nil
}
