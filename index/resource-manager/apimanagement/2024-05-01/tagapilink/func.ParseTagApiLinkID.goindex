package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/tagapilink
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseTagApiLinkID(input string) (*TagApiLinkId, error) {
	parser := resourceids.NewParserFromResourceIdType(&TagApiLinkId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := TagApiLinkId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
