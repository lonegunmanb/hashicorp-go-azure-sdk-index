package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/tagapilink
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewApiLinkID(subscriptionId string, resourceGroupName string, serviceName string, tagId string, apiLinkId string) ApiLinkId {
	return ApiLinkId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ServiceName:       serviceName,
		TagId:             tagId,
		ApiLinkId:         apiLinkId,
	}
}
