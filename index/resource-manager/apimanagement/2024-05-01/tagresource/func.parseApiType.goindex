package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/tagresource
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseApiType(input string) (*ApiType, error) {
	vals := map[string]ApiType{
		"graphql":   ApiTypeGraphql,
		"grpc":      ApiTypeGrpc,
		"http":      ApiTypeHTTP,
		"odata":     ApiTypeOdata,
		"soap":      ApiTypeSoap,
		"websocket": ApiTypeWebsocket,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ApiType(input)
	return &out, nil
}
