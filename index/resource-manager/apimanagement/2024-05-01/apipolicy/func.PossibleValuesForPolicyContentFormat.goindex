func PossibleValuesForPolicyContentFormat() []string {
	return []string{
		string(PolicyContentFormatRawxml),
		string(PolicyContentFormatRawxmlNegativelink),
		string(PolicyContentFormatXml),
		string(PolicyContentFormatXmlNegativelink),
