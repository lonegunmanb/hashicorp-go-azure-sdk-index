package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/gatewayapi
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseGatewayApiID(input string) (*GatewayApiId, error) {
	parser := resourceids.NewParserFromResourceIdType(&GatewayApiId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := GatewayApiId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
