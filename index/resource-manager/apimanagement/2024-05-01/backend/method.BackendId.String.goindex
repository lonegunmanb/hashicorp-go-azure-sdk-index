package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/backend
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id BackendId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Service Name: %q", id.ServiceName),
		fmt.Sprintf("Backend: %q", id.BackendId),
	}
	return fmt.Sprintf("Backend (%s)", strings.Join(components, "\n"))
}
