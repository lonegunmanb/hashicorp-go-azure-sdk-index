package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2024-05-01/backend
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBackendType(input string) (*BackendType, error) {
	vals := map[string]BackendType{
		"pool":   BackendTypePool,
		"single": BackendTypeSingle,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BackendType(input)
	return &out, nil
}
