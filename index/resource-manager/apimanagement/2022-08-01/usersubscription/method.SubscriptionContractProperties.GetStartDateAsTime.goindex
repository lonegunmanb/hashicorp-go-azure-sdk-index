package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2022-08-01/usersubscription
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *SubscriptionContractProperties) GetStartDateAsTime() (*time.Time, error) {
	if o.StartDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StartDate, "2006-01-02T15:04:05Z07:00")
}
