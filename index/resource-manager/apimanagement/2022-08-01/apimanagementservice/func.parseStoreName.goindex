package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2022-08-01/apimanagementservice
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStoreName(input string) (*StoreName, error) {
	vals := map[string]StoreName{
		"certificateauthority": StoreNameCertificateAuthority,
		"root":                 StoreNameRoot,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := StoreName(input)
	return &out, nil
}
