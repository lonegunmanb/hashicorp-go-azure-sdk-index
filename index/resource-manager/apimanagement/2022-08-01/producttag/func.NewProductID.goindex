package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2022-08-01/producttag
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewProductID(subscriptionId string, resourceGroupName string, serviceName string, productId string) ProductId {
	return ProductId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ServiceName:       serviceName,
		ProductId:         productId,
	}
}
