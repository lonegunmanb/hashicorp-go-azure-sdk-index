package github.com/hashicorp/go-azure-sdk/resource-manager/apimanagement/2022-08-01/networkstatus
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewLocationID(subscriptionId string, resourceGroupName string, serviceName string, locationName string) LocationId {
	return LocationId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ServiceName:       serviceName,
		LocationName:      locationName,
	}
}
