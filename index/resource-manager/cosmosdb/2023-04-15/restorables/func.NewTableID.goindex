package github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2023-04-15/restorables
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewTableID(subscriptionId string, resourceGroupName string, databaseAccountName string, tableName string) TableId {
	return TableId{
		SubscriptionId:      subscriptionId,
		ResourceGroupName:   resourceGroupName,
		DatabaseAccountName: databaseAccountName,
		TableName:           tableName,
	}
}
