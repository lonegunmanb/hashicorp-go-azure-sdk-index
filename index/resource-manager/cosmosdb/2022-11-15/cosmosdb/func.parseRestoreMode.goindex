package github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2022-11-15/cosmosdb
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRestoreMode(input string) (*RestoreMode, error) {
	vals := map[string]RestoreMode{
		"pointintime": RestoreModePointInTime,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RestoreMode(input)
	return &out, nil
}
