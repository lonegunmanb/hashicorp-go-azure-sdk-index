package github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2024-08-15/restorables
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseApiType(input string) (*ApiType, error) {
	vals := map[string]ApiType{
		"cassandra": ApiTypeCassandra,
		"gremlin":   ApiTypeGremlin,
		"gremlinv2": ApiTypeGremlinVTwo,
		"mongodb":   ApiTypeMongoDB,
		"sql":       ApiTypeSql,
		"table":     ApiTypeTable,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ApiType(input)
	return &out, nil
}
