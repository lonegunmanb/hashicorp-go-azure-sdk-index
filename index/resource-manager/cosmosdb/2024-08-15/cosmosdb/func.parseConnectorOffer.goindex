package github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2024-08-15/cosmosdb
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseConnectorOffer(input string) (*ConnectorOffer, error) {
	vals := map[string]ConnectorOffer{
		"small": ConnectorOfferSmall,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ConnectorOffer(input)
	return &out, nil
}
