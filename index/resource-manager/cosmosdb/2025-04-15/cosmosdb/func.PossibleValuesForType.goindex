func PossibleValuesForType() []string {
	return []string{
		string(TypeCassandra),
		string(TypeCassandraConnectorMetadata),
		string(TypeGremlin),
		string(TypeGremlinVTwo),
		string(TypeMongoDB),
		string(TypeSql),
		string(TypeSqlDedicatedGateway),
		string(TypeTable),
		string(TypeUndefined),
	}
}
