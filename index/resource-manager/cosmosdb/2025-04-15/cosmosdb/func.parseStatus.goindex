package github.com/hashicorp/go-azure-sdk/resource-manager/cosmosdb/2025-04-15/cosmosdb
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStatus(input string) (*Status, error) {
	vals := map[string]Status{
		"deleting":        StatusDeleting,
		"initializing":    StatusInitializing,
		"internallyready": StatusInternallyReady,
		"online":          StatusOnline,
		"uninitialized":   StatusUninitialized,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Status(input)
	return &out, nil
}
