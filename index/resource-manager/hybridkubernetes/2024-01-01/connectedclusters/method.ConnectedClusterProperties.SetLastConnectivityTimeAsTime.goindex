package github.com/hashicorp/go-azure-sdk/resource-manager/hybridkubernetes/2024-01-01/connectedclusters
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ConnectedClusterProperties) SetLastConnectivityTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.LastConnectivityTime = &formatted
}
