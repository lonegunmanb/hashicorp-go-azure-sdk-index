func PossibleValuesForConnectivityStatus() []string {
	return []string{
		string(ConnectivityStatusConnected),
		string(ConnectivityStatusConnecting),
		string(ConnectivityStatusExpired),
		string(ConnectivityStatusOffline),
	}
}
