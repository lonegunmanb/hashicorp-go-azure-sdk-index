package github.com/hashicorp/go-azure-sdk/resource-manager/healthbot/2025-05-25/healthbots
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuName(input string) (*SkuName, error) {
	vals := map[string]SkuName{
		"c1":  SkuNameCOne,
		"c0":  SkuNameCZero,
		"f0":  SkuNameFZero,
		"pes": SkuNamePES,
		"s1":  SkuNameSOne,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuName(input)
	return &out, nil
}
