package github.com/hashicorp/go-azure-sdk/resource-manager/frontdoor/2024-02-01/webapplicationfirewallpolicies
import (
	"strings"
)
func parseSkuName(input string) (*SkuName, error) {
	vals := map[string]SkuName{
		"classic_azurefrontdoor":  SkuNameClassicAzureFrontDoor,
		"premium_azurefrontdoor":  SkuNamePremiumAzureFrontDoor,
		"standard_azurefrontdoor": SkuNameStandardAzureFrontDoor,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuName(input)
	return &out, nil
}
