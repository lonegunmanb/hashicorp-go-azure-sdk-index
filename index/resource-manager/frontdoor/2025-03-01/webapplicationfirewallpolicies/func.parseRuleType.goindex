package github.com/hashicorp/go-azure-sdk/resource-manager/frontdoor/2025-03-01/webapplicationfirewallpolicies
import (
	"strings"
)
func parseRuleType(input string) (*RuleType, error) {
	vals := map[string]RuleType{
		"matchrule":     RuleTypeMatchRule,
		"ratelimitrule": RuleTypeRateLimitRule,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RuleType(input)
	return &out, nil
}
