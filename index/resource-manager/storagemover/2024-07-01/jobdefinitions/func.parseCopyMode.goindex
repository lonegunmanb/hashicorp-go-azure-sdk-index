package github.com/hashicorp/go-azure-sdk/resource-manager/storagemover/2024-07-01/jobdefinitions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCopyMode(input string) (*CopyMode, error) {
	vals := map[string]CopyMode{
		"additive": CopyModeAdditive,
		"mirror":   CopyModeMirror,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CopyMode(input)
	return &out, nil
}
