package github.com/hashicorp/go-azure-sdk/resource-manager/networkfunction/2022-11-01/collectorpolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseEmissionType(input string) (*EmissionType, error) {
	vals := map[string]EmissionType{
		"ipfix": EmissionTypeIPFIX,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := EmissionType(input)
	return &out, nil
}
