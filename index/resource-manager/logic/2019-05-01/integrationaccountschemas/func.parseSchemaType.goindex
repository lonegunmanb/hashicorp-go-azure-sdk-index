package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/integrationaccountschemas
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSchemaType(input string) (*SchemaType, error) {
	vals := map[string]SchemaType{
		"notspecified": SchemaTypeNotSpecified,
		"xml":          SchemaTypeXml,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SchemaType(input)
	return &out, nil
}
