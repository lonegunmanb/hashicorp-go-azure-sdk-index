package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/workflowversions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewVersionID(subscriptionId string, resourceGroupName string, workflowName string, versionId string) VersionId {
	return VersionId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		WorkflowName:      workflowName,
		VersionId:         versionId,
	}
}
