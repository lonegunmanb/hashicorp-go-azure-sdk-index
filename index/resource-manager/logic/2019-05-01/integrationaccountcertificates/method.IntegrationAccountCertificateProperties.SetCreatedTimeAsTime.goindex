package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/integrationaccountcertificates
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *IntegrationAccountCertificateProperties) SetCreatedTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.CreatedTime = &formatted
}
