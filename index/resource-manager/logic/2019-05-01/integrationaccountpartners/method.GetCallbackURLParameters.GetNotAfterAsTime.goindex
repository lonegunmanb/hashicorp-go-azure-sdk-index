package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/integrationaccountpartners
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *GetCallbackURLParameters) GetNotAfterAsTime() (*time.Time, error) {
	if o.NotAfter == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.NotAfter, "2006-01-02T15:04:05Z07:00")
}
