package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/integrationaccountpartners
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePartnerType(input string) (*PartnerType, error) {
	vals := map[string]PartnerType{
		"b2b":          PartnerTypeBTwoB,
		"notspecified": PartnerTypeNotSpecified,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PartnerType(input)
	return &out, nil
}
