package github.com/hashicorp/go-azure-sdk/resource-manager/logic/2019-05-01/workflowtriggers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewTriggerID(subscriptionId string, resourceGroupName string, workflowName string, triggerName string) TriggerId {
	return TriggerId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		WorkflowName:      workflowName,
		TriggerName:       triggerName,
	}
}
