package github.com/hashicorp/go-azure-sdk/resource-manager/orbital/2022-11-01/groundstation
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseReleaseMode(input string) (*ReleaseMode, error) {
	vals := map[string]ReleaseMode{
		"ga":      ReleaseModeGA,
		"preview": ReleaseModePreview,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ReleaseMode(input)
	return &out, nil
}
