func (o AvailableGroundStationsListByCapabilityOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.Capability != nil {
		out.Append("capability", fmt.Sprintf("%v", *o.Capability))
	}
	return &out
}
