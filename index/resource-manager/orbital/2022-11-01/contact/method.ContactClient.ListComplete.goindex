package github.com/hashicorp/go-azure-sdk/resource-manager/orbital/2022-11-01/contact
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
