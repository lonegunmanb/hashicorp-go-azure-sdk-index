func PossibleValuesForContactsStatus() []string {
	return []string{
		string(ContactsStatusCancelled),
		string(ContactsStatusFailed),
		string(ContactsStatusProviderCancelled),
		string(ContactsStatusScheduled),
		string(ContactsStatusSucceeded),
	}
}
