package github.com/hashicorp/go-azure-sdk/resource-manager/datadog/2023-10-20/rules
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseTagRuleIDInsensitively(input string) (*TagRuleId, error) {
	parser := resourceids.NewParserFromResourceIdType(&TagRuleId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := TagRuleId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
