func (o CreationSupportedListOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.DatadogOrganizationId != nil {
		out.Append("datadogOrganizationId", fmt.Sprintf("%v", *o.DatadogOrganizationId))
