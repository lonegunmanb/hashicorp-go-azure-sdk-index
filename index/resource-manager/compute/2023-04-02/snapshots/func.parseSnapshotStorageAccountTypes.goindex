package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2023-04-02/snapshots
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSnapshotStorageAccountTypes(input string) (*SnapshotStorageAccountTypes, error) {
	vals := map[string]SnapshotStorageAccountTypes{
		"premium_lrs":  SnapshotStorageAccountTypesPremiumLRS,
		"standard_lrs": SnapshotStorageAccountTypesStandardLRS,
		"standard_zrs": SnapshotStorageAccountTypesStandardZRS,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SnapshotStorageAccountTypes(input)
	return &out, nil
}
