package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2024-03-01/restorepoints
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMode(input string) (*Mode, error) {
	vals := map[string]Mode{
		"audit":   ModeAudit,
		"enforce": ModeEnforce,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Mode(input)
	return &out, nil
}
