func (o DeallocateOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.Hibernate != nil {
		out.Append("hibernate", fmt.Sprintf("%v", *o.Hibernate))
	}
	return &out
}
