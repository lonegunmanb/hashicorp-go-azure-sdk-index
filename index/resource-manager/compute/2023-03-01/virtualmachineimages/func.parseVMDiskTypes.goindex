package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2023-03-01/virtualmachineimages
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseVMDiskTypes(input string) (*VMDiskTypes, error) {
	vals := map[string]VMDiskTypes{
		"none":      VMDiskTypesNone,
		"unmanaged": VMDiskTypesUnmanaged,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := VMDiskTypes(input)
	return &out, nil
}
