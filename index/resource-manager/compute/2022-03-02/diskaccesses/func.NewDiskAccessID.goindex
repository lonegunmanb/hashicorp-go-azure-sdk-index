package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2022-03-02/diskaccesses
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewDiskAccessID(subscriptionId string, resourceGroupName string, diskAccessName string) DiskAccessId {
	return DiskAccessId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		DiskAccessName:    diskAccessName,
	}
}
