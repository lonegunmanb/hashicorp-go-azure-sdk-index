package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2024-11-01/virtualmachinescalesets
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseModes(input string) (*Modes, error) {
	vals := map[string]Modes{
		"audit":    ModesAudit,
		"disabled": ModesDisabled,
		"enforce":  ModesEnforce,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Modes(input)
	return &out, nil
}
