package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2024-11-01/virtualmachines
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
