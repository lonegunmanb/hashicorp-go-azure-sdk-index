package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2024-11-01/computerps
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewSkuID(subscriptionId string, locationName string, publisherName string, offerName string, skuName string) SkuId {
	return SkuId{
		SubscriptionId: subscriptionId,
		LocationName:   locationName,
		PublisherName:  publisherName,
		OfferName:      offerName,
		SkuName:        skuName,
	}
}
