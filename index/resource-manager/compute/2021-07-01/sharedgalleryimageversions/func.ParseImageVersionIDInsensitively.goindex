package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2021-07-01/sharedgalleryimageversions
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseImageVersionIDInsensitively(input string) (*ImageVersionId, error) {
	parser := resourceids.NewParserFromResourceIdType(&ImageVersionId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := ImageVersionId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
