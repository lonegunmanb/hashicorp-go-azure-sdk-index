package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2022-03-03/sharedgalleryimageversions
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSharedToValues(input string) (*SharedToValues, error) {
	vals := map[string]SharedToValues{
		"tenant": SharedToValuesTenant,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SharedToValues(input)
	return &out, nil
}
