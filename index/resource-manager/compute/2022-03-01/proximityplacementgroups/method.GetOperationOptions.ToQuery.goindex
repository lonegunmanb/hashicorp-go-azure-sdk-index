func (o GetOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.IncludeColocationStatus != nil {
		out.Append("includeColocationStatus", fmt.Sprintf("%v", *o.IncludeColocationStatus))
	}
	return &out
}
