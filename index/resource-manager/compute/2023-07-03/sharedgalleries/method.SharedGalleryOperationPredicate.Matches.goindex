package github.com/hashicorp/go-azure-sdk/resource-manager/compute/2023-07-03/sharedgalleries

func (p SharedGalleryOperationPredicate) Matches(input SharedGallery) bool {

	if p.Location != nil && (input.Location == nil || *p.Location != *input.Location) {
		return false
	}

	if p.Name != nil && (input.Name == nil || *p.Name != *input.Name) {
		return false
	}

	return true
}
