package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2023-01-01/actiongroupsapis
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewActionGroupID(subscriptionId string, resourceGroupName string, actionGroupName string) ActionGroupId {
	return ActionGroupId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ActionGroupName:   actionGroupName,
	}
}
