package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2021-07-01-preview/privatelinkscopesapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAccessMode(input string) (*AccessMode, error) {
	vals := map[string]AccessMode{
		"open":        AccessModeOpen,
		"privateonly": AccessModePrivateOnly,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AccessMode(input)
	return &out, nil
}
