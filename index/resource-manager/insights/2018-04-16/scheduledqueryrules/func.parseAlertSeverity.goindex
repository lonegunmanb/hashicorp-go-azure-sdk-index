package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2018-04-16/scheduledqueryrules
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAlertSeverity(input string) (*AlertSeverity, error) {
	vals := map[string]AlertSeverity{
		"4": AlertSeverityFour,
		"1": AlertSeverityOne,
		"3": AlertSeverityThree,
		"2": AlertSeverityTwo,
		"0": AlertSeverityZero,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AlertSeverity(input)
	return &out, nil
}
