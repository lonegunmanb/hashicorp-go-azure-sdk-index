package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2018-04-16/scheduledqueryrules
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseQueryType(input string) (*QueryType, error) {
	vals := map[string]QueryType{
		"resultcount": QueryTypeResultCount,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := QueryType(input)
	return &out, nil
}
