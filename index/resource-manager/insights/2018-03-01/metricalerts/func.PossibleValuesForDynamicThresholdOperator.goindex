func PossibleValuesForDynamicThresholdOperator() []string {
	return []string{
		string(DynamicThresholdOperatorGreaterOrLessThan),
		string(DynamicThresholdOperatorGreaterThan),
		string(DynamicThresholdOperatorLessThan),
	}
}
