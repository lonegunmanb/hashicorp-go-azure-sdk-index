package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2018-03-01/metricalertsstatus
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseStatusIDInsensitively(input string) (*StatusId, error) {
	parser := resourceids.NewParserFromResourceIdType(&StatusId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := StatusId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
