package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2015-04-01/autoscalesettings
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseOperationType(input string) (*OperationType, error) {
	vals := map[string]OperationType{
		"scale": OperationTypeScale,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := OperationType(input)
	return &out, nil
}
