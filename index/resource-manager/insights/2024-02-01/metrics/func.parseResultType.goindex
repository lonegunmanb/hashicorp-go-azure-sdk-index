package github.com/hashicorp/go-azure-sdk/resource-manager/insights/2024-02-01/metrics
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseResultType(input string) (*ResultType, error) {
	vals := map[string]ResultType{
		"data":     ResultTypeData,
		"metadata": ResultTypeMetadata,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ResultType(input)
	return &out, nil
}
