		out.Append("aggregation", fmt.Sprintf("%v", *o.Aggregation))
	}
	if o.AutoAdjustTimegrain != nil {
		out.Append("AutoAdjustTimegrain", fmt.Sprintf("%v", *o.AutoAdjustTimegrain))
	}
	if o.Filter != nil {
		out.Append("$filter", fmt.Sprintf("%v", *o.Filter))
	}
