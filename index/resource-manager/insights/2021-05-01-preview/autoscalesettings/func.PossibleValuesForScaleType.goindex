func PossibleValuesForScaleType() []string {
	return []string{
		string(ScaleTypeChangeCount),
		string(ScaleTypeExactCount),
		string(ScaleTypePercentChangeCount),
		string(ScaleTypeServiceAllowedNextValue),
	}
}
