func PossibleValuesForTimeAggregation() []string {
	return []string{
		string(TimeAggregationAverage),
		string(TimeAggregationCount),
		string(TimeAggregationMaximum),
		string(TimeAggregationMinimum),
		string(TimeAggregationTotal),
	}
}
