func (o DeleteOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.CleanupConnectionArtifacts != nil {
		out.Append("cleanupConnectionArtifacts", fmt.Sprintf("%v", *o.CleanupConnectionArtifacts))
	}
	return &out
}
