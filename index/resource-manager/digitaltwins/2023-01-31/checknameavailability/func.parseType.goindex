package github.com/hashicorp/go-azure-sdk/resource-manager/digitaltwins/2023-01-31/checknameavailability
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseType(input string) (*Type, error) {
	vals := map[string]Type{
		"microsoft.digitaltwins/digitaltwinsinstances": TypeMicrosoftPointDigitalTwinsDigitalTwinsInstances,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Type(input)
	return &out, nil
}
