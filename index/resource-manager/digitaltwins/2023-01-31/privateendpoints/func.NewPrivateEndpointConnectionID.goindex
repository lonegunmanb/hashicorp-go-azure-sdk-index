package github.com/hashicorp/go-azure-sdk/resource-manager/digitaltwins/2023-01-31/privateendpoints
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewPrivateEndpointConnectionID(subscriptionId string, resourceGroupName string, digitalTwinsInstanceName string, privateEndpointConnectionName string) PrivateEndpointConnectionId {
	return PrivateEndpointConnectionId{
		SubscriptionId:                subscriptionId,
		ResourceGroupName:             resourceGroupName,
		DigitalTwinsInstanceName:      digitalTwinsInstanceName,
		PrivateEndpointConnectionName: privateEndpointConnectionName,
	}
}
