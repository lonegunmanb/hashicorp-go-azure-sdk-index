package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-01-01/provider
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
