package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-01-01/appserviceplans
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewWorkerID(subscriptionId string, resourceGroupName string, serverFarmName string, workerName string) WorkerId {
	return WorkerId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ServerFarmName:    serverFarmName,
		WorkerName:        workerName,
	}
}
