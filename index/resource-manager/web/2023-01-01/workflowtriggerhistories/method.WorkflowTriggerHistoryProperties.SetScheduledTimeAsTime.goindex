package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-01-01/workflowtriggerhistories
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *WorkflowTriggerHistoryProperties) SetScheduledTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.ScheduledTime = &formatted
}
