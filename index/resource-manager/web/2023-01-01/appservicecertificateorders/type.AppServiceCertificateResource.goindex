package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-01-01/appservicecertificateorders

type AppServiceCertificateResource struct {
	Id         *string                `json:"id,omitempty"`
	Kind       *string                `json:"kind,omitempty"`
	Location   string                 `json:"location"`
	Name       *string                `json:"name,omitempty"`
	Properties *AppServiceCertificate `json:"properties,omitempty"`
	Tags       *map[string]string     `json:"tags,omitempty"`
	Type       *string                `json:"type,omitempty"`
}
