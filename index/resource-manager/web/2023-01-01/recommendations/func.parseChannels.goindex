package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-01-01/recommendations
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseChannels(input string) (*Channels, error) {
	vals := map[string]Channels{
		"all":          ChannelsAll,
		"api":          ChannelsApi,
		"email":        ChannelsEmail,
		"notification": ChannelsNotification,
		"webhook":      ChannelsWebhook,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Channels(input)
	return &out, nil
}
