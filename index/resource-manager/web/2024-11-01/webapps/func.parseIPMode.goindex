package github.com/hashicorp/go-azure-sdk/resource-manager/web/2024-11-01/webapps
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseIPMode(input string) (*IPMode, error) {
	vals := map[string]IPMode{
		"ipv4":        IPModeIPvFour,
		"ipv4andipv6": IPModeIPvFourAndIPvSix,
		"ipv6":        IPModeIPvSix,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := IPMode(input)
	return &out, nil
}
