package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/diagnostics
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseSlotDiagnosticID(input string) (*SlotDiagnosticId, error) {
	parser := resourceids.NewParserFromResourceIdType(&SlotDiagnosticId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := SlotDiagnosticId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
