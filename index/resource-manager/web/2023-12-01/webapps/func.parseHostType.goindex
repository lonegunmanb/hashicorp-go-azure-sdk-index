package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/webapps
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseHostType(input string) (*HostType, error) {
	vals := map[string]HostType{
		"repository": HostTypeRepository,
		"standard":   HostTypeStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := HostType(input)
	return &out, nil
}
