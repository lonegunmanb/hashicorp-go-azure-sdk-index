package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/containerapps
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id ContainerAppId) ID() string {
	fmtString := "/subscriptions/%s/providers/Microsoft.Web/containerApps/%s"
	return fmt.Sprintf(fmtString, id.SubscriptionId, id.ContainerAppName)
}
