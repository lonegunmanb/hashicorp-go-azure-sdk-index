package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/domains
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (o DeleteOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.ForceHardDeleteDomain != nil {
		out.Append("forceHardDeleteDomain", fmt.Sprintf("%v", *o.ForceHardDeleteDomain))
	}
	return &out
}
