package github.com/hashicorp/go-azure-sdk/resource-manager/web/2023-12-01/domains
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDnsType(input string) (*DnsType, error) {
	vals := map[string]DnsType{
		"azuredns":                  DnsTypeAzureDns,
		"defaultdomainregistrardns": DnsTypeDefaultDomainRegistrarDns,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DnsType(input)
	return &out, nil
}
