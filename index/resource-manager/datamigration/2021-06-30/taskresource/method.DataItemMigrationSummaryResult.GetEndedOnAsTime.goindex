package github.com/hashicorp/go-azure-sdk/resource-manager/datamigration/2021-06-30/taskresource
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *DataItemMigrationSummaryResult) GetEndedOnAsTime() (*time.Time, error) {
	if o.EndedOn == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.EndedOn, "2006-01-02T15:04:05Z07:00")
}
