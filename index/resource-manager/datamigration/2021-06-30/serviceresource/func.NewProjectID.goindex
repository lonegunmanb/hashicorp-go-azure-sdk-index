package github.com/hashicorp/go-azure-sdk/resource-manager/datamigration/2021-06-30/serviceresource
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewProjectID(subscriptionId string, resourceGroupName string, serviceName string, projectName string) ProjectId {
	return ProjectId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		ServiceName:       serviceName,
		ProjectName:       projectName,
	}
}
