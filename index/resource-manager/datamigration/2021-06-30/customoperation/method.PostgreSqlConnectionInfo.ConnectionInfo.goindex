package github.com/hashicorp/go-azure-sdk/resource-manager/datamigration/2021-06-30/customoperation
import (
	"encoding/json"
	"fmt"
)
func (s PostgreSqlConnectionInfo) ConnectionInfo() BaseConnectionInfoImpl {
	return BaseConnectionInfoImpl{
		Password: s.Password,
		Type:     s.Type,
		UserName: s.UserName,
	}
}
