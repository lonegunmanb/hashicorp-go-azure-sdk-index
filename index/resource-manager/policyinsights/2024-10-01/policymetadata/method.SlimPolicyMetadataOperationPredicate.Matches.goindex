package github.com/hashicorp/go-azure-sdk/resource-manager/policyinsights/2024-10-01/policymetadata

func (p SlimPolicyMetadataOperationPredicate) Matches(input SlimPolicyMetadata) bool {

	if p.Id != nil && (input.Id == nil || *p.Id != *input.Id) {
		return false
	}

	if p.Name != nil && (input.Name == nil || *p.Name != *input.Name) {
		return false
	}

	if p.Type != nil && (input.Type == nil || *p.Type != *input.Type) {
		return false
	}

	return true
}
