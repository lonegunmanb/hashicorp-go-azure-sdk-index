func NewPolicyDefinitionID(subscriptionId string, policyDefinitionName string) PolicyDefinitionId {
	return PolicyDefinitionId{
		SubscriptionId:       subscriptionId,
		PolicyDefinitionName: policyDefinitionName,
	}
}
