package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/linkers
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseScopedDryrunID(input string) (*ScopedDryrunId, error) {
	parser := resourceids.NewParserFromResourceIdType(&ScopedDryrunId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := ScopedDryrunId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
