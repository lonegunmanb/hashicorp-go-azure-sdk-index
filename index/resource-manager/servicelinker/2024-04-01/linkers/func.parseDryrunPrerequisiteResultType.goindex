package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/linkers
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDryrunPrerequisiteResultType(input string) (*DryrunPrerequisiteResultType, error) {
	vals := map[string]DryrunPrerequisiteResultType{
		"basicerror":         DryrunPrerequisiteResultTypeBasicError,
		"permissionsmissing": DryrunPrerequisiteResultTypePermissionsMissing,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DryrunPrerequisiteResultType(input)
	return &out, nil
}
