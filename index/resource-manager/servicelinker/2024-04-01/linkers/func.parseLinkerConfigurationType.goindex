package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/linkers
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLinkerConfigurationType(input string) (*LinkerConfigurationType, error) {
	vals := map[string]LinkerConfigurationType{
		"default":        LinkerConfigurationTypeDefault,
		"keyvaultsecret": LinkerConfigurationTypeKeyVaultSecret,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LinkerConfigurationType(input)
	return &out, nil
}
