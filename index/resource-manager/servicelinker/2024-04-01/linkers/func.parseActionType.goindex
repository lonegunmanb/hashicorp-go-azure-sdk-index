package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/linkers
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseActionType(input string) (*ActionType, error) {
	vals := map[string]ActionType{
		"enable": ActionTypeEnable,
		"optout": ActionTypeOptOut,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ActionType(input)
	return &out, nil
}
