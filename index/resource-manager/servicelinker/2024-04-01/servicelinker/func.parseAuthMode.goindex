package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/servicelinker
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAuthMode(input string) (*AuthMode, error) {
	vals := map[string]AuthMode{
		"optinallauth":  AuthModeOptInAllAuth,
		"optoutallauth": AuthModeOptOutAllAuth,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AuthMode(input)
	return &out, nil
}
