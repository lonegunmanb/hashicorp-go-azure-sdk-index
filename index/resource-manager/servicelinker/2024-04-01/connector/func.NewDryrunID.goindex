package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/connector
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewDryrunID(subscriptionId string, resourceGroupName string, locationName string, dryrunName string) DryrunId {
	return DryrunId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LocationName:      locationName,
		DryrunName:        dryrunName,
	}
}
