package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/connector
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func (id DryrunId) String() string {
	components := []string{
		fmt.Sprintf("Subscription: %q", id.SubscriptionId),
		fmt.Sprintf("Resource Group Name: %q", id.ResourceGroupName),
		fmt.Sprintf("Location Name: %q", id.LocationName),
		fmt.Sprintf("Dryrun Name: %q", id.DryrunName),
	}
	return fmt.Sprintf("Dryrun (%s)", strings.Join(components, "\n"))
}
