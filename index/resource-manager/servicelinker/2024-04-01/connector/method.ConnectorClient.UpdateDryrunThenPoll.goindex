package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/connector
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ConnectorClient) UpdateDryrunThenPoll(ctx context.Context, id DryrunId, input DryrunPatch) error {
	result, err := c.UpdateDryrun(ctx, id, input)
	if err != nil {
		return fmt.Errorf("performing UpdateDryrun: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after UpdateDryrun: %+v", err)
	}

	return nil
}
