package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/connector
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseDryrunPreviewOperationType(input string) (*DryrunPreviewOperationType, error) {
	vals := map[string]DryrunPreviewOperationType{
		"configauth":       DryrunPreviewOperationTypeConfigAuth,
		"configconnection": DryrunPreviewOperationTypeConfigConnection,
		"confignetwork":    DryrunPreviewOperationTypeConfigNetwork,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := DryrunPreviewOperationType(input)
	return &out, nil
}
