package github.com/hashicorp/go-azure-sdk/resource-manager/servicelinker/2024-04-01/connector
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewConnectorID(subscriptionId string, resourceGroupName string, locationName string, connectorName string) ConnectorId {
	return ConnectorId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LocationName:      locationName,
		ConnectorName:     connectorName,
	}
}
