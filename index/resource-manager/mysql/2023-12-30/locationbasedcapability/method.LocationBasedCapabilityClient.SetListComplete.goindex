package github.com/hashicorp/go-azure-sdk/resource-manager/mysql/2023-12-30/locationbasedcapability
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
