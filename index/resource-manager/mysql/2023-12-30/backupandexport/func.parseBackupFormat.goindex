package github.com/hashicorp/go-azure-sdk/resource-manager/mysql/2023-12-30/backupandexport
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseBackupFormat(input string) (*BackupFormat, error) {
	vals := map[string]BackupFormat{
		"collatedformat": BackupFormatCollatedFormat,
		"raw":            BackupFormatRaw,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := BackupFormat(input)
	return &out, nil
}
