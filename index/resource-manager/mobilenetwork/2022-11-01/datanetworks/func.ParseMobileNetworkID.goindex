package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2022-11-01/datanetworks
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseMobileNetworkID(input string) (*MobileNetworkId, error) {
	parser := resourceids.NewParserFromResourceIdType(&MobileNetworkId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := MobileNetworkId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
