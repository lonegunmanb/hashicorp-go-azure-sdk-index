package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2022-11-01/sim
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSimState(input string) (*SimState, error) {
	vals := map[string]SimState{
		"disabled": SimStateDisabled,
		"enabled":  SimStateEnabled,
		"invalid":  SimStateInvalid,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SimState(input)
	return &out, nil
}
