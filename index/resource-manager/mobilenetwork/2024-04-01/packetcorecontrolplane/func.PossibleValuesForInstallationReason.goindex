		string(InstallationReasonUserPlaneAccessInterfaceHasChanged),
		string(InstallationReasonUserPlaneAccessVirtualIPvFourAddressesHasChanged),
		string(InstallationReasonUserPlaneDataInterfaceHasChanged),
