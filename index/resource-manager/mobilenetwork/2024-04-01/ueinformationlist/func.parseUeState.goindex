package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2024-04-01/ueinformationlist
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseUeState(input string) (*UeState, error) {
	vals := map[string]UeState{
		"connected":    UeStateConnected,
		"deregistered": UeStateDeregistered,
		"detached":     UeStateDetached,
		"idle":         UeStateIdle,
		"unknown":      UeStateUnknown,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := UeState(input)
	return &out, nil
}
