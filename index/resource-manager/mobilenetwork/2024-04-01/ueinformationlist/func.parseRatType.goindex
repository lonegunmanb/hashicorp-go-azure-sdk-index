package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2024-04-01/ueinformationlist
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRatType(input string) (*RatType, error) {
	vals := map[string]RatType{
		"5g": RatTypeFiveG,
		"4g": RatTypeFourG,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RatType(input)
	return &out, nil
}
