package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2024-04-01/ueinformationlist
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *UeInfoPropertiesFormat) GetLastReadAtAsTime() (*time.Time, error) {
	if o.LastReadAt == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.LastReadAt, "2006-01-02T15:04:05Z07:00")
}
