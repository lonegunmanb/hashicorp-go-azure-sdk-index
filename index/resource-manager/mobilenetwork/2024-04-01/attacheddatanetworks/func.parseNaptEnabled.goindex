package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2024-04-01/attacheddatanetworks
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseNaptEnabled(input string) (*NaptEnabled, error) {
	vals := map[string]NaptEnabled{
		"disabled": NaptEnabledDisabled,
		"enabled":  NaptEnabledEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := NaptEnabled(input)
	return &out, nil
}
