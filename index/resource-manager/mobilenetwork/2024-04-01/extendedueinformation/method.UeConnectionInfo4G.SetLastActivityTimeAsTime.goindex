package github.com/hashicorp/go-azure-sdk/resource-manager/mobilenetwork/2024-04-01/extendedueinformation
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *UeConnectionInfo4G) SetLastActivityTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.LastActivityTime = &formatted
}
