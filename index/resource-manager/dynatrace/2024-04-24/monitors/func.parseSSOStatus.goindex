package github.com/hashicorp/go-azure-sdk/resource-manager/dynatrace/2024-04-24/monitors
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSSOStatus(input string) (*SSOStatus, error) {
	vals := map[string]SSOStatus{
		"disabled": SSOStatusDisabled,
		"enabled":  SSOStatusEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SSOStatus(input)
	return &out, nil
}
