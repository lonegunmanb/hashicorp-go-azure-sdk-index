package github.com/hashicorp/go-azure-sdk/resource-manager/dynatrace/2024-04-24/monitors
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMarketplaceSaasAutoRenew(input string) (*MarketplaceSaasAutoRenew, error) {
	vals := map[string]MarketplaceSaasAutoRenew{
		"off": MarketplaceSaasAutoRenewOff,
		"on":  MarketplaceSaasAutoRenewOn,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := MarketplaceSaasAutoRenew(input)
	return &out, nil
}
