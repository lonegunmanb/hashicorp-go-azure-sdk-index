package github.com/hashicorp/go-azure-sdk/resource-manager/dynatrace/2024-04-24/monitors
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c MonitorsClient) ListHostsCompleteMatchingPredicate(ctx context.Context, id MonitorId, predicate VMInfoOperationPredicate) (result ListHostsCompleteResult, err error) {
	items := make([]VMInfo, 0)

	resp, err := c.ListHosts(ctx, id)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = ListHostsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
