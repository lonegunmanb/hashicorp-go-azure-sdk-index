package github.com/hashicorp/go-azure-sdk/resource-manager/dataprotection/2024-04-01/backuppolicies
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseMonth(input string) (*Month, error) {
	vals := map[string]Month{
		"april":     MonthApril,
		"august":    MonthAugust,
		"december":  MonthDecember,
		"february":  MonthFebruary,
		"january":   MonthJanuary,
		"july":      MonthJuly,
		"june":      MonthJune,
		"march":     MonthMarch,
		"may":       MonthMay,
		"november":  MonthNovember,
		"october":   MonthOctober,
		"september": MonthSeptember,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Month(input)
	return &out, nil
}
