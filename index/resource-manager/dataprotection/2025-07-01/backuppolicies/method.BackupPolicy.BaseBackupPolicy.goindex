func (s BackupPolicy) BaseBackupPolicy() BaseBaseBackupPolicyImpl {
	return BaseBaseBackupPolicyImpl{
		DatasourceTypes: s.DatasourceTypes,
		ObjectType:      s.ObjectType,
	}
}
