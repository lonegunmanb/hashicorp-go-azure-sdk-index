package github.com/hashicorp/go-azure-sdk/resource-manager/dataprotection/2025-07-01/backupinstances
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRecoveryOption(input string) (*RecoveryOption, error) {
	vals := map[string]RecoveryOption{
		"failifexists": RecoveryOptionFailIfExists,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RecoveryOption(input)
	return &out, nil
}
