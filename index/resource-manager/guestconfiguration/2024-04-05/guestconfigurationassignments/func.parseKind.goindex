package github.com/hashicorp/go-azure-sdk/resource-manager/guestconfiguration/2024-04-05/guestconfigurationassignments
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseKind(input string) (*Kind, error) {
	vals := map[string]Kind{
		"dsc": KindDSC,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Kind(input)
	return &out, nil
}
