package github.com/hashicorp/go-azure-sdk/resource-manager/guestconfiguration/2024-04-05/guestconfigurationassignments
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *GuestConfigurationAssignmentReportProperties) SetStartTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.StartTime = &formatted
}
