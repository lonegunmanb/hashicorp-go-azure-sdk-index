package github.com/hashicorp/go-azure-sdk/resource-manager/guestconfiguration/2020-06-25/guestconfigurationassignmenthcrpreports
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseType(input string) (*Type, error) {
	vals := map[string]Type{
		"consistency": TypeConsistency,
		"initial":     TypeInitial,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Type(input)
	return &out, nil
}
