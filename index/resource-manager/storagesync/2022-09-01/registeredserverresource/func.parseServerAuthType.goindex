package github.com/hashicorp/go-azure-sdk/resource-manager/storagesync/2022-09-01/registeredserverresource
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseServerAuthType(input string) (*ServerAuthType, error) {
	vals := map[string]ServerAuthType{
		"certificate":     ServerAuthTypeCertificate,
		"managedidentity": ServerAuthTypeManagedIdentity,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := ServerAuthType(input)
	return &out, nil
}
