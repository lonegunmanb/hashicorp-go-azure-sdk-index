type CloudEndpointChangeEnumerationActivity struct {
	DeletesProgressPercent    *int64                                          `json:"deletesProgressPercent,omitempty"`
	LastUpdatedTimestamp      *string                                         `json:"lastUpdatedTimestamp,omitempty"`
