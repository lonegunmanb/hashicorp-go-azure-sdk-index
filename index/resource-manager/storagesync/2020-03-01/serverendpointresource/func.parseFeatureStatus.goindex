package github.com/hashicorp/go-azure-sdk/resource-manager/storagesync/2020-03-01/serverendpointresource
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseFeatureStatus(input string) (*FeatureStatus, error) {
	vals := map[string]FeatureStatus{
		"off": FeatureStatusOff,
		"on":  FeatureStatusOn,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := FeatureStatus(input)
	return &out, nil
}
