package github.com/hashicorp/go-azure-sdk/resource-manager/servicenetworking/2025-01-01/securitypoliciesinterface
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parsePolicyType(input string) (*PolicyType, error) {
	vals := map[string]PolicyType{
		"waf": PolicyTypeWaf,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := PolicyType(input)
	return &out, nil
}
