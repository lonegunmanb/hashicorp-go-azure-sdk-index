package github.com/hashicorp/go-azure-sdk/resource-manager/labservices/2023-06-07/schedule
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewScheduleID(subscriptionId string, resourceGroupName string, labName string, scheduleName string) ScheduleId {
	return ScheduleId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		LabName:           labName,
		ScheduleName:      scheduleName,
	}
}
