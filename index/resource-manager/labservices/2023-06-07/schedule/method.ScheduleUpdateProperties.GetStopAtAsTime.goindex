package github.com/hashicorp/go-azure-sdk/resource-manager/labservices/2023-06-07/schedule
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ScheduleUpdateProperties) GetStopAtAsTime() (*time.Time, error) {
	if o.StopAt == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StopAt, "2006-01-02T15:04:05Z07:00")
}
