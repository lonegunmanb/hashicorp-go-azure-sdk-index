package github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2024-08-01/serverstart
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c ServerStartClient) ServersStartThenPoll(ctx context.Context, id FlexibleServerId) error {
	result, err := c.ServersStart(ctx, id)
	if err != nil {
		return fmt.Errorf("performing ServersStart: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after ServersStart: %+v", err)
	}

	return nil
}
