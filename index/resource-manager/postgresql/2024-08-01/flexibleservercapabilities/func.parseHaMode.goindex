package github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2024-08-01/flexibleservercapabilities
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseHaMode(input string) (*HaMode, error) {
	vals := map[string]HaMode{
		"samezone":      HaModeSameZone,
		"zoneredundant": HaModeZoneRedundant,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := HaMode(input)
	return &out, nil
}
