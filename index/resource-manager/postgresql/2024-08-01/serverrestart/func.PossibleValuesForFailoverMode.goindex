func PossibleValuesForFailoverMode() []string {
	return []string{
		string(FailoverModeForcedFailover),
		string(FailoverModeForcedSwitchover),
		string(FailoverModePlannedFailover),
		string(FailoverModePlannedSwitchover),
	}
}
