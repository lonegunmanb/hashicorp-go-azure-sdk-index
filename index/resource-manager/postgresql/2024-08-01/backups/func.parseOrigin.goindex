package github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2024-08-01/backups
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseOrigin(input string) (*Origin, error) {
	vals := map[string]Origin{
		"customer on-demand": OriginCustomerOnNegativeDemand,
		"full":               OriginFull,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := Origin(input)
	return &out, nil
}
