package github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2024-08-01/replicas
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStorageType(input string) (*StorageType, error) {
	vals := map[string]StorageType{
		"premium_lrs":   StorageTypePremiumLRS,
		"premiumv2_lrs": StorageTypePremiumVTwoLRS,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := StorageType(input)
	return &out, nil
}
