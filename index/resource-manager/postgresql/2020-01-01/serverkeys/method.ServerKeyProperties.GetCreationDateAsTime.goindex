package github.com/hashicorp/go-azure-sdk/resource-manager/postgresql/2020-01-01/serverkeys
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ServerKeyProperties) GetCreationDateAsTime() (*time.Time, error) {
	if o.CreationDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.CreationDate, "2006-01-02T15:04:05Z07:00")
}
