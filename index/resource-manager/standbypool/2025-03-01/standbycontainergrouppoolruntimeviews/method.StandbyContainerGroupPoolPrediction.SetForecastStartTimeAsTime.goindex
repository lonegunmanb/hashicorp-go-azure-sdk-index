package github.com/hashicorp/go-azure-sdk/resource-manager/standbypool/2025-03-01/standbycontainergrouppoolruntimeviews
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *StandbyContainerGroupPoolPrediction) SetForecastStartTimeAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.ForecastStartTime = formatted
}
