package github.com/hashicorp/go-azure-sdk/resource-manager/standbypool/2025-03-01/standbycontainergrouppools
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRefillPolicy(input string) (*RefillPolicy, error) {
	vals := map[string]RefillPolicy{
		"always": RefillPolicyAlways,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RefillPolicy(input)
	return &out, nil
}
