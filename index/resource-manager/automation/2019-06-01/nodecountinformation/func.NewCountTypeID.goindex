package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2019-06-01/nodecountinformation
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewCountTypeID(subscriptionId string, resourceGroupName string, automationAccountName string, countType CountType) CountTypeId {
	return CountTypeId{
		SubscriptionId:        subscriptionId,
		ResourceGroupName:     resourceGroupName,
		AutomationAccountName: automationAccountName,
		CountType:             countType,
	}
}
