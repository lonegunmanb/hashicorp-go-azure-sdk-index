package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2019-06-01/softwareupdateconfiguration
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseTagOperators(input string) (*TagOperators, error) {
	vals := map[string]TagOperators{
		"all": TagOperatorsAll,
		"any": TagOperatorsAny,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := TagOperators(input)
	return &out, nil
}
