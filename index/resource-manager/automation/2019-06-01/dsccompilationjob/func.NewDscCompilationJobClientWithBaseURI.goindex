func NewDscCompilationJobClientWithBaseURI(sdkApi sdkEnv.Api) (*DscCompilationJobClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "dsccompilationjob", defaultApiVersion)
	if err != nil {
