package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2019-06-01/job

func (p JobCollectionItemOperationPredicate) Matches(input JobCollectionItem) bool {

	if p.Id != nil && (input.Id == nil || *p.Id != *input.Id) {
		return false
	}

	if p.Name != nil && (input.Name == nil || *p.Name != *input.Name) {
		return false
	}

	if p.Type != nil && (input.Type == nil || *p.Type != *input.Type) {
		return false
	}

	return true
}
