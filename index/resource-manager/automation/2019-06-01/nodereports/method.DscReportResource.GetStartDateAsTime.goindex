package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2019-06-01/nodereports
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *DscReportResource) GetStartDateAsTime() (*time.Time, error) {
	if o.StartDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.StartDate, "2006-01-02T15:04:05Z07:00")
}
