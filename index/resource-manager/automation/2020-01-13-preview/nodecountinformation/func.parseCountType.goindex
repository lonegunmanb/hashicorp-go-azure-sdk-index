package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/nodecountinformation
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseCountType(input string) (*CountType, error) {
	vals := map[string]CountType{
		"nodeconfiguration": CountTypeNodeconfiguration,
		"status":            CountTypeStatus,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := CountType(input)
	return &out, nil
}
