package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/sourcecontrol
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseTokenType(input string) (*TokenType, error) {
	vals := map[string]TokenType{
		"oauth":               TokenTypeOauth,
		"personalaccesstoken": TokenTypePersonalAccessToken,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := TokenType(input)
	return &out, nil
}
