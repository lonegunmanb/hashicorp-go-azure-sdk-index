package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/schedule
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ScheduleProperties) GetNextRunAsTime() (*time.Time, error) {
	if o.NextRun == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.NextRun, "2006-01-02T15:04:05Z07:00")
}
