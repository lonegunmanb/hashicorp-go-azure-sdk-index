package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/sourcecontrolsyncjobstreams
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseStreamType(input string) (*StreamType, error) {
	vals := map[string]StreamType{
		"error":  StreamTypeError,
		"output": StreamTypeOutput,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := StreamType(input)
	return &out, nil
}
