package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/dscnode
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *DscNodeProperties) GetLastSeenAsTime() (*time.Time, error) {
	if o.LastSeen == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.LastSeen, "2006-01-02T15:04:05Z07:00")
}
