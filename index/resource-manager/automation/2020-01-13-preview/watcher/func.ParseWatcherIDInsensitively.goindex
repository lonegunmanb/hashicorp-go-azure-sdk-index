package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2020-01-13-preview/watcher
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseWatcherIDInsensitively(input string) (*WatcherId, error) {
	parser := resourceids.NewParserFromResourceIdType(&WatcherId{})
	parsed, err := parser.Parse(input, true)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := WatcherId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
