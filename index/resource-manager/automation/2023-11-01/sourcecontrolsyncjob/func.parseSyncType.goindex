package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2023-11-01/sourcecontrolsyncjob
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSyncType(input string) (*SyncType, error) {
	vals := map[string]SyncType{
		"fullsync":    SyncTypeFullSync,
		"partialsync": SyncTypePartialSync,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SyncType(input)
	return &out, nil
}
