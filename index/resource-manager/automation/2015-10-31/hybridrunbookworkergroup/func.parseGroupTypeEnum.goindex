package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2015-10-31/hybridrunbookworkergroup
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseGroupTypeEnum(input string) (*GroupTypeEnum, error) {
	vals := map[string]GroupTypeEnum{
		"system": GroupTypeEnumSystem,
		"user":   GroupTypeEnumUser,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := GroupTypeEnum(input)
	return &out, nil
}
