package github.com/hashicorp/go-azure-sdk/resource-manager/automation/2015-10-31/automationaccount
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuNameEnum(input string) (*SkuNameEnum, error) {
	vals := map[string]SkuNameEnum{
		"basic": SkuNameEnumBasic,
		"free":  SkuNameEnumFree,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuNameEnum(input)
	return &out, nil
}
