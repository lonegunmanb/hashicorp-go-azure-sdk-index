func PossibleValuesForJobProvisioningState() []string {
	return []string{
		string(JobProvisioningStateFailed),
		string(JobProvisioningStateProcessing),
		string(JobProvisioningStateSucceeded),
		string(JobProvisioningStateSuspended),
	}
}
