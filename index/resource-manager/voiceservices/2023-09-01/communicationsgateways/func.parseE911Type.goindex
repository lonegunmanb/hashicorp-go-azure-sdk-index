package github.com/hashicorp/go-azure-sdk/resource-manager/voiceservices/2023-09-01/communicationsgateways
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseE911Type(input string) (*E911Type, error) {
	vals := map[string]E911Type{
		"directtoesrp": E911TypeDirectToEsrp,
		"standard":     E911TypeStandard,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := E911Type(input)
	return &out, nil
}
