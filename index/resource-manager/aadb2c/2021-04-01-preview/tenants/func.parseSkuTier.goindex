package github.com/hashicorp/go-azure-sdk/resource-manager/aadb2c/2021-04-01-preview/tenants
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSkuTier(input string) (*SkuTier, error) {
	vals := map[string]SkuTier{
		"a0": SkuTierA0,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SkuTier(input)
	return &out, nil
}
