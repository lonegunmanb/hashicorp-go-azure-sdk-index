func NewNodeTypeClientWithBaseURI(sdkApi sdkEnv.Api) (*NodeTypeClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "nodetype", defaultApiVersion)
	if err != nil {
		return nil, fmt.Errorf("instantiating NodeTypeClient: %+v", err)
