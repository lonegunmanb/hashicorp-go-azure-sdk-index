package github.com/hashicorp/go-azure-sdk/resource-manager/servicefabricmanagedcluster/2024-04-01/applicationtypeversion
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewVersionID(subscriptionId string, resourceGroupName string, managedClusterName string, applicationTypeName string, versionName string) VersionId {
	return VersionId{
		SubscriptionId:      subscriptionId,
		ResourceGroupName:   resourceGroupName,
		ManagedClusterName:  managedClusterName,
		ApplicationTypeName: applicationTypeName,
		VersionName:         versionName,
	}
}
