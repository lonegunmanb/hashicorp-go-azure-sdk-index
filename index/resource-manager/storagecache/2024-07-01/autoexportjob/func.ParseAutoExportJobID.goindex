package github.com/hashicorp/go-azure-sdk/resource-manager/storagecache/2024-07-01/autoexportjob
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func ParseAutoExportJobID(input string) (*AutoExportJobId, error) {
	parser := resourceids.NewParserFromResourceIdType(&AutoExportJobId{})
	parsed, err := parser.Parse(input, false)
	if err != nil {
		return nil, fmt.Errorf("parsing %q: %+v", input, err)
	}

	id := AutoExportJobId{}
	if err = id.FromParseResult(*parsed); err != nil {
		return nil, err
	}

	return &id, nil
}
