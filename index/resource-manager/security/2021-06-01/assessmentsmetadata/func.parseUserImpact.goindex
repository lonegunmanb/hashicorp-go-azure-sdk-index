package github.com/hashicorp/go-azure-sdk/resource-manager/security/2021-06-01/assessmentsmetadata
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseUserImpact(input string) (*UserImpact, error) {
	vals := map[string]UserImpact{
		"high":     UserImpactHigh,
		"low":      UserImpactLow,
		"moderate": UserImpactModerate,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := UserImpact(input)
	return &out, nil
}
