func PossibleValuesForOnboardingState() []string {
	return []string{
		string(OnboardingStateNotApplicable),
		string(OnboardingStateNotOnboarded),
		string(OnboardingStateOnboarded),
		string(OnboardingStateOnboardedByOtherConnector),
	}
}
