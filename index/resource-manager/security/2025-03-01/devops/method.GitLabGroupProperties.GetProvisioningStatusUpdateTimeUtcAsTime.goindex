package github.com/hashicorp/go-azure-sdk/resource-manager/security/2025-03-01/devops
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *GitLabGroupProperties) GetProvisioningStatusUpdateTimeUtcAsTime() (*time.Time, error) {
	if o.ProvisioningStatusUpdateTimeUtc == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ProvisioningStatusUpdateTimeUtc, "2006-01-02T15:04:05Z07:00")
}
