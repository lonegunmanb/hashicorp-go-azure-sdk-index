package github.com/hashicorp/go-azure-sdk/resource-manager/security/2019-01-01-preview/alertssuppressionrules
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseRuleState(input string) (*RuleState, error) {
	vals := map[string]RuleState{
		"disabled": RuleStateDisabled,
		"enabled":  RuleStateEnabled,
		"expired":  RuleStateExpired,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := RuleState(input)
	return &out, nil
}
