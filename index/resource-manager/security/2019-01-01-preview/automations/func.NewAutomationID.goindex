package github.com/hashicorp/go-azure-sdk/resource-manager/security/2019-01-01-preview/automations
import (
	"fmt"
	"strings"

	"github.com/hashicorp/go-azure-helpers/resourcemanager/recaser"
	"github.com/hashicorp/go-azure-helpers/resourcemanager/resourceids"
)
func NewAutomationID(subscriptionId string, resourceGroupName string, automationName string) AutomationId {
	return AutomationId{
		SubscriptionId:    subscriptionId,
		ResourceGroupName: resourceGroupName,
		AutomationName:    automationName,
	}
}
