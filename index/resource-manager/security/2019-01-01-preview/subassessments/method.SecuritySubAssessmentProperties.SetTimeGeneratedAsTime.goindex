package github.com/hashicorp/go-azure-sdk/resource-manager/security/2019-01-01-preview/subassessments
import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *SecuritySubAssessmentProperties) SetTimeGeneratedAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.TimeGenerated = &formatted
}
