package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicessiterecovery/2025-02-01/replicationprotecteditems
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseSecurityConfiguration(input string) (*SecurityConfiguration, error) {
	vals := map[string]SecurityConfiguration{
		"disabled": SecurityConfigurationDisabled,
		"enabled":  SecurityConfigurationEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := SecurityConfiguration(input)
	return &out, nil
}
