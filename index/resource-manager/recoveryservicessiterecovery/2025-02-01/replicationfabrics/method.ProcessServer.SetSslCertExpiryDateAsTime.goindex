package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicessiterecovery/2025-02-01/replicationfabrics
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ProcessServer) SetSslCertExpiryDateAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.SslCertExpiryDate = &formatted
}
