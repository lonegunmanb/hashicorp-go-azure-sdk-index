func (o ListOperationOptions) ToQuery() *client.QueryParams {
	out := client.QueryParams{}
	if o.SkipToken != nil {
		out.Append("skipToken", fmt.Sprintf("%v", *o.SkipToken))
	}
	if o.TakeToken != nil {
		out.Append("takeToken", fmt.Sprintf("%v", *o.TakeToken))
	}
	return &out
}
