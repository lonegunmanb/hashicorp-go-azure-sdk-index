		return nil, fmt.Errorf("unmarshaling into BaseTestMigrateProviderSpecificInputImpl: %+v", err)
	}

	return RawTestMigrateProviderSpecificInputImpl{
		testMigrateProviderSpecificInput: parent,
		Type:                             value,
		Values:                           temp,
	}, nil

}
