package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicessiterecovery/2025-02-01/replicationrecoveryservicesproviders
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *VersionDetails) GetExpiryDateAsTime() (*time.Time, error) {
	if o.ExpiryDate == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ExpiryDate, "2006-01-02T15:04:05Z07:00")
}
