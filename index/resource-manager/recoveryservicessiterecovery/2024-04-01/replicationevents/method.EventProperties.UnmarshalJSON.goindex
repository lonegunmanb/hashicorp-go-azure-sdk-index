	if v, ok := temp["providerSpecificDetails"]; ok {
		impl, err := UnmarshalEventProviderSpecificDetailsImplementation(v)
		if err != nil {
			return fmt.Errorf("unmarshaling field 'ProviderSpecificDetails' for 'EventProperties': %+v", err)
		}
