		return nil, fmt.Errorf("unmarshaling into BaseRecoveryAvailabilitySetCustomDetailsImpl: %+v", err)
	}

	return RawRecoveryAvailabilitySetCustomDetailsImpl{
		recoveryAvailabilitySetCustomDetails: parent,
		Type:                                 value,
		Values:                               temp,
	}, nil

}
