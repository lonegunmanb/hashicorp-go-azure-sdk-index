package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicessiterecovery/2024-04-01/replicationrecoveryservicesproviders
import (
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *HealthError) SetCreationTimeUtcAsTime(input time.Time) {
	formatted := input.Format("2006-01-02T15:04:05Z07:00")
	o.CreationTimeUtc = &formatted
}
