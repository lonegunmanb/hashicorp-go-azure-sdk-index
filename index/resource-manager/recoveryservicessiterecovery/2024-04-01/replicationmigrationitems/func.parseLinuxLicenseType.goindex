package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservicessiterecovery/2024-04-01/replicationmigrationitems
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseLinuxLicenseType(input string) (*LinuxLicenseType, error) {
	vals := map[string]LinuxLicenseType{
		"linuxserver":   LinuxLicenseTypeLinuxServer,
		"nolicensetype": LinuxLicenseTypeNoLicenseType,
		"notspecified":  LinuxLicenseTypeNotSpecified,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := LinuxLicenseType(input)
	return &out, nil
}
