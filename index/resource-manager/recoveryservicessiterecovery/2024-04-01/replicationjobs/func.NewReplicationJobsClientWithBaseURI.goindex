func NewReplicationJobsClientWithBaseURI(sdkApi sdkEnv.Api) (*ReplicationJobsClient, error) {
	client, err := resourcemanager.NewClient(sdkApi, "replicationjobs", defaultApiVersion)
	if err != nil {
