package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2025-02-01/openapis
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OpenapisClient) UsagesListByVaultsCompleteMatchingPredicate(ctx context.Context, id VaultId, predicate VaultUsageOperationPredicate) (result UsagesListByVaultsCompleteResult, err error) {
	items := make([]VaultUsage, 0)

	resp, err := c.UsagesListByVaults(ctx, id)
	if err != nil {
		result.LatestHttpResponse = resp.HttpResponse
		err = fmt.Errorf("loading results: %+v", err)
		return
	}
	if resp.Model != nil {
		for _, v := range *resp.Model {
			if predicate.Matches(v) {
				items = append(items, v)
			}
		}
	}

	result = UsagesListByVaultsCompleteResult{
		LatestHttpResponse: resp.HttpResponse,
		Items:              items,
	}
	return
}
