package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2025-02-01/openapis
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAuthType(input string) (*AuthType, error) {
	vals := map[string]AuthType{
		"aad":                  AuthTypeAAD,
		"acs":                  AuthTypeACS,
		"accesscontrolservice": AuthTypeAccessControlService,
		"azureactivedirectory": AuthTypeAzureActiveDirectory,
		"invalid":              AuthTypeInvalid,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AuthType(input)
	return &out, nil
}
