package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2025-02-01/openapis
import (
	"context"
	"fmt"
	"net/http"

	"github.com/hashicorp/go-azure-sdk/sdk/client"
	"github.com/hashicorp/go-azure-sdk/sdk/client/pollers"
	"github.com/hashicorp/go-azure-sdk/sdk/client/resourcemanager"
	"github.com/hashicorp/go-azure-sdk/sdk/odata"
)
func (c OpenapisClient) VaultsDeleteThenPoll(ctx context.Context, id VaultId) error {
	result, err := c.VaultsDelete(ctx, id)
	if err != nil {
		return fmt.Errorf("performing VaultsDelete: %+v", err)
	}

	if err := result.Poller.PollUntilDone(ctx); err != nil {
		return fmt.Errorf("polling after VaultsDelete: %+v", err)
	}

	return nil
}
