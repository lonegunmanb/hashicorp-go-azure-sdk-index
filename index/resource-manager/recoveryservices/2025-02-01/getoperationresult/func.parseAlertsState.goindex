package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2025-02-01/getoperationresult
import (
	"encoding/json"
	"fmt"
	"strings"
)
func parseAlertsState(input string) (*AlertsState, error) {
	vals := map[string]AlertsState{
		"disabled": AlertsStateDisabled,
		"enabled":  AlertsStateEnabled,
	}
	if v, ok := vals[strings.ToLower(input)]; ok {
		return &v, nil
	}

	// otherwise presume it's an undefined value and best-effort it
	out := AlertsState(input)
	return &out, nil
}
