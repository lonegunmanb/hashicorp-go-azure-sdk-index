package github.com/hashicorp/go-azure-sdk/resource-manager/recoveryservices/2024-01-01/vaultcertificates
import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/hashicorp/go-azure-helpers/lang/dates"
)
func (o *ResourceCertificateAndAcsDetails) GetValidFromAsTime() (*time.Time, error) {
	if o.ValidFrom == nil {
		return nil, nil
	}
	return dates.ParseAsFormat(o.ValidFrom, "2006-01-02T15:04:05Z07:00")
}
